_meta = {
  name = "wiggly";
  summary = "GNOME Shell wiggly extension";
  description = ''Package the existing wiggly GNOME Shell extension. Installing it does not enable the extension.'';
  zenosVersion = "1.0.0"; packageVersion = "8";
  tags = [ "gnome" "extensions" ]; maintainers = [ $m.doromiert ]; license = $l.gpl2Only;
};
build = $pkgs.legacy.stdenvNoCC.mkDerivation {
  pname = "gnome-shell-extension-wiggly"; version = "8";
  src = $pkgs.legacy.fetchzip {
    url = "https://extensions.gnome.org/extension-data/wigglymojarch.v8.shell-extension.zip";
    stripRoot = false;
    hash = "sha256-suoKoWnRUsQ9v4NXU9D/H/NH9D4JV/7MOB61yVNO/o8=";
  };
  nativeBuildInputs = [ $pkgs.legacy.glib ];
  dontBuild = true;
  installPhase = ''
    runHook preInstall
    destination="$out/share/gnome-shell/extensions/wiggly@mojarch"
    mkdir -p "$destination"
    cp -r . "$destination/"
    rm -rf "$destination/.git" "$destination/flake.nix" "$destination/flake.lock" "$destination/tests"
    if test -d "$destination/schemas"; then
      glib-compile-schemas --strict "$destination/schemas"
    fi
    runHook postInstall
  '';
  passthru.extensionUuid = "wiggly@mojarch";
  meta = { description = "GNOME Shell wiggly extension"; platforms = $lib.platforms.linux; license = $lib.licenses.gpl2Only; };
};
