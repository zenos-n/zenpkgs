_meta = {
  id = "io.github.ztrahmet.rounded-window-corners-native";
  name = "Rounded Window Corners Native";
  summary = "Sharp fractional-scale rounded corners for GNOME50";
  description = ''Alternate to Rounded Window Corners Reborn. GNOME50 port of Ahmet Öztürk's extension, with sharp rendering enabled by default. Disable other corner extensions before enabling this one.'';
  zenosVersion = "1.0.0";
  packageVersion = "51.1-gnome50.3";
  tags = [ "gnome" "extensions" "theming" "hidpi" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

build = let
  source = $pkgs.legacy.fetchFromGitHub {
    owner = "doromiert";
    repo = "rounded-window-corners-native";
    rev = "b7bc9dcc2cdbd486823da87609f729e48b3c0d08";
    hash = "sha256-1tbKeD+3eTyoM8MnMkMFz04UxESNluEr9KfMYYfPlVE=";
  };
in $pkgs.legacy.callPackage (source + "/package.nix") { };
