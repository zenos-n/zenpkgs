_meta = {
  id = "com.neg-zero.zenlink-indicator";
  name = "ZenLink GNOME extension";
  summary = "Compatibility alias for the complete ZenLink desktop package";
  description = ''
    The ZenLink desktop package includes both its GNOME Shell extension and
    device service. This existing package selector resolves to that same build.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.1.0";
  tags = [ "desktops" "gnome" "extensions" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

build = $pkgs.byCategories.system.zenlink;
