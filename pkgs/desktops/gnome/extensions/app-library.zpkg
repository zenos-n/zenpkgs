_meta = {
  id = "com.neg-zero.app-library";
  name = "App Library";
  summary = "A paginated GNOME application library";
  description = ''XDG categories, persistent icon animations, custom ordering and per-user recents. Supports GNOME Shell 50 and optional Blur My Shell integration.'';
  zenosVersion = "1.0.0";
  packageVersion = "0.1.6";
  tags = [ "desktops" "gnome" "extensions" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

build = $pkgs.legacy.callPackage (($pkgs.legacy.fetchFromGitHub {
  owner = "doromiert";
  repo = "app-library";
  rev = "1a2838679c3107ba11307c95c21fe6679b08ede9";
  hash = "sha256-gKnNN5qKmDcqzmLlIfR6nsnK/+4DnivEB8LwtMfIM0c=";
}) + "/package.nix") { };
