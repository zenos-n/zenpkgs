_meta = {
  name = "codex-usage";
  summary = "GNOME Shell codex-usage extension";
  description = ''Package the existing codex-usage GNOME Shell extension. Installing it does not enable the extension.'';
  zenosVersion = "1.0.0"; packageVersion = "unstable-2026-10-02";
  tags = [ "gnome" "extensions" ]; maintainers = [ $m.doromiert ]; license = $l.mit;
};
build = $pkgs.legacy.stdenvNoCC.mkDerivation {
  pname = "gnome-shell-extension-codex-usage"; version = "unstable-2026-10-02";
  src = $pkgs.legacy.fetchFromGitHub { owner = "kevinpita"; repo = "codex-usage-extension"; rev = "7db16662f37f20c2215ff6526d2e3487c51e2824"; hash = "sha256-GQcfn5+7fA9ASeDP50vVsiQFUw2GfcvhrkPrpliEztg="; };
  nativeBuildInputs = [ $pkgs.legacy.glib ];
  dontBuild = true;
  installPhase = ''
    runHook preInstall
    destination="$out/share/gnome-shell/extensions/codex-usage@kevinpita.dev"
    mkdir -p "$destination"
    cp -r . "$destination/"
    rm -rf "$destination/.git" "$destination/flake.nix" "$destination/flake.lock" "$destination/tests"
    if test -d "$destination/schemas"; then
      glib-compile-schemas --strict "$destination/schemas"
    fi
    runHook postInstall
  '';
  passthru.extensionUuid = "codex-usage@kevinpita.dev";
  meta = { description = "GNOME Shell codex-usage extension"; platforms = $lib.platforms.linux; license = $lib.licenses.mit; };
};
