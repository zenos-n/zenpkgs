_meta = {
  id = "com.neg-zero.dash-stacks";
  name = "dash-stacks";
  summary = "macOS-style folder stacks for the GNOME dash";
  description = ''
    macOS-style folder stacks for the GNOME dash
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0-unstable-2026-11-24.1";
  tags = [ "desktops" "gnome" "extensions" ];
  license = $l.napalm;
};

build = let
  source = $pkgs.legacy.fetchFromGitHub {
    owner = "doromiert";
    repo = "dash-stacks";
    rev = "50514a082c09985536fc20e326b25baf878da488";
    hash = "sha256-oSem1ZJdsjyi+aAKsIgMAaBGvoUmJHVl86ejIAhLb4Y=";
  };
in $pkgs.legacy.callPackage (source + "/package.nix") { };
