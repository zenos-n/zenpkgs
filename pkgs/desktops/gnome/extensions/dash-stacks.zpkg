_meta = {
  id = "com.neg-zero.dash-stacks";
  name = "dash-stacks";
  summary = "macOS-style folder stacks for the GNOME dash";
  description = ''
    macOS-style folder stacks for the GNOME dash
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0-unstable-2026-11-24";
  tags = [ "desktops" "gnome" "extensions" ];
  license = $l.napalm;
};

build = let
  source = $pkgs.legacy.fetchFromGitHub {
    owner = "doromiert";
    repo = "dash-stacks";
    rev = "16f44ea40c643d8943a392cd46eb513f600fbfa7";
    hash = "sha256-zqLZI3Qo/5Jbh3AG3MoLZQF8JVyQNnW1jDA1AFGHTvg=";
  };
in $pkgs.legacy.callPackage (source + "/package.nix") { };
