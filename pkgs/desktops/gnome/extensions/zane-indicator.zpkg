_meta = {
  name = "zane-indicator";
  summary = "GNOME Shell zane-indicator extension";
  description = ''Package the existing zane-indicator GNOME Shell extension. Installing it does not enable the extension.'';
  zenosVersion = "1.0.0"; packageVersion = "unstable-2026-10-02";
  tags = [ "gnome" "extensions" ]; maintainers = [ $m.doromiert ]; license = $l.unfree;
};
build = $pkgs.legacy.stdenvNoCC.mkDerivation {
  pname = "gnome-shell-extension-zane-indicator"; version = "unstable-2026-10-02";
  src = $lib.zenPackageSources.zaneIndicator + "/extension";
  nativeBuildInputs = [ $pkgs.legacy.glib ];
  dontBuild = true;
  installPhase = ''
    runHook preInstall
    destination="$out/share/gnome-shell/extensions/zane@neg-zero.com"
    mkdir -p "$destination"
    cp -r . "$destination/"
    rm -rf "$destination/.git" "$destination/flake.nix" "$destination/flake.lock" "$destination/tests"
    if test -d "$destination/schemas"; then
      glib-compile-schemas --strict "$destination/schemas"
    fi
    runHook postInstall
  '';
  passthru.extensionUuid = "zane@neg-zero.com";
  meta = { description = "GNOME Shell zane-indicator extension"; platforms = $lib.platforms.linux; license = $lib.licenses.unfree; };
};
