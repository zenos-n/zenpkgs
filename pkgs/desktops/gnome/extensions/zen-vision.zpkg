_meta = {
  name = "zen-vision";
  summary = "GNOME Shell zen-vision extension";
  description = ''Package the existing zen-vision GNOME Shell extension. Installing it does not enable the extension.'';
  zenosVersion = "1.0.0"; packageVersion = "unstable-2026-10-02";
  tags = [ "gnome" "extensions" ]; maintainers = [ $m.doromiert ]; license = $l.unfree;
};
build = $pkgs.legacy.stdenvNoCC.mkDerivation {
  pname = "gnome-shell-extension-zen-vision"; version = "unstable-2026-10-02";
  src = $lib.zenPackageSources.visionIndicator + "/extension";
  nativeBuildInputs = [ $pkgs.legacy.glib ];
  dontBuild = true;
  installPhase = ''
    runHook preInstall
    destination="$out/share/gnome-shell/extensions/zen-vision@neg-zero"
    mkdir -p "$destination"
    cp -r . "$destination/"
    rm -rf "$destination/.git" "$destination/flake.nix" "$destination/flake.lock" "$destination/tests"
    if test -d "$destination/schemas"; then
      glib-compile-schemas --strict "$destination/schemas"
    fi
    runHook postInstall
  '';
  passthru.extensionUuid = "zen-vision@neg-zero";
  meta = { description = "GNOME Shell zen-vision extension"; platforms = $lib.platforms.linux; license = $lib.licenses.unfree; };
};
