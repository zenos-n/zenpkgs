_meta = {
  id = "unknown.rounded-window-corners-reborn";
  name = "rounded-window-corners-reborn";
  summary = "Curated rounded-window-corners-reborn package for ZenOS";
  description = ''
    Curated rounded-window-corners-reborn package for ZenOS
  '';
  zenosVersion = "1.0.0";
  packageVersion = "";
  tags = [ "system" "desktop" "gnome" "extensions" ];
  maintainers = [ $m.doromiert ];
};

# GNOME 50 makes logical framebuffer scaling unconditional on Wayland.
build = $pkgs.legacy.gnomeExtensions.rounded-window-corners-reborn.overrideAttrs (old: {
  postPatch = (old.postPatch or "") + ''
    substituteInPlace manager/utils.js \
      --replace-fail "features.includes('scale-monitor-framebuffer')" \
        "(!Meta.is_wayland_compositor || features.includes('scale-monitor-framebuffer'))"
  '';
});
