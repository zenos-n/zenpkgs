_meta = {
  id = "org.codeberg.wvhulle.bootvine";
  name = "Bootvine";
  summary = "Live systemd boot tree behind the Plymouth splash";
  description = ''Shows boot dependencies, unit states and passphrase prompts. The ZenOS integration switches between Plymouth and the live tree with Escape and keeps initrd history across switch-root. Based on wvhulle/bootvine under GPL-3.0-or-later.'';
  zenosVersion = 1.0.0Nb;
  packageVersion = "0.1.3-zenos1";
  tags = [ "boot" "systemd" "plymouth" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

build = $pkgs.legacy.callPackage (($pkgs.legacy.fetchFromGitHub {
  owner = "zenos-n";
  repo = "bootvine";
  rev = "a74dd29649fd15d079361a969e452d3a8cf4af5e";
  hash = "sha256-cDbtk3LaTD4rpb8RzTmvTFKJEFTwyY685FFV7V+RMY0=";
}) + "/package.nix") { };
