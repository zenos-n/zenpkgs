_meta = {
  name = "ZenOS Setup";
  summary = "ZenOS installer and first-boot setup";
  description = ''Installs ZenOS and finishes user setup after the first boot.'';
  zenosVersion = 1.0.0Nb;
  packageVersion = "0.1.0";
  tags = [ "installer" "oobe" ];
  maintainers = [ $m.doromiert ];
};

build = $pkgs.legacy.callPackage (($pkgs.legacy.fetchFromGitHub {
  owner = "zenos-n";
  repo = "zenos-setup";
  rev = "2c6fde244bb09610acd302b0f83abeeef84f769e";
  hash = "sha256-xqyLglWUnguXaFzGigyu7e3gqyTo/kVTVc2Vtm66FwE=";
}) + "/package.nix") { };
