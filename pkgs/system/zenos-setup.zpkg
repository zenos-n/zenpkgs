_meta = {
  name = "ZenOS Setup";
  summary = "ZenOS installer and first-boot setup";
  description = ''Installs ZenOS and finishes user setup after the first boot.'';
  zenosVersion = 1.0.0Nb;
  packageVersion = "0.1.0";
  tags = [ "installer" "oobe" ];
  maintainers = [ $m.doromiert ];
};

