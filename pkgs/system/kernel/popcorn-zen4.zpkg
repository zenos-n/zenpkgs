_meta = {
  name = "popcorn-zen4 kernel"; summary = "Optional Popcorn 7.0.2 kernel";
  description = ''Pinned Popcorn doromitul kernel for migration. Select explicitly through system.kernel.package; this package never changes the default kernel.'';
  zenosVersion = "1.0.0"; packageVersion = "7.0.2";
  tags = [ "kernel" "migration" ]; maintainers = [ $m.doromiert ]; license = $l.gpl2Only;
};
build = let
  recipeSource = $pkgs.legacy.fetchFromGitHub {
    owner = "doromiert"; repo = "popcorn-m";
    rev = "5a05a4520d19d1b2cf616f2516b889df1d50d0dd";
    hash = "sha256-4ZUPUKzqCl1uQntQjhesI1Lh+ox+3EeYrOIyhNB9+sk=";
  };
  oldPackageSet = $lib.callPackageWith {} $lib.zenPackageSources.popcornNixpkgs
    { system = "x86_64-linux"; config = {}; overlays = [ ]; };
in $lib.callPackageWith {} (recipeSource + "/scripts/D/doromitul.nix") { pkgs = oldPackageSet; gitHash = "5a05a45"; isRelease = true; };
