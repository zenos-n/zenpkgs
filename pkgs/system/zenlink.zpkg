_meta = {
  id = "com.neg-zero.zenlink";
  name = "ZenLink";
  summary = "KDE Connect device integration with bidirectional audio and camera streaming";
  description = ''
    ZenLink's GSConnect-based desktop service and GNOME Shell extension.
    Pair with the native ZenLink Android app over the local network. The phone
    controls streaming, camera selection and microphone selection. Dedicated
    desktop audio devices isolate phone microphone input from playback output.
    Enable system.programs.zenlink for session integration and virtual webcam support.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.1.0";
  tags = [ "system" "android" "gnome" "audio" "camera" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

build = $pkgs.legacy.callPackage ($lib.zenPackageSources.zenlink + "/nix/package.nix") {
  pkgs = $pkgs.legacy;
};
