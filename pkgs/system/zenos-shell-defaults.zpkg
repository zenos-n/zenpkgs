_meta = {
  id = "com.neg-zero.zenos-shell-defaults";
  name = "ZenOS shell defaults";
  summary = "Provides shell defaults and interactive Nix build progress";
  description = ''Packages the ZenOS Powerlevel10k defaults and a Nix progress sidecar. Interactive build, run, shell and develop commands show nix-output-monitor while preserving application streams and exit status.'';
  zenosVersion = 1.0.0Nb;
  packageVersion = "1.1.0";
  tags = [ "shell" "zsh" "theme" ];
  maintainers = [ $m.doromiert ];
};

build = $pkgs.legacy.callPackage (($pkgs.legacy.fetchFromGitHub {
  owner = "zenos-n";
  repo = "zenos-shell-defaults";
  rev = "0c7a421c02619dc78392163533a9bcda15334c98";
  hash = "sha256-tWQ7LkCDrm4S+reGZQqCyyKq1Z9tazrdr818cfoDt9o=";
}) + "/package.nix") { };
