# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Dorion";
  summary = "Tiny alternative Discord client";
  description = ''
    Dorion is an alternative Discord client aimed towards lower-spec or
    storage-sensitive PCs that supports themes, plugins, and more!
  '';
  zenosVersion = "1.0.0";
  packageVersion = "6.12.2";
  tags = [ "communication" "discord" "chat" "client" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.dorion;
