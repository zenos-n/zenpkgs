_meta = {
  name = "Calls";
  summary = "Phone dialer and call handler";
  description = ''
    GNOME Calls is a phone dialer and call handler. Setting NixOS option `programs.calls.enable = true` is recommended.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "50.0";
  tags = [ "communication" "telephony" "dialer" "gnome" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.calls;
