_meta = {
  name = "INAV Configurator";
  summary = "INav flight control system configuration tool";
  description = ''
    A crossplatform configuration tool for the iNav flight control system.
    Various types of aircraft are supported by the tool and by iNav, e.g.
    quadcopters, hexacopters, octocopters and fixed-wing aircraft.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "9.0.0";
  tags = [ "development" "drones" "hardware" "navigation" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

import $pkgs.legacy.inav-configurator;
