# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Bun";
  summary = "Incredibly fast JavaScript runtime, bundler, transpiler and package manager – all in one";
  description = ''
    All in one fast & easy-to-use tool. Instead of 1,000 node_modules for development, you only need bun.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.3.13";
  tags = [ "development" "javascript" "runtime" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.bun;
