_meta = {
  name = "VSCodium";
  summary = "Open source source code editor developed by Microsoft for Windows,\nLinux and macOS (VS Code without MS branding/telemetry/licensing)\n";
  description = ''
    Open source source code editor developed by Microsoft for Windows,
    Linux and macOS. It includes support for debugging, embedded Git
    control, syntax highlighting, intelligent code completion, snippets,
    and code refactoring. It is also customizable, so users can change the
    editor's theme, keyboard shortcuts, and preferences
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.116.02821";
  tags = [ "development" "editors" "ide" ];
  maintainers = [ $m.doromiert ];
  license = $l.mit;
};

import $pkgs.legacy.vscodium;
