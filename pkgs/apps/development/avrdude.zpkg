_meta = {
  name = "AVRDUDE";
  summary = "Command-line tool for programming Atmel AVR microcontrollers";
  description = ''
    AVRDUDE (AVR Downloader/UploaDEr) is an utility to
    download/upload/manipulate the ROM and EEPROM contents of AVR
    microcontrollers using the in-system programming technique (ISP).
  '';
  zenosVersion = "1.0.0";
  packageVersion = "8.1";
  tags = [ "development" "hardware" "embedded" "firmware" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.avrdude;
