_meta = {
  name = "mold";
  summary = "Faster drop-in replacement for existing Unix linkers (unwrapped) (wrapper script)";
  description = ''
    mold is a faster drop-in replacement for existing Unix linkers. It is
    several times faster than the LLVM lld linker. mold is designed to
    increase developer productivity by reducing build time, especially in
    rapid debug-edit-rebuild cycles.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.41.0";
  tags = [ "development" "build" "linker" ];
  maintainers = [ $m.doromiert ];
  license = $l.mit;
};

import $pkgs.legacy.mold;
