# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "cargo-hakari";
  summary = "Manage workspace-hack packages to speed up builds in large workspaces";
  description = ''
    cargo hakari is a command-line application to manage workspace-hack crates.
    Use it to speed up local cargo build and cargo check commands by 15-95%,
    and cumulatively by 20-25% or more.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.9.38";
  tags = [ "development" "rust" "cargo" "dependencies" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.cargo-hakari;
