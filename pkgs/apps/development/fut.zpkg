_meta = {
  name = "Fusion";
  summary = "Fusion programming language";
  description = ''
    Fusion is a programming language designed for implementing reusable components (libraries) for C, C++, C#, D, Java, JavaScript, Python, Swift, TypeScript and OpenCL C, all from a single codebase.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.3.2";
  tags = [ "development" "languages" "compilers" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.fut;
