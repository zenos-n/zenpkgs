_meta = {
  name = "binutils";
  summary = "Tools for manipulating binaries (linker, assembler, etc.) (wrapper script)";
  description = ''
    The GNU Binutils are a collection of binary tools.  The main
    ones are `ld' (the GNU linker) and `as' (the GNU assembler).
    They also include the BFD (Binary File Descriptor) library,
    `gprof', `nm', `strip', etc.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.46";
  tags = [ "development" "binaries" "linker" "assembler" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.binutils;
