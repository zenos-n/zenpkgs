# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "VisualVM";
  summary = "Visual interface for viewing information about Java applications";
  description = ''
    VisualVM is a visual tool integrating several commandline JDK
    tools and lightweight profiling capabilities. Designed for both
    production and development time use, it further enhances the
    capability of monitoring and performance analysis for the Java
    SE platform.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.2.1";
  tags = [ "development" "java" "profiling" "debugging" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.visualvm;
