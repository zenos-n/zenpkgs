# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "cargo-llvm-cov";
  summary = "Cargo subcommand to easily use LLVM source-based code coverage";
  description = ''
    In order for this to work, you either need to run `rustup component add llvm-
    tools-preview` or install the `llvm-tools-preview` component using your Nix
    library (e.g. fenix or rust-overlay)
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.8.5";
  tags = [ "development" "rust" "cargo" "coverage" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.cargo-llvm-cov;
