_meta = {
  name = "diffstat";
  summary = "Read output of diff and display a histogram of the changes";
  description = ''
    diffstat reads the output of diff and displays a histogram of the
    insertions, deletions, and modifications per-file. It is useful for
    reviewing large, complex patch files.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.69";
  tags = [ "development" "diff" "files" "command-line" ];
  maintainers = [ $m.doromiert ];
  license = $l.mit;
};

import $pkgs.legacy.diffstat;
