_meta = {
  name = "Valgrind";
  summary = "Debugging and profiling tool suite";
  description = ''
    Valgrind is an award-winning instrumentation framework for
    building dynamic analysis tools.  There are Valgrind tools that
    can automatically detect many memory management and threading
    bugs, and profile your programs in detail.  You can also use
    Valgrind to build new tools.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.26.0";
  tags = [ "development" "profiling" "debugging" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.valgrind;
