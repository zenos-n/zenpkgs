_meta = {
  name = "git-warp-time";
  summary = "Utility to reset filesystem timestamps based on Git history";
  description = ''
    A CLI utility that resets the timestamps of files in a Git repository
    working directory to the exact timestamp of the last commit which
    modified each file.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.8.5";
  tags = [ "development" "git" "timestamps" "files" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

import $pkgs.legacy.git-warp-time;
