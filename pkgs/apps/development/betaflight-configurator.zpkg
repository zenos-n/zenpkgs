_meta = {
  name = "Betaflight Configurator";
  summary = "Betaflight flight control system configuration tool";
  description = ''
    A crossplatform configuration tool for the Betaflight flight control system.
    Various types of aircraft are supported by the tool and by Betaflight, e.g.
    quadcopters, hexacopters, octocopters and fixed-wing aircraft.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "10.10.0";
  tags = [ "development" "firmware" "radio" "hardware" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3;
};

import $pkgs.legacy.betaflight-configurator;
