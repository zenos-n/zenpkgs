# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "cargo-geiger";
  summary = "Detects usage of unsafe Rust in a Rust crate and its dependencies";
  description = ''
    A cargo plugin that detects the usage of unsafe Rust in a Rust crate and
    its dependencies. It provides information to aid auditing and guide
    dependency selection but it can not help you decide when and why unsafe
    code is appropriate.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.13.0";
  tags = [ "development" "rust" "cargo" "security" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.cargo-geiger;
