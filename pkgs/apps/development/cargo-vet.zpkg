_meta = {
  name = "cargo-vet";
  summary = "Tool to help projects ensure that third-party Rust dependencies have been audited by a trusted source";
  description = ''
    Tool to help projects ensure that third-party Rust dependencies have been audited by a trusted source.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.10.2";
  tags = [ "development" "rust" "cargo" "security" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.cargo-vet;
