# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Tokei";
  summary = "Count your code, quickly";
  description = ''
    Tokei is a program that displays statistics about your code. Tokei will show the number of files, total lines within those files and code, comments, and blanks grouped by language.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "14.0.0";
  tags = [ "development" "code-statistics" "command-line" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.tokei;
