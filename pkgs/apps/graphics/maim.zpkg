_meta = {
  name = "maim";
  summary = "Command-line screenshot utility";
  description = ''
    maim (make image) takes screenshots of your desktop. It has options to
    take only a region, and relies on slop to query for regions. maim is
    supposed to be an improved scrot.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "5.8.1";
  tags = [ "graphics" "creativity" "screenshots" "x11" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.maim;
