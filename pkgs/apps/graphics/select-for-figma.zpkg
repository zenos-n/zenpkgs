_meta = {
  id = "io.github.doromiert.SelectForFigma";
  name = "Select for Figma";
  summary = "Native GTK and libadwaita Figma workspace";
  description = ''
    Figma in a native GNOME window with embedded Chromium, document tab groups,
    a thumbnail overview, local fonts, and KeePassXC integration. The homepage
    and editor follow the GNOME accent color and app appearance. Ctrl+Tab opens
    a thumbnail grid, including Home, with tab position or most recently used order.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.0.2";
  tags = [ "graphics" "design" "prototyping" "collaboration" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

build = $pkgs.legacy.callPackage (($pkgs.legacy.fetchFromGitHub {
  owner = "doromiert";
  repo = "select-for-figma";
  rev = "v1.0.2";
  hash = "sha256-Q9QAcR4oHTX/D0p3ZTHQC2OnGXRehy+cM4a0sE7f5/I=";
}) + "/package.nix") { pkgs = $pkgs.legacy; };
