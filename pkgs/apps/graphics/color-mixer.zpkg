_meta = {
  id = "com.neg-zero.ColorMixer";
  name = "Color Mixer";
  summary = "Per-monitor SDR appearance controls with native HDR bypass";
  description = ''
    Edit per-monitor brightness-slider curves, SDR gamma, contrast and six color ranges for
    each HDR monitor. Includes shared SDR references and a window mirror.
    Requires the optional grading backend in the running GNOME compositor.
    Personal profiles remain user settings; native HDR bypasses the grade.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.2.0";
  tags = [ "graphics" "color" "hdr" "gnome" "gtk4" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

build = let
  source = ($pkgs.legacy.fetchFromGitHub {
    owner = "zenos-n";
    repo = "color-mixer";
    rev = "81122726b7cdbbe6c6542bd3ba2a518398030e03";
    hash = "sha256-UQ+ULTExzCkf28o8RGfi6Sk5tkgMZIjhbcAHOyz1eI4=";
  }).outPath;
in $pkgs.legacy.callPackage (source + "/default.nix") {
  pkgs = $pkgs.legacy;
};
