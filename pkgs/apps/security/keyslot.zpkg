_meta = {
  id = "com.neg-zero.keyslot";
  name = "Keyslot";
  summary = "Native GTK4/libadwaita client for KeePassXC databases";
  description = ''
    Browse and edit KeePass databases with an adaptive GNOME interface.
    A private helper links the pinned KeePassXC core for encryption and storage.
    Includes UUID-based editing, upstream search, custom attributes, TOTP,
    history, groups, password generation, attachment transfers, database
    settings and unlock-key changes, merge/export, and local health reports.
    Development alpha: full KeePassXC feature parity is not yet implemented.
    The GNOME Quick Settings companion is packaged separately.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.2.0";
  tags = [ "security" "privacy" "passwords" "gnome" "gtk4" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

build = $pkgs.legacy.callPackage ($lib.zenPackageSources.keyslot + "/default.nix") {
  pkgs = $pkgs.legacy;
};
