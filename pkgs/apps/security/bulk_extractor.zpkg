# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "bulk_extractor";
  summary = "Digital forensics tool for extracting information from file systems";
  description = ''
    bulk_extractor is a C++ program that scans a disk image, a file, or a
    directory of files and extracts useful information without parsing
    the file system or file system structures. The results are stored in
    feature files that can be easily inspected, parsed, or processed with
    automated tools.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.1.1";
  tags = [ "security" "forensics" "filesystems" "extraction" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.bulk_extractor;
