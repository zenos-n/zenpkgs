_meta = {
  name = "testssl.sh";
  summary = "CLI tool to check a server's TLS/SSL capabilities";
  description = ''
    CLI tool which checks a server's service on any port for the support of
    TLS/SSL ciphers, protocols as well as recent cryptographic flaws and more.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.2.3";
  tags = [ "security" "tls" "networking" "auditing" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Only;
};

import $pkgs.legacy.testssl;
