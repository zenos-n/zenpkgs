_meta = {
  name = "Jupiter";
  summary = "GNOME browser with a Chromium engine and uBlock Origin";
  description = ''Native Epiphany-based GTK browser using Chromium Embedded Framework and full uBlock Origin. Uses an independent browser profile.'';
  zenosVersion = "1.0.0";
  packageVersion = "0.1.0";
  tags = [ "browser" "gnome" "web" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

build = $pkgs.legacy.callPackage (($pkgs.legacy.fetchFromGitHub {
  owner = "doromiert";
  repo = "jupiter-browser";
  rev = "cdc33c33249b36f4210e006f7939896f2e8466d3";
  hash = "sha256-VJ31F3LcGoMw7ddgrbIb0SRwagXxCVXd7XtbZQQhM28=";
}) + "/package.nix") { pkgs = $pkgs.legacy; };
