_meta = {
  id = "com.neg-zero.gnosis";
  name = "Gnosis";
  summary = "GNOME browser with a Chromium engine and uBlock Origin";
  description = ''Native GTK/libadwaita browser with an embedded Brave backend, full uBlock Origin and KeePassXC integration. The CEF/WebKit service migration remains in progress.'';
  zenosVersion = "1.0.0";
  packageVersion = "0.1.0";
  tags = [ "browser" "gnome" "web" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

# Use Gnosis's own locked package set: its Brave binary adapter checks the exact version.
build = $lib.zenPrivateHomePackage $lib.zenPackageSources.gnosis.packages.x86_64-linux.default "gnosis" "8eff4256f06a2296f7c6f362cdf5b33dd61d795f3d65faa2902fef9ba0fef45a";
