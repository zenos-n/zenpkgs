_meta = {
  id = "com.openai.codex.cli";
  name = "Codex CLI";
  summary = "Lightweight coding agent that runs in your terminal";
  description = ''
    Lightweight coding agent that runs in your terminal.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.165.0";
  tags = [ "ai" "development" "coding" "terminal" ];
  maintainers = [ $m.doromiert ];
  license = $l.asl20;
};

# Use the source-built upstream package, including its complete daemon package
# and manifest handling. Never replace bundled executables after checksumming.
build = $lib.zenPackageSources.unstablePackages.codex;
