_meta = {
  name = "Alpaca";
  summary = "Ollama client made with GTK4 and Adwaita";
  description = ''
    To run Alpaca with GPU acceleration enabled, simply override it:
    ```nix
    pkgs.alpaca.override {
      ollama = pkgs.ollama-cuda;
    }
    ```
    Or using `pkgs.ollama-rocm` for AMD GPUs.
    For a vendor agnostic solution, use: `pkgs.ollama-vulkan`.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "9.2.3";
  tags = [ "ai" "language-models" "local-inference" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.alpaca;
