_meta = {
  name = "Gerbera";
  summary = "UPnP media server";
  description = ''
    Gerbera is a Mediatomb fork.
    It allows to stream your digital media through your home network and consume it on all kinds
    of UPnP supporting devices.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.0.0";
  tags = [ "multimedia" "upnp" "media-server" "networking" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Only;
};

import $pkgs.legacy.gerbera;
