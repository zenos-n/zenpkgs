_meta = {
  name = "Crispy Doom";
  summary = "Limit-removing enhanced-resolution Doom source port based on Chocolate Doom";
  description = ''
    Crispy Doom is a limit-removing enhanced-resolution Doom source port based on Chocolate Doom.
    Its name means that 640x400 looks \"crisp\" and is also a slight reference to its origin.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "7.1";
  tags = [ "gaming" "engine" "shooter" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.crispy-doom;
