_meta = {
  name = "OVR Advanced Settings";
  summary = "SteamVR overlay for playspace and runtime controls";
  description = ''SteamVR overlay for playspace and runtime controls. Optional migration package; installation does not activate a service.'';
  zenosVersion = "1.0.0";
  packageVersion = "5.8.11";
  tags = [ "vr" "steamvr" "overlay" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

build = $pkgs.legacy.appimageTools.wrapType2 {
  pname = "ovr-advanced-settings"; version = "5.8.11";
  src = $pkgs.legacy.fetchurl {
    url = "https://github.com/OpenVR-Advanced-Settings/OpenVR-AdvancedSettings/releases/download/v5.8.11/OpenVR_Advanced_Settings-72e91e9-x86_64.AppImage";
    hash = "sha256-ql6wCqFySjWe/hoRPpik7uNVmN9Rc0ZcRhAZDuscQqU=";
  };
  extraPkgs = p: [ p.libGL p.udev p.libxrandr ];
  meta = { description = "SteamVR overlay for playspace and runtime controls"; homepage = "https://github.com/OpenVR-Advanced-Settings/OpenVR-AdvancedSettings"; license = $lib.licenses.gpl3Only; platforms = [ "x86_64-linux" ]; mainProgram = "ovr-advanced-settings"; };
};
