    You can sort and hide games or download cover art from SteamGridDB.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.12.1";
  tags = [ "gaming" "launcher" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.cartridges;
