_meta = {
  name = "XBill";
  summary = "Protect a computer network from getting infected";
  description = ''
    Ever get the feeling that nothing is going right? You're a sysadmin,
    and someone's trying to destroy your computers. The little people
    running around the screen are trying to infect your computers with
    Wingdows [TM], a virus cleverly designed to resemble a popular
    operating system.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.1";
  tags = [ "gaming" "arcade" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl1Only;
};

import $pkgs.legacy.xbill;
