_meta = {
  name = "fheroes2";
  summary = "Free implementation of Heroes of Might and Magic II game engine";
  description = ''
    In order to play this game, an original game data is required.
    Please refer to README of the project for instructions.
    On linux, the data can be placed in ~/.local/share/fheroes2 folder.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.1.13";
  tags = [ "gaming" "strategy" "turn-based" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.fheroes2;
