# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Red Eclipse";
  summary = "First person arena shooter, featuring parkour, impulse boosts, and more";
  description = ''
    Red Eclipse is a fun-filled new take on the first person arena shooter,
    featuring parkour, impulse boosts, and more. The development is geared
    toward balanced gameplay, with a general theme of agility in a variety of
    environments.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.0.0";
  tags = [ "gaming" "shooter" "multiplayer" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.redeclipse;
