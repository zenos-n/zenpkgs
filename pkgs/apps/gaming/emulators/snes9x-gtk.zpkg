# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Snes9x";
  summary = "Super Nintendo Entertainment System (SNES) emulator, GTK version";
  description = ''
    Snes9x is a portable, freeware Super Nintendo Entertainment System (SNES)
    emulator. It basically allows you to play most games designed for the SNES
    and Super Famicom Nintendo game systems on your PC or Workstation; which
    includes some real gems that were only ever released in Japan.

    Version build with GTK interface.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.63";
  tags = [ "gaming" "emulators" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.snes9x-gtk;
