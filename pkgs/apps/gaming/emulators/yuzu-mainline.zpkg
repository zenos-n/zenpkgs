_meta = {
  name = "Yuzu Mainline"; summary = "Archived Yuzu Nintendo Switch emulator";
  description = ''Yuzu Mainline 1611 from pinned NixOS 23.11, replacing the discontinued Flatpak. Upstream source repositories have been removed; the original Nix binary cache currently provides this build.'';
  zenosVersion = "1.0.0"; packageVersion = "1611";
  tags = [ "gaming" "emulator" "switch" ]; maintainers = [ $m.doromiert ]; license = $l.gpl2Plus;
};
build = let
  emulatorPackages = $lib.callPackageWith {} $lib.zenPackageSources.emulatorsNixpkgs { system = "x86_64-linux"; };
in emulatorPackages.yuzu-mainline;
