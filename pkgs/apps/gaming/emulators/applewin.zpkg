_meta = {
  name = "AppleWin";
  summary = "Apple II emulator for Linux";
  description = ''
    AppleWin on Linux is a linux port of AppleWin that shares 100% of the code
    of the core emulator and video generation. Audio, UI, scheduling and other
    peripherals are reimplemented.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.30.21.0.b";
  tags = [ "gaming" "emulators" "apple-ii" "retro" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Only;
};

import $pkgs.legacy.applewin;
