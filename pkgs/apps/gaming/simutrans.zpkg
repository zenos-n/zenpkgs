# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Simutrans";
  summary = "Simulation game in which the player strives to run a successful transport system";
  description = ''
    Simutrans is a cross-platform simulation game in which the
    player strives to run a successful transport system by
    transporting goods, passengers, and mail between
    places. Simutrans is an open source remake of Transport Tycoon.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "121.0";
  tags = [ "gaming" "simulation" "management" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.simutrans;
