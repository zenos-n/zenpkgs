_meta = {
  name = "zenos-vr-tools";
  summary = "ZenOS VR launcher, manager and overlay supervisor";
  description = ''ZenOS VR launcher, manager and overlay supervisor. Optional migration package; installation does not activate a service.'';
  zenosVersion = "1.0.0";
  packageVersion = "1.0.0";
  tags = [ "vr" "steamvr" "migration" ];
  maintainers = [ $m.doromiert ];
};

build = $pkgs.legacy.callPackage ($lib.zenPackageSources.vrTools + "/package.nix") {
  pkgs = $pkgs.legacy;
  alvr = $pkgs.apps.gaming.alvr-zenos-compat;
  fnuidesktop-vr = $pkgs.apps.gaming.fnuidesktop-vr;
  ovr-advanced-settings = $pkgs.apps.gaming.ovr-advanced-settings;
  wlx-overlay-s = $pkgs.apps.gaming.wlx-overlay-s;
};
