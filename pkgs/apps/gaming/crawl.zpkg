# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Dungeon Crawl Stone Soup";
  summary = "Open-source, single-player, role-playing roguelike game";
  description = ''
    Dungeon Crawl: Stone Soup, an open-source, single-player, role-playing
    roguelike game of exploration and treasure-hunting in dungeons filled
    with dangerous and unfriendly monsters in a quest to rescue the
    mystifyingly fabulous Orb of Zot.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.34.1";
  tags = [ "gaming" "roguelike" "rpg" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.crawl;
