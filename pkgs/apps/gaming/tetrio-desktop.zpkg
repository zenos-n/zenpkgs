_meta = {
  name = "TETR.IO";
  summary = "Desktop client for TETR.IO, an online stacker game";
  description = ''
    TETR.IO is a free-to-win modern yet familiar online stacker.
    Play multiplayer games against friends and foes all over the world, or claim a spot on the leaderboards - the stacker future is yours!
  '';
  zenosVersion = "1.0.0";
  packageVersion = "10";
  tags = [ "gaming" "puzzle" ];
  maintainers = [ $m.doromiert ];
  license = $l.unfree;
};

import $pkgs.legacy.tetrio-desktop;
