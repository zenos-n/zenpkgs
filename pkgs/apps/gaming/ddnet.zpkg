# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "DDNet";
  summary = "Teeworlds modification with a unique cooperative gameplay";
  description = ''
    DDraceNetwork (DDNet) is an actively maintained version of DDRace,
    a Teeworlds modification with a unique cooperative gameplay.
    Help each other play through custom maps with up to 64 players,
    compete against the best in international tournaments,
    design your own maps, or run your own server.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "19.8.3";
  tags = [ "gaming" "platformer" "multiplayer" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.ddnet;
