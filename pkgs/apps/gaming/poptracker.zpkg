_meta = {
  name = "PopTracker";
  summary = "Scriptable tracker for randomized games";
  description = ''
    Universal, scriptable randomizer tracking solution that is open source. Supports auto-tracking.

    PopTracker packs should be placed in `~/PopTracker/packs` or `./packs`.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.35.1";
  tags = [ "gaming" "tracking" "randomizers" "companion" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

import $pkgs.legacy.poptracker;
