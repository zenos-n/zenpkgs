_meta = {
  id = "gay.nzp.nzportable";
  name = "NZPortable";
  summary = "Cooperative zombie survival FPS built from the upstream sources";
  description = ''
    Native Nazi Zombies: Portable, built from pinned upstream Vril engine,
    QuakeC game code and assets. Maps come from the verified 2026-10-23
    official Linux snapshot. Engine/game code use GPLv2; game assets and maps
    use CC BY-SA 4.0. Writable configuration and saves stay in the user's data directory.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.0.0-unstable-2026-10-23";
  tags = [ "game" "fps" "zombies" ];
  maintainers = [ $m.doromiert ];
};

build = $pkgs.legacy.callPackage ($lib.zenPackageSources.nzportable + "/package.nix") {
  pkgs = $pkgs.legacy;
};
