# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "VCMI";
  summary = "Open-source engine for Heroes of Might and Magic III";
  description = ''
    VCMI is an open-source engine for Heroes of Might and Magic III, offering
    new and extended possibilities. To use VCMI, you need to own the original
    data files.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.7.4";
  tags = [ "gaming" "strategy" "turn-based" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.vcmi;
