# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Numbat";
  summary = "High precision scientific calculator with full support for physical units";
  description = ''
    A statically typed programming language for scientific computations
    with first class support for physical dimensions and units
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.23.0";
  tags = [ "science" "calculator" "terminal" "education" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.numbat;
