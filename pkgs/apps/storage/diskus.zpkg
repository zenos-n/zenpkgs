# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "diskus";
  summary = "Minimal, fast alternative to 'du -sh'";
  description = ''
    diskus is a very simple program that computes the total size of the
    current directory. It is a parallelized version of du -sh.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.9.0";
  tags = [ "storage" "disk-usage" "analysis" "command-line" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.diskus;
