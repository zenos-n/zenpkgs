_meta = {
  name = "Partclone";
  summary = "Utilities to save and restore used blocks on a partition";
  description = ''
    Partclone provides utilities to save and restore used blocks on a
    partition and is designed for higher compatibility of the file system by
    using existing libraries, e.g. e2fslibs is used to read and write the
    ext2 partition.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.3.38";
  tags = [ "storage" "backup" "recovery" "disk-images" "disks" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.partclone;
