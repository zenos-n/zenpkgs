_meta = {
  name = "Workrave";
  summary = "Program to help prevent Repetitive Strain Injury";
  description = ''
    Workrave is a program that assists in the recovery and prevention of
    Repetitive Strain Injury (RSI). The program frequently alerts you to
    take micro-pauses, rest breaks and restricts you to your daily limit.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.10.54";
  tags = [ "accessibility" "break-reminders" "productivity" "assistive-technology" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3;
};

import $pkgs.legacy.workrave;
