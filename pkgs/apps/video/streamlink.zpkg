_meta = {
  name = "Streamlink";
  summary = "CLI for extracting streams from various websites to video player of your choosing";
  description = ''
    Streamlink is a CLI utility that pipes videos from online
    streaming services to a variety of video players such as VLC, or
    alternatively, a browser.

    Streamlink is a fork of the livestreamer project.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "8.4.0";
  tags = [ "video" "streaming" "networking" "multimedia" "creativity" ];
  maintainers = [ $m.doromiert ];
  license = $l.bsd2;
};

import $pkgs.legacy.streamlink;
