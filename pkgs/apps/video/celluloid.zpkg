_meta = {
  name = "Celluloid";
  summary = "Simple GTK frontend for the mpv video player";
  description = ''
    Celluloid (formerly GNOME MPV) is a simple GTK+ frontend for mpv.
    Celluloid interacts with mpv via the client API exported by libmpv,
    allowing access to mpv's powerful playback capabilities.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.30";
  tags = [ "video" "multimedia" "creativity" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.celluloid;
