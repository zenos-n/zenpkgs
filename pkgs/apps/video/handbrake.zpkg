_meta = {
  name = "HandBrake";
  summary = "Tool for converting video files and ripping DVDs";
  description = ''
    Tool for converting and remuxing video files
    into selection of modern and widely supported codecs
    and containers. Very versatile and customizable.
    Package provides:
    CLI - `HandbrakeCLI`
    GTK GUI - `ghb`
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.10.2";
  tags = [ "video" "multimedia" "creativity" "conversion" "encoding" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Only;
};

import $pkgs.legacy.handbrake;
