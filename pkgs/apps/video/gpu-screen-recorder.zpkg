_meta = {
  id = "com.dec05eba.gpu-screen-recorder.cli";
  name = "GPU Screen Recorder CLI";
  summary = "GPU-accelerated recording and instant replay";
  description = ''GPU-accelerated recording and instant replay. Uses the maintained nixpkgs package.'';
  zenosVersion = "1.0.0";
  packageVersion = "5.13.8";
  tags = [ "video" "recording" "gaming" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

build = $lib.makeOverridable ({ wrapperDir ? "/run/wrappers/bin" }:
  $pkgs.legacy.symlinkJoin {
    name = "gpu-screen-recorder-${$pkgs.legacy.gpu-screen-recorder.version}-zenfs";
    paths = [ ($pkgs.legacy.gpu-screen-recorder.override { inherit wrapperDir; }) ];
    nativeBuildInputs = [ $pkgs.legacy.makeWrapper ];
    postBuild = ''
      original=$(readlink "$out/bin/gpu-screen-recorder")
      rm "$out/bin/gpu-screen-recorder"
      makeWrapper "$original" "$out/bin/gpu-screen-recorder" \
        --run 'if [ -d "$HOME/.private" ]; then
          export HOME="$HOME/.private/Packages/gpu-screen-recorder"
          mkdir -p "$HOME"
        fi' \
        --prefix PATH : "${wrapperDir}"
    '';
    meta = $pkgs.legacy.gpu-screen-recorder.meta;
    version = $pkgs.legacy.gpu-screen-recorder.version;
  }
) {};
