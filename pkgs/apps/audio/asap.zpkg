_meta = {
  name = "Another Slight Atari Player";
  summary = "Another Slight Atari Player";
  description = ''
    ASAP (Another Slight Atari Player) plays and converts 8-bit Atari POKEY
    music (*.sap, *.cmc, *.mpt, *.rmt, *.tmc, ...) on modern computers and
    mobile devices.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "8.0.0";
  tags = [ "audio" "music" "atari" "chiptune" "player" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.asap;
