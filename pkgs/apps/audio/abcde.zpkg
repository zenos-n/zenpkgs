_meta = {
  name = "abcde";
  summary = "Command-line audio CD ripper";
  description = ''
    abcde is a front-end command-line utility (actually, a shell
    script) that grabs tracks off a CD, encodes them to
    Ogg/Vorbis, MP3, FLAC, Ogg/Speex and/or MPP/MP+ (Musepack)
    format, and tags them, all in one go.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.9.3";
  tags = [ "audio" "cd" "ripping" "multimedia" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.abcde;
