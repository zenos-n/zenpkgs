_meta = {
  name = "Yoshimi";
  summary = "High quality software synthesizer based on ZynAddSubFX";
  description = ''
    Yoshimi delivers the same synthesizer capabilities as
    ZynAddSubFX along with very good Jack and Alsa midi/audio
    functionality on Linux
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.3.6.2";
  tags = [ "audio" "synthesis" "music-production" "multimedia" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.yoshimi;
