  '';
  zenosVersion = "1.0.0";
  packageVersion = "4.5.1";
  tags = [ "audio" "chiptune" "composition" "multimedia" ];
  maintainers = [ $m.doromiert ];
  license = $l.mit;
};

import $pkgs.legacy.famistudio;
