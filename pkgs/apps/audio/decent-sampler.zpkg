_meta = {
  name = "Decent Sampler";
  summary = "Audio sample player";
  description = ''
    Decent Sampler is an audio sample player.
    Allowing you to play sample libraries in the DecentSampler format
    (files with extensions: dspreset and dslibrary).
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.18.1";
  tags = [ "audio" "sampling" "music" ];
  maintainers = [ $m.doromiert ];
  license = $l.unfree;
};

import $pkgs.legacy.decent-sampler;
