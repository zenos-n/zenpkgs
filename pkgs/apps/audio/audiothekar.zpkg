  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.0.1";
  tags = [ "audio" "downloads" "radio" "podcasts" "ard" ];
  maintainers = [ $m.doromiert ];
  license = $l.mit;
};

import $pkgs.legacy.audiothekar;
