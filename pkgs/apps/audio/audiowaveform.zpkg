_meta = {
  name = "audiowaveform";
  summary = "C++ program to generate waveform data and render waveform images from audio files";
  description = ''
    audiowaveform is a C++ command-line application that generates waveform data from either MP3, WAV, FLAC, or Ogg Vorbis format audio files.
    Waveform data can be used to produce a visual rendering of the audio, similar in appearance to audio editing applications.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.10.3";
  tags = [ "audio" "waveforms" "visualization" "analysis" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.audiowaveform;
