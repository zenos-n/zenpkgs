    spell checking and support of any compilation chain.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "4.9.3";
  tags = [ "office" "productivity" "writing" "latex" "science" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.texstudio;
