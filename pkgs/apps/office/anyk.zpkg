_meta = {
  name = "ÁNYK";
  summary = "Tool for filling forms for the Hungarian government";
  description = ''
    Official tool for filling Hungarian government forms.

    Use `anyk-java` to install form templates/help files like this: `anyk-java -jar NAV_IGAZOL.jar`
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.48.0";
  tags = [ "office" "forms" "government" "hungary" ];
  maintainers = [ $m.doromiert ];
  license = $l.unfree;
};

import $pkgs.legacy.anyk;
