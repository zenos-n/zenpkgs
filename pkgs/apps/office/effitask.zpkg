_meta = {
  name = "Effitask";
  summary = "Graphical task manager, based on the todo.txt format";
  description = ''
    To use it as todo.sh add-on, create a symlink like this:
    mkdir ~/.todo.actions.d/
    ln -s $(which effitask) ~/.todo.actions.d/et

    Or use it as standalone program by defining some environment variables
    like described in the projects readme.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.4.2";
  tags = [ "office" "tasks" "todo-txt" "productivity" ];
  maintainers = [ $m.doromiert ];
  license = $l.mit;
};

import $pkgs.legacy.effitask;
