_meta = {
  name = "Epson Scan 2";
  summary = "Epson Scan 2 scanner driver for many modern Epson scanners and multifunction printers";
  description = ''
    The Epson Scan 2 scanner driver, including optional non-free plugins such
    as OCR and network scanning.

    To use the SANE backend:
    ```nix
    {
      hardware.sane.extraBackends = [ pkgs.epsonscan2 ];
    }
    ```

    Overrides can be used to customise this package. For example, to enable
    non-free plugins and disable the Epson GUI:
    ```nix
    pkgs.epsonscan2.override {
      withNonFreePlugins = true;
      withGui = false;
    }
    ```
  '';
  zenosVersion = "1.0.0";
  packageVersion = "6.7.90.0-2026-01";
  tags = [ "office" "scanning" "documents" "hardware" ];
  maintainers = [ $m.doromiert ];
  license = $l.lgpl21Plus;
};

import $pkgs.legacy.epsonscan2;
