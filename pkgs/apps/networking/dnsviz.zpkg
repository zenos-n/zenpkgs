_meta = {
  name = "DNSViz";
  summary = "Tool suite for analyzing and visualizing DNS and DNSSEC behavior";
  description = ''
    DNSViz is a tool suite for analysis and visualization of Domain Name System (DNS) behavior,
    including its security extensions (DNSSEC).

    This tool suite powers the Web-based analysis available at https://dnsviz.net/
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.11.1";
  tags = [ "networking" "dns" "dnssec" "visualization" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.dnsviz;
