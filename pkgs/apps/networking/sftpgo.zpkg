# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "SFTPGo";
  summary = "Fully featured and highly configurable SFTP server";
  description = ''
    Fully featured and highly configurable SFTP server
    with optional HTTP/S, FTP/S and WebDAV support.
    Several storage backends are supported:
    local filesystem, encrypted local filesystem, S3 (compatible) Object Storage,
    Google Cloud Storage, Azure Blob Storage, SFTP.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.7.1";
  tags = [ "networking" "files" "transfer" "server" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.sftpgo;
