_meta = {
  name = "minicom";
  summary = "Modem control and terminal emulation program";
  description = ''
    Minicom is a menu driven communications program. It emulates ANSI
    and VT102 terminals. It has a dialing directory and auto zmodem
    download.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.10";
  tags = [ "terminal" "serial" "hardware" "development" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.minicom;
