_meta = {
  name = "Distrobox";
  summary = "Wrapper around podman or docker to create and start containers";
  description = ''
    Use any linux distribution inside your terminal. Enable both backward and
    forward compatibility with software and freedom to use whatever distribution
    you’re more comfortable with
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.8.2.5";
  tags = [ "containers" "development" "terminal" "system" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

import $pkgs.legacy.distrobox;
