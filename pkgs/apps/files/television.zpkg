_meta = {
  name = "television";
  summary = "Blazingly fast general purpose fuzzy finder TUI";
  description = ''
    Television is a fast and versatile fuzzy finder TUI.
    It lets you quickly search through any kind of data source (files, git
    repositories, environment variables, docker images, you name it) using a
    fuzzy matching algorithm and is designed to be easily extensible.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.15.6";
  tags = [ "files" "search" "fuzzy" "terminal" ];
  maintainers = [ $m.doromiert ];
  license = $l.mit;
};

import $pkgs.legacy.television;
