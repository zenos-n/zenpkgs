# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Deark";
  summary = "Utility for file format and metadata analysis, data extraction, decompression, and image format decoding";
  description = ''
    Deark is a portable command-line utility that can decode certain
    types of files, and either convert them to a more-modern or
    more-readable format, or extract embedded files from them.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.7.2";
  tags = [ "files" "formats" "extraction" "analysis" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.deark;
