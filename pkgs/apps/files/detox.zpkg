_meta = {
  name = "detox";
  summary = "Utility designed to clean up filenames";
  description = ''
    Detox is a utility designed to clean up filenames. It replaces
    difficult to work with characters, such as spaces, with standard
    equivalents. It will also clean up filenames with UTF-8 or Latin-1
    (or CP-1252) characters in them.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.0.1";
  tags = [ "files" "filenames" "cleanup" "renaming" ];
  maintainers = [ $m.doromiert ];
  license = $l.bsd3;
};

import $pkgs.legacy.detox;
