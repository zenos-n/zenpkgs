_meta = {
  name = "tree";
  summary = "Command to produce a depth indented directory listing";
  description = ''
    Tree is a recursive directory listing command that produces a
    depth indented listing of files, which is colorized ala dircolors if
    the LS_COLORS environment variable is set and output is to tty.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.3.2";
  tags = [ "files" "listing" "terminal" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.tree;
