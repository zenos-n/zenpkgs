# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "fd";
  summary = "Simple, fast and user-friendly alternative to find";
  description = ''
    `fd` is a simple, fast and user-friendly alternative to `find`.

    While it does not seek to mirror all of `find`'s powerful functionality,
    it provides sensible (opinionated) defaults for 80% of the use cases.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "10.4.2";
  tags = [ "files" "search" "command-line" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.fd;
