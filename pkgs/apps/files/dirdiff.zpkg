_meta = {
  name = "dirdiff";
  summary = "Graphical directory tree diff and merge tool";
  description = ''
    Dirdiff is a graphical tool for displaying the differences between
    directory trees and for merging changes from one tree into another.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.1";
  tags = [ "files" "comparison" "development" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.dirdiff;
