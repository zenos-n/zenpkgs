_meta = {
  name = "EdgeTX Companion";
  summary = "EdgeTX Companion transmitter support software";
  description = ''
    EdgeTX Companion is used for many different tasks like loading EdgeTX
    firmware to the radio, backing up model settings, editing settings and
    running radio simulators.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "2.11.3";
  tags = [ "radio" "transmitters" "configuration" "hardware" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Only;
};

import $pkgs.legacy.edgetx;
