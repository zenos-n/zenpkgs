_meta = {
  name = "RTL-SDR";
  summary = "Software to turn the RTL2832U into a SDR receiver";
  description = ''
    Fork of the rtl-sdr library by the Osmocom project. A list of differences
    can be found here: https://github.com/rtlsdrblog/rtl-sdr-blog/blob/master/README
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.3.5";
  tags = [ "radio" "sdr" "hardware" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
};

import $pkgs.legacy.rtl-sdr;
