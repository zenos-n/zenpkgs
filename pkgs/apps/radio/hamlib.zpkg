# Upstream license metadata is retained by the imported recipe.
_meta = {
  name = "Hamlib";
  summary = "Runtime library to control radio transceivers and receivers";
  description = ''
    Hamlib provides a standardized programming interface that applications
    can use to send the appropriate commands to a radio.

    Also included in the package is a simple radio control program 'rigctl',
    which lets one control a radio transceiver or receiver, either from
    command line interface or in a text-oriented interactive interface.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.3";
  tags = [ "radio" "amateur-radio" "hardware-control" ];
  maintainers = [ $m.doromiert ];
};

import $pkgs.legacy.hamlib;
