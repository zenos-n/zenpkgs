_meta = {
  name = "Back In Time";
  summary = "Simple backup tool for Linux";
  description = ''
    Back In Time is a simple backup tool (on top of rsync) for Linux
    inspired from "flyback project" and "TimeVault". The backup is
    done by taking snapshots of a specified set of directories.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.6.1";
  tags = [ "backup" "storage" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2;
};

import $pkgs.legacy.backintime;
