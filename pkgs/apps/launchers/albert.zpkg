_meta = {
  name = "Albert";
  summary = "Fast and flexible keyboard launcher";
  description = ''
    Albert is a desktop agnostic launcher. Its goals are usability and beauty,
    performance and extensibility. It is written in C++ and based on the Qt
    framework.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "34.0.10";
  tags = [ "launchers" "search" "keyboard" "productivity" ];
  maintainers = [ $m.doromiert ];
  license = $l.unfree;
};

import $pkgs.legacy.albert;
