_meta = {
  name = "isd";
  summary = "TUI to interactively work with systemd units";
  description = ''
    isd (interactive systemd) is a TUI offering fuzzy search for systemd
    units, auto-refreshing previews, smart `sudo` handling, and a fully
    customizable interface for power-users and newcomers alike.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "0.6.2";
  tags = [ "system" "administration" "services" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

import $pkgs.legacy.isd;
