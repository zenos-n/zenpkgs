_meta = {
  name = "CoreCtrl";
  summary = "Control your computer hardware via application profiles";
  description = ''
    CoreCtrl is a Free and Open Source GNU/Linux application that allows you
    to control with ease your computer hardware using application profiles. It
    aims to be flexible, comfortable and accessible to regular users.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.5.1";
  tags = [ "system" "administration" "hardware" "performance" "cooling" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Plus;
};

import $pkgs.legacy.corectrl;
