_meta = {
  name = "gensort";
  summary = "Generate and validate records for the sorting benchmark";
  description = ''
    The gensort program can be used to generate input records for the sort
    benchmarks presented on www.sortbenchmark.org.

    The valsort program can be used to validate the sort output file is
    correct.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.5";
  tags = [ "system" "monitoring" "benchmarks" "sorting" "test-data" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Only;
};

import $pkgs.legacy.gensort;
