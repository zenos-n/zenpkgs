_meta = {
  name = "radeontop";
  summary = "Top-like tool for viewing AMD Radeon GPU utilization";
  description = ''
    View GPU utilization, both for the total activity percent and individual
    blocks. Supports R600 and later cards: even Southern Islands should work.
    Works with both the open drivers and AMD Catalyst. Total GPU utilization
    is also valid for OpenCL loads; the other blocks are only useful for GL
    loads.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "1.4";
  tags = [ "system" "monitoring" "graphics" "hardware" "diagnostics" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3;
};

import $pkgs.legacy.radeontop;
