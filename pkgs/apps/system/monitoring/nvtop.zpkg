_meta = {
  name = "nvtop";
  summary = "htop-like task monitor for AMD, Adreno, Intel and NVIDIA GPUs";
  description = ''
    Nvtop stands for Neat Videocard TOP, a (h)top like task monitor for AMD, Adreno, Intel and NVIDIA GPUs.
    It can handle multiple GPUs and print information about them in a htop familiar way.
  '';
  zenosVersion = "1.0.0";
  packageVersion = "3.3.2";
  tags = [ "system" "monitoring" "gpu" ];
  maintainers = [ $m.doromiert ];
  license = $l.gpl3Only;
};

import $pkgs.legacy.nvtopPackages.full;
