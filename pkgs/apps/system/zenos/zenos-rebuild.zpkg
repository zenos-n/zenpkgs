_meta = {
  id = "com.neg-zero.zenos-rebuild";
  name = "ZenOS rebuild";
  summary = "Rebuilds ZenOS from canonical ZCFG sources";
  description = ''Packages the secure configuration snapshot and rebuild workflow used by live and installed systems.'';
  zenosVersion = 1.0.0Nb;
  packageVersion = "1.1.0";
  tags = [ "configuration" "system" ];
  maintainers = [ $m.doromiert ];
};

build = $pkgs.legacy.callPackage ($lib.zenPackageSources.rebuild + "/package.nix") {};
