_meta = {
  id = "com.neg-zero.zenos-setup";
  name = "ZenOS Setup";
  summary = "ZenOS installer and first-boot setup";
  description = ''Installs ZenOS and finishes user setup after the first boot.'';
  zenosVersion = 1.0.0Nb;
  packageVersion = "0.1.0";
  tags = [ "installer" "oobe" ];
  maintainers = [ $m.doromiert ];
};

build = $pkgs.legacy.callPackage ($lib.zenPackageSources.setup + "/package.nix") {
  applicationIcons = {
    "com.neg-zero.Gnosis" = $lib.zenPackageSources.gnosis.outPath + "/data/icons/hicolor/scalable/apps/com.neg-zero.Gnosis.svg";
    "io.github.doromiert.SelectForFigma" = $pkgs.byCategories.apps.graphics.select-for-figma.src + "/data/io.github.doromiert.SelectForFigma.svg";
  };
};
