_meta = {
  zenosVersion = 0.1.0;
  id = "zenos.structure";
  summary = "ZenOS configuration structure";
  description = ''Canonical roots and routing for ZenOS configuration.'';
  maintainers = [ $m.doromiert ];
  license = $l.napalm;
};

# Upstream options are exposed lazily through the compatibility mount.
legacy = {
  _meta = {
    type = (alias nixpkgs);
    summary = "Upstream options exposed through Zen DSL";
    description = ''Typed compatibility routes to pinned upstream options.'';
    maintainers = [ ];
  };
};

system = {
  _meta = {
    type = (zmdl system);
    summary = "Global system configuration for ZenOS";
    description = ''Core configuration that applies globally.'';
    maintainers = [ $m.doromiert ];
  };
  packages = {
    _meta = {
      type = (packages);
      summary = "System package selectors";
      description = ''Boolean selectors over the pkgs.zenos tree.'';
      maintainers = [ $m.doromiert ];
    };
  };
  programs = {
    _meta = {
      type = (zmdl programs);
      summary = "System program selectors";
      description = ''Typed program configuration in system scope.'';
      maintainers = [ $m.doromiert ];
    };
  };
};

# File paths establish identity; this mount exposes modules/desktops/gnome.zmdl.
desktops = {
  _meta = {
    type = (zmdl desktops);
    summary = "Desktop environments";
    description = ''Desktop environment and window manager configuration.'';
    maintainers = [ $m.doromiert ];
  };
};

users = {
  _meta = {
    summary = "Per-user configuration";
    description = ''Configuration and selectors scoped to individual users.'';
    maintainers = [ $m.doromiert ];
  };
  (freeform user) = {
    _meta = {
      summary = "User options";
      description = ''Configuration for user $f.user.'';
    };
    packages = {
      _meta = {
        type = (packages);
        summary = "User package selectors";
        description = ''Boolean selectors over the pkgs.zenos tree.'';
        maintainers = [ $m.doromiert ];
      };
    };
    programs = {
      _meta = {
        type = (zmdl programs);
        summary = "User program selectors";
        description = ''Typed program configuration in user scope.'';
        maintainers = [ $m.doromiert ];
      };
    };
  };
};
