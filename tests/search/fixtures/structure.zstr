legacy = {
  _meta.type = (alias nixpkgs);
  homeManager._meta.type = (zmdl programs.demo);
};
system = {
  programs._meta.type = (zmdl programs);
  packages._meta.type = (packages);
  syncthing = {
    _meta = {
      type = (alias nixpkgs.services.syncthing);
      name = "Syncthing";
      maintainers = [ $m.doromiert ];
      license = $l.mit;
    };
    localEnabled = { _meta.type = $type.bool; _meta.default = true; };
    local = { _meta.type = $type.string; };
  };
};
relocated._meta.type = (zmdl programs);
users = {
  (freeform user) = {
    programs._meta.type = (zmdl programs);
    packages._meta.type = (packages);
    legacy = {
      _meta.type = (alias nixpkgs.users.users.($f.user));
      homeManager = {
        _meta.type = (alias nixpkgs.home-manager.users.($f.user));
        local._meta.type = (zmdl programs.demo);
      };
    };
  };
};
