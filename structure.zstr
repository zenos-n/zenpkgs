_meta = {
  zenosVersion = 0.1.0;
  name = "ZenOS configuration";
  summary = "ZenOS configuration structure";
  description = ''Canonical roots and routing for ZenOS configuration.'';
  tags = [ "configuration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napalm;
};

# Upstream contents are discovered lazily through this compatibility mount.
legacy = {
  _meta = {
    type = (alias nixpkgs);
    name = "Legacy";
    summary = "Upstream options exposed through Zen DSL";
    description = ''Typed compatibility routes to pinned upstream options.'';
    tags = [ "compatibility" ];
    maintainers = [ ];
    license = $l.napalm;
  };
};

system = {
  _meta = {
    type = (zmdl system);
    name = "System";
    summary = "Global system configuration for ZenOS";
    description = ''Core configuration that applies globally.'';
    tags = [ "system" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  oobeMode._meta = {
    type = $type.bool;
    default = false;
    name = "OOBE mode";
    summary = "Run the temporary out-of-box experience";
    description = ''Selects the temporary OOBE system composition when true.'';
    tags = [ "system" "oobe" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  packages = {
    _meta = {
      type = (packages);
      name = "System packages";
      summary = "System package selectors";
      description = ''Boolean selectors over filesystem-derived pkgs paths.'';
      tags = [ "packages" ];
      maintainers = [ $m.doromiert ];
      license = $l.napalm;
    };
  };
  programs = {
    _meta = {
      type = (zmdl programs);
      name = "System programs";
      summary = "System program selectors";
      description = ''Typed program configuration in system scope.'';
      tags = [ "programs" ];
      maintainers = [ $m.doromiert ];
      license = $l.napalm;
    };
    legacy._meta = {
      type = (alias nixpkgs.programs);
      name = "Legacy system programs";
      summary = "Upstream program configuration";
      description = ''Lazily exposes NixOS program options.'';
      tags = [ "compatibility" ];
      maintainers = [ ];
      license = $l.napalm;
    };
  };

  flatpak._meta = {
    type = (alias nixpkgs.services.flatpak);
    name = "flatpak";
    summary = "Typed flatpak configuration";
    description = ''Configure flatpak using its pinned upstream schema. This mount does not enable the capability.'';
    tags = [ "migration" "configuration" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };

  programs.firefox._meta = {
    type = (alias nixpkgs.programs.firefox);
    name = "firefox";
    summary = "Typed firefox configuration";
    description = ''Configure firefox using its pinned upstream schema. This mount does not enable the capability.'';
    tags = [ "migration" "configuration" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  syncthing._meta = {
    type = (alias nixpkgs.services.syncthing);
    zenosVersion = 1.0.0Na;
    name = "Syncthing";
    summary = "Upstream Syncthing configuration";
    description = ''Exposes the pinned NixOS Syncthing schema at the existing system.syncthing path.'';
    tags = [ "syncthing" "compatibility" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  hardware.mouseGestures._meta = {
    type = (alias nixpkgs.services.masterfulGestures);
    name = "Mouse gestures";
    summary = "Configure mouse gestures";
    description = ''Expose the pinned Masterful Gestures backend. Device paths and bindings are selected by the host.'';
    tags = [ "hardware" "input" ];
    maintainers = [ $m.doromiert ]; license = $l.napl;
  };
};

# File paths determine identity; this mount exposes the desktop module tree.
desktops = {
  _meta = {
    type = (zmdl desktops);
    name = "Desktops";
    summary = "Desktop environments";
    description = ''Desktop environment and window manager configuration.'';
    tags = [ "desktop" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
};

users = {
  _meta = {
    type = (zmdl users);
    name = "Users";
    summary = "Per-user configuration";
    description = ''Configuration and selectors scoped to individual users.'';
    tags = [ "users" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  (freeform user) = {
    _meta = {
      type = (zmdl userModules);
      name = "User ${$f.user}";
      summary = "User options";
      description = ''Configuration for user ${$f.user}.'';
      tags = [ "users" ];
      maintainers = [ $m.doromiert ];
      license = $l.napalm;
    };
    packages = {
      _meta = {
        type = (packages);
        name = "User packages";
        summary = "User package selectors";
        description = ''Boolean selectors over filesystem-derived pkgs paths.'';
        tags = [ "packages" ];
        maintainers = [ $m.doromiert ];
        license = $l.napalm;
      };
    };
    programs = {
      _meta = {
        type = (zmdl programs);
        name = "User programs";
        summary = "User program selectors";
        description = ''Typed program configuration in user scope.'';
        tags = [ "programs" ];
        maintainers = [ $m.doromiert ];
        license = $l.napalm;
      };
      legacy._meta = {
        type = (alias nixpkgs.home-manager.users.($f.user).programs);
        name = "Legacy user programs";
        summary = "Upstream user program configuration";
        description = ''Lazily exposes this user's Home Manager program options.'';
        tags = [ "compatibility" ];
        maintainers = [ ];
        license = $l.napalm;
        default = { };
      };
    };

    programs.pwamaker._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.pwamaker);
      name = "Firefox web applications";
      summary = "Configure Firefox PWAs and URL dispatch";
      description = ''Migration backend for existing Firefox web applications, profiles, extensions and URL dispatch rules. Disabled until explicitly selected.'';
      tags = [ "browser" "web-apps" "migration" ];
      maintainers = [ $m.doromiert ]; license = $l.napl;
    };

    programs.firefox._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.firefox);
      name = "firefox";
      summary = "Typed firefox configuration";
      description = ''Configure firefox using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    programs.vscode._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.vscode);
      name = "vscode";
      summary = "Typed vscode configuration";
      description = ''Configure vscode using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    programs.kitty._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.kitty);
      name = "kitty";
      summary = "Typed kitty configuration";
      description = ''Configure kitty using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    programs.keepassxc._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.keepassxc);
      name = "keepassxc";
      summary = "Typed keepassxc configuration";
      description = ''Configure keepassxc using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    programs.zoxide._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.zoxide);
      name = "zoxide";
      summary = "Typed zoxide configuration";
      description = ''Configure zoxide using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    programs.nixcord._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.nixcord);
      name = "nixcord";
      summary = "Typed nixcord configuration";
      description = ''Configure nixcord using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    programs.zed-editor._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).programs.zed-editor);
      name = "zed-editor";
      summary = "Typed zed-editor configuration";
      description = ''Configure zed-editor using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    services.flatpak._meta = {
      type = (alias nixpkgs.home-manager.users.($f.user).services.flatpak);
      name = "flatpak";
      summary = "Typed flatpak configuration";
      description = ''Configure flatpak using its pinned upstream schema. This mount does not enable the capability.'';
      tags = [ "migration" "configuration" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };

    legacy = {
      _meta = {
        type = (alias nixpkgs.users.users.($f.user));
        name = "Legacy user options";
        summary = "Raw NixOS user options";
        description = ''Mirrors this user's NixOS user subtree through typed Zen DSL.'';
        tags = [ "compatibility" ];
        maintainers = [ ];
        license = $l.napalm;
      };
      homeManager._meta = {
        type = (alias nixpkgs.home-manager.users.($f.user));
        name = "Home Manager options";
        summary = "Upstream Home Manager user configuration";
        description = ''Overlays this user's Home Manager root, excluding its ZenOS subtree.'';
        tags = [ "compatibility" ];
        maintainers = [ ];
        license = $l.napalm;
      };
    };
  };
};
