_meta = {
  zenosVersion = 0.1.0;
  name = "ZenOS configuration";
  summary = "Public configuration mounts";
  description = ''Defines the public system, desktop, user, and compatibility scopes.'';
  tags = [ "structure" ];
  maintainers = [ $m.doromiert ];
  license = $l.napalm;
};

legacy._meta = {
  type = (alias nixpkgs);
  name = "Upstream options";
  summary = "Lazy NixOS option mirror";
  description = ''Mirrors the upstream schema without its internal ZenOS root.'';
  tags = [ "compatibility" ];
  maintainers = [ $m.doromiert ];
  license = $l.napalm;
};

system = {
  _meta = {
    type = (zmdl system);
    name = "System";
    summary = "System-wide configuration";
    description = ''Mounts system definitions and system-wide selectors.'';
    tags = [ "system" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  packages._meta = {
    type = (packages);
    name = "System packages";
    summary = "Boolean installation selectors";
    description = ''Selects packages by their full public package path.'';
    tags = [ "packages" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  programs._meta = {
    type = (zmdl programs);
    name = "System programs";
    summary = "System-scoped program definitions";
    description = ''Mounts the shared program tree with system action routing.'';
    tags = [ "programs" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  syncthing._meta = {
    type = (alias nixpkgs.services.syncthing);
    zenosVersion = 1.0.0Na;
    name = "Syncthing";
    summary = "Upstream Syncthing configuration";
    description = ''Exposes the pinned NixOS Syncthing schema at the existing system.syncthing path.'';
    tags = [ "syncthing" "compatibility" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
};

desktops._meta = {
  type = (zmdl desktops);
  name = "Desktops";
  summary = "Desktop environments";
  description = ''Mounts desktop environment and window manager definitions.'';
  tags = [ "desktop" ];
  maintainers = [ $m.doromiert ];
  license = $l.napalm;
};

users = {
  _meta = {
    name = "Users";
    summary = "Per-user configuration";
    description = ''Each key identifies an independent user configuration.'';
    tags = [ "users" ];
    maintainers = [ $m.doromiert ];
    license = $l.napalm;
  };
  (freeform user) = {
    _meta = {
      name = "User";
      summary = "An individual user scope";
      description = ''Contains this user's program, package, and upstream options.'';
      tags = [ "user" ];
      maintainers = [ $m.doromiert ];
      license = $l.napalm;
    };
    packages._meta = {
      type = (packages);
      name = "User packages";
      summary = "User installation selectors";
      description = ''Selects packages for this user by their full public package path.'';
      tags = [ "packages" ];
      maintainers = [ $m.doromiert ];
      license = $l.napalm;
    };
    programs._meta = {
      type = (zmdl programs);
      name = "User programs";
      summary = "User-scoped program definitions";
      description = ''Mounts the same program tree with isolated user action routing.'';
      tags = [ "programs" ];
      maintainers = [ $m.doromiert ];
      license = $l.napalm;
    };
    legacy = {
      _meta = {
        type = (alias nixpkgs.users.users.($f.user));
        name = "User compatibility";
        summary = "Lazy NixOS user option mirror";
        description = ''Routes values to this user's upstream NixOS account options.'';
        tags = [ "compatibility" ];
        maintainers = [ $m.doromiert ];
        license = $l.napalm;
      };
      homeManager._meta = {
        type = (alias nixpkgs.home-manager.users.($f.user));
        name = "User environment compatibility";
        summary = "Lazy user environment option mirror";
        description = ''Routes values to this user's Home Manager schema without its ZenOS root.'';
        tags = [ "compatibility" ];
        maintainers = [ $m.doromiert ];
        license = $l.napalm;
      };
    };
  };
};
