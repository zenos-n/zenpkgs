      environment.systemPackages = [
        pkgs.zenos.legacy.gnomeExtensions.auto-theme-switcher
      ];
      programs.dconf.profiles.user.databases = [
        {
          settings."org/gnome/shell/extensions/auto-theme-switcher" = {
            manual-latitude = cfg.location.latitude;
            manual-longitude = cfg.location.longitude;
            location-name = cfg.location.name;
          };
        }
      ];
    })
  ];
}
