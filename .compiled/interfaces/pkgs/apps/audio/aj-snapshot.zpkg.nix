      multiline = true;
      parts = [
        {
          type = "text";
          value = "\n    Aj-snapshot is a small program that can be used to make snapshots of the connections made between JACK and/or ALSA clients.\n    Because JACK can provide both audio and MIDI support to programs, aj-snapshot can store both types of connections for JACK.\n    ALSA, on the other hand, only provides routing facilities for MIDI clients.\n    You can also run aj-snapshot in daemon mode if you want to have your connections continually restored.\n  ";
        }
