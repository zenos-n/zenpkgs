_meta = {
  zenosVersion = 1.0.0Na;
  id = "desktop.gnome.extensions.dash-to-panel";
  brief = "Combined taskbar and panel interface for GNOME Shell";
  description = ''
    Combined taskbar and panel interface for GNOME Shell

    This module installs and configures the **Dash to Panel** extension for GNOME.
    It combines the Dash and the Top Bar into a single panel, similar to
    Windows or KDE Plasma.

    **Features:**
    - Integrated taskbar and system tray.
    - Highly configurable positioning and sizing.
    - Window previews and indicators.
    - Extensive customization for transparency and styling.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

_let mkGVariantString: $type.function "string" = v: "'${v}'";
_let mkGVariantDouble: $type.function "double" = v: let s = $lib.toString v; in if $lib.hasInfix "." s then s else "${s}.0";
_let serializeMap: $type.function "map" = formatter: values:
  if values == { } then "@a{s*} {}"
  else "{${$lib.concatStringsSep ", " ($lib.mapAttrsToList (k: v: "${$v.mkGVariantString k}: ${formatter v}") values)}}";
_let serializeMapStrDouble: $type.function "map" = $v.serializeMap $v.mkGVariantDouble;
_let serializeMapStrUint: $type.function "map" = $v.serializeMap (v: "uint32 ${$lib.toString v}");
_let serializeMapStrInt: $type.function "map" = $v.serializeMap $lib.toString;

enable = enableOption {
  _meta.description = "Whether to enable Dash to Panel GNOME extension configuration.";
  s! {
    environment.systemPackages = [ $pkgs.legacy.gnomeExtensions.dash-to-panel ];
      programs.dconf.profiles.user.databases = [ {
        settings."org/gnome/shell/extensions/dash-to-panel" = {
          panel-position = $path.positioning.panel-position;
          panel-size = $path.positioning.panel-size;
          panel-lengths = $path.positioning.panel-lengths;
          panel-sizes = $path.positioning.panel-sizes;
          appicon-margin = $path.style.appicon-margin;
          appicon-padding = $path.style.appicon-padding;
          dot-position = $path.style.dot-position;
          dot-style-focused = $path.style.dot-style-focused;
          dot-style-unfocused = $path.style.dot-style-unfocused;
          trans-use-custom-opacity = $path.style.transparency.enable;
          trans-panel-opacity = $path.style.transparency.opacity;
          trans-bg-color = $path.style.transparency.color;
          trans-use-dynamic-opacity = $path.style.transparency.dynamic;
          isolate-workspaces = $path.behavior.isolate-workspaces;
          isolate-monitors = $path.behavior.isolate-monitors;
          group-apps = $path.behavior.group-apps;
          click-action = $path.behavior.click-action;
          scroll-panel-action = $path.behavior.scroll-panel-action;
          show-window-previews = $path.behavior.show-window-previews;
          intellihide = $path.intellihide.enable;
          intellihide-behaviour = $path.intellihide.behavior;
          intellihide-animation-time = $path.intellihide.animation-time;
          animate-appicon-hover = $path.animations.appicon-hover.enable;
          desktop-line-use-custom-color = false;
          animate-app-switch = true;
        } // $path.extraSettings;
      } ];
      systemd.user.services.dash-to-panel-complex-config = {
        description = "Apply Dash to Panel complex configuration";
        wantedBy = [ "graphical-session.target" ];
        partOf = [ "graphical-session.target" ];
        serviceConfig = { Type = "oneshot"; RemainAfterExit = true; };
        script = ''
          ${$pkgs.legacy.dconf}/bin/dconf write /org/gnome/shell/extensions/dash-to-panel/animate-appicon-hover-animation-convexity ${$lib.escapeShellArg ($v.serializeMapStrDouble $path.animations.appicon-hover.convexity)}
          ${$pkgs.legacy.dconf}/bin/dconf write /org/gnome/shell/extensions/dash-to-panel/animate-appicon-hover-animation-duration ${$lib.escapeShellArg ($v.serializeMapStrUint $path.animations.appicon-hover.duration)}
          ${$pkgs.legacy.dconf}/bin/dconf write /org/gnome/shell/extensions/dash-to-panel/animate-appicon-hover-animation-extent ${$lib.escapeShellArg ($v.serializeMapStrInt $path.animations.appicon-hover.extent)}
          ${$pkgs.legacy.dconf}/bin/dconf write /org/gnome/shell/extensions/dash-to-panel/animate-appicon-hover-animation-rotation ${$lib.escapeShellArg ($v.serializeMapStrInt $path.animations.appicon-hover.rotation)}
          ${$pkgs.legacy.dconf}/bin/dconf write /org/gnome/shell/extensions/dash-to-panel/animate-appicon-hover-animation-travel ${$lib.escapeShellArg ($v.serializeMapStrDouble $path.animations.appicon-hover.travel)}
          ${$pkgs.legacy.dconf}/bin/dconf write /org/gnome/shell/extensions/dash-to-panel/animate-appicon-hover-animation-zoom ${$lib.escapeShellArg ($v.serializeMapStrDouble $path.animations.appicon-hover.zoom)}
        '';
    };
  };
};

positioning.panel-position = { _meta = { type = $type.enum [ "BOTTOM" "TOP" "LEFT" "RIGHT" ]; default = "BOTTOM"; description = "Anchor edge for the consolidated panel"; }; };
positioning.panel-size = { _meta = { type = $type.int; default = 48; description = "Consolidated panel thickness in pixels"; }; };
positioning.panel-lengths = { _meta = { type = $type.string; default = "{}"; description = "Per-monitor panel lengths (JSON)"; }; };
positioning.panel-sizes = { _meta = { type = $type.string; default = "{}"; description = "Per-monitor panel thicknesses (JSON)"; }; };
style.appicon-margin = { _meta = { type = $type.int; default = 8; description = "Pixel margin around application icons"; }; };
style.appicon-padding = { _meta = { type = $type.int; default = 4; description = "Internal padding for application icons"; }; };
style.dot-position = { _meta = { type = $type.enum [ "BOTTOM" "TOP" ]; default = "BOTTOM"; description = "Placement of the active window marker"; }; };
style.dot-style-focused = { _meta = { type = $type.enum [ "METRO" "DOTS" "SQUARES" "DASHES" "SEGMENTED" "SOLID" "CILIORA" ]; default = "METRO"; description = "Visual style of the focused app marker"; }; };
style.dot-style-unfocused = { _meta = { type = $type.enum [ "METRO" "DOTS" "SQUARES" "DASHES" "SEGMENTED" "SOLID" "CILIORA" ]; default = "METRO"; description = "Visual style of unfocused app markers"; }; };
style.transparency.enable = { _meta = { type = $type.bool; default = false; description = "Enable shell theme transparency overrides"; }; };
style.transparency.opacity = { _meta = { type = $type.float; default = 0.4; description = "Fixed panel alpha transparency (0.0-1.0)"; }; };
style.transparency.color = { _meta = { type = $type.string; default = "#000000"; description = "Custom panel background color (Hex)"; }; };
style.transparency.dynamic = { _meta = { type = $type.bool; default = false; description = "Adjust opacity based on window proximity"; }; };
behavior.isolate-workspaces = { _meta = { type = $type.bool; default = false; description = "Filter items by current desktop"; }; };
behavior.isolate-monitors = { _meta = { type = $type.bool; default = false; description = "Filter items by hardware monitor"; }; };
behavior.group-apps = { _meta = { type = $type.bool; default = true; description = "Unify multiple windows under one icon"; }; };
behavior.click-action = { _meta = { type = $type.string; default = "CYCLE-MIN"; description = "Primary interaction button behavior"; }; };
behavior.scroll-panel-action = { _meta = { type = $type.string; default = "SWITCH_WORKSPACE"; description = "Mouse scroll wheel behavior on the panel"; }; };
behavior.show-window-previews = { _meta = { type = $type.bool; default = true; description = "Show live thumbnails on icon hover"; }; };
intellihide.enable = { _meta = { type = $type.bool; default = false; description = "Hide panel when obstructed by windows"; }; };
intellihide.behavior = { _meta = { type = $type.enum [ "ALL_WINDOWS" "FOCUSED_WINDOWS" "MAXIMIZED_WINDOWS" ]; default = "FOCUSED_WINDOWS"; description = "Hiding trigger policy"; }; };
intellihide.animation-time = { _meta = { type = $type.int; default = 200; description = "Visual transition time in milliseconds"; }; };
animations.appicon-hover.enable = { _meta = { type = $type.bool; default = false; description = "Enable mouse hover animations for icons"; }; };
animations.appicon-hover.convexity = { _meta = { type = $type.set [ $type.float ]; default = { RIPPLE = 2.0; PLANK = 1.0; }; description = "Deformation curvature map"; }; };
animations.appicon-hover.duration = { _meta = { type = $type.set [ $type.int ]; default = { SIMPLE = 160; RIPPLE = 130; PLANK = 100; }; description = "Animation speed map"; }; };
animations.appicon-hover.extent = { _meta = { type = $type.set [ $type.int ]; default = { RIPPLE = 4; PLANK = 4; }; description = "Animation spread map"; }; };
animations.appicon-hover.rotation = { _meta = { type = $type.set [ $type.int ]; default = { SIMPLE = 0; RIPPLE = 10; PLANK = 0; }; description = "Icon rotation map"; }; };
animations.appicon-hover.travel = { _meta = { type = $type.set [ $type.float ]; default = { SIMPLE = 0.30; RIPPLE = 0.40; PLANK = 0.0; }; description = "Translation distance map"; }; };
animations.appicon-hover.zoom = { _meta = { type = $type.set [ $type.float ]; default = { SIMPLE = 1.0; RIPPLE = 1.25; PLANK = 2.0; }; description = "Scale factor map"; }; };
extraSettings = { _meta = { type = $type.attrs; default = { }; description = "Direct schema-key overrides for dconf"; }; };
