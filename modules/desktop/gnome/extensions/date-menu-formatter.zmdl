_meta = {
  zenosVersion = 1.0.0Na;
  id = "desktop.gnome.extensions.date-menu-formatter";
  brief = "Custom date and time formatting for the GNOME top bar";
  description = ''
    Custom date and time formatting for the GNOME top bar

    This module installs and configures the **Date Menu Formatter** extension
    for GNOME. It allows customization of the date format in the top bar
    using Luxon formatting patterns.

    **Features:**
    - Custom date/time patterns.
    - Localization and time zone overrides.
    - Option to remove the messages indicator.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Whether to enable Date Menu Formatter GNOME extension configuration.";
  s! {
    environment.systemPackages = [ $pkgs.apps.gnome-extensions.date-menu-formatter ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/date-menu-formatter" = {
        formatter = $path.formatter;
        pattern = $path.pattern;
        custom-locale = $path.custom-locale;
        use-default-locale = $path.use-default-locale;
        custom-calendar = $path.custom-calendar;
        use-default-calendar = $path.use-default-calendar;
        custom-timezone = $path.custom-timezone;
        use-default-timezone = $path.use-default-timezone;
        remove-messages-indicator = $path.remove-messages-indicator;
        apply-all-panels = $path.apply-all-panels;
        font-size = $path.font-size;
        update-level = $path.update-level;
        text-align = $path.text-align;
      };
    } ];
  };
};

formatter = { _meta = { type = $type.string; default = "01_luxon"; description = ''
  Backend formatting engine

  Specifies the library used for parsing and rendering the date strings.
''; }; };
pattern = { _meta = { type = $type.string; default = "EEE, MMM d  H : mm"; description = ''
  Custom date display pattern

  Luxon-compatible formatting string (e.g., 'yyyy-MM-dd HH:mm:ss').
''; }; };
custom-locale = { _meta = { type = $type.string; default = ""; description = "Override the default system locale for date rendering"; }; };
use-default-locale = { _meta = { type = $type.bool; default = true; description = "Ignore the custom-locale setting and use system defaults"; }; };
custom-calendar = { _meta = { type = $type.string; default = ""; description = "Override the calendar system (e.g., gregorian, islamic)"; }; };
use-default-calendar = { _meta = { type = $type.bool; default = true; description = "Ignore the custom-calendar setting and use system defaults"; }; };
custom-timezone = { _meta = { type = $type.string; default = ""; description = "Display time for a specific IANA time zone identifier"; }; };
use-default-timezone = { _meta = { type = $type.bool; default = true; description = "Ignore the custom-timezone setting and use system defaults"; }; };
remove-messages-indicator = { _meta = { type = $type.bool; default = false; description = ''
  Suppress the message counter

  Whether to hide the unread message/notification indicator next
  to the clock.
''; }; };
apply-all-panels = { _meta = { type = $type.bool; default = false; description = "Modify all panels when using the Dash to Panel extension"; }; };
font-size = { _meta = { type = $type.int; default = 10; description = "Pixel font size for the panel clock label"; }; };
update-level = { _meta = { type = $type.int; default = 1; description = ''
  Clock refresh frequency

  Determines update interval (0: minute, 1: second, 2+: sub-second).
''; }; };
text-align = { _meta = { type = $type.enum [ "left" "center" "right" ]; default = "center"; description = "Horizontal alignment of the date label within its panel slot"; }; };
