_meta = {
  zenosVersion = 1.0.0Na;
  id = "desktop.gnome.extensions.copyous";
  brief = "Advanced clipboard manager with rich UI and media support";
  description = ''
    Advanced clipboard manager with rich UI and media support

    This module installs and configures the **Copyous** extension for GNOME.
    It is a feature-rich clipboard manager with support for text and images,
    offering extensive customization for its UI, behavior, and keyboard shortcuts.

    **Features:**
    - Clipboard history management.
    - Customizable UI (orientation, position, size).
    - Theming support.
    - Extensive keyboard shortcuts.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Whether to enable Copyous GNOME extension configuration.";
  s! {
    environment.systemPackages = [ $pkgs.legacy.gnomeExtensions.copyous ];
    programs.dconf.profiles.user.databases = [ {
      settings = {
        "org/gnome/shell/extensions/copyous" = {
          clipboard-size = $path.general.clipboard-size;
          clear-history = $path.general.clear-history;
          process-primary-selection = $path.general.process-primary-selection;
          toggle-menu = $path.shortcuts.toggle-menu;
        };
        "org/gnome/shell/extensions/copyous/paste" = {
          paste-on-select = $path.paste.on-select;
          paste-button-click-action = $path.paste.button-action;
        };
        "org/gnome/shell/extensions/copyous/ui" = {
          orientation = $path.ui.orientation;
          position = $path.ui.position;
          header-controls-visibility = $path.ui.header-visibility;
          window-width-percentage = $path.ui.window-width-percentage;
          window-height-percentage = $path.ui.window-height-percentage;
          item-height = $path.ui.item-height;
          show-item-type-icon = $path.ui.show-type-icon;
          show-item-text = $path.ui.show-text;
        };
        "org/gnome/shell/extensions/copyous/shortcuts" = {
          move-next = $path.shortcuts.move-next;
          move-previous = $path.shortcuts.move-previous;
          select = $path.shortcuts.select;
          delete = $path.shortcuts.delete;
          pin = $path.shortcuts.pin;
          cycle-view = $path.shortcuts.cycle-view;
          search = $path.shortcuts.search;
        };
        "org/gnome/shell/extensions/copyous/character-item" = {
          max-characters = $path.character-item.max-characters;
          show-unicode = $path.character-item.show-unicode;
        };
        "org/gnome/shell/extensions/copyous/theme" = {
          theme = $path.theme.mode;
          custom-color-scheme = $path.theme.custom.scheme;
          custom-bg-color = $path.theme.custom.background-color;
          custom-fg-color = $path.theme.custom.foreground-color;
        };
      };
    } ];
  };
};

general.clipboard-size = { _meta = { type = $type.int; default = 30; description = ''
  Maximum clipboard history size

  Specifies the number of entries to retain in the history buffer.
''; }; };
general.clear-history = { _meta = { type = $type.enum [ "clear" "keep-pinned-and-tagged" "keep-all" ]; default = "clear"; description = ''
  Clipboard clearing behavior

  Determines which items are preserved when the history is cleared.
''; }; };
general.process-primary-selection = { _meta = { type = $type.bool; default = false; description = ''
  Record primary selection (Middle Click paste)

  Whether to capture text selected by highlighting as a clipboard entry.
''; }; };
paste.on-select = { _meta = { type = $type.bool; default = true; description = ''
  Immediate paste upon selection

  Automatically inserts the clipboard content when an item is
  selected from the menu.
''; }; };
paste.button-action = { _meta = { type = $type.enum [ "select" "copy" ]; default = "select"; description = ''
  Secondary button click behavior

  Action performed when clicking the secondary interaction button on
  an item.
''; }; };
ui.orientation = { _meta = { type = $type.enum [ "horizontal" "vertical" ]; default = "vertical"; description = "Visual orientation of the clipboard menu"; }; };
ui.position = { _meta = { type = $type.enum [ "top" "center" "bottom" "fill" ]; default = "center"; description = "Screen position of the floating clipboard window"; }; };
ui.header-visibility = { _meta = { type = $type.enum [ "visible" "visible-on-hover" "hidden" ]; default = "visible-on-hover"; description = "Visibility mode for window header controls"; }; };
ui.window-width-percentage = { _meta = { type = $type.int; default = 25; description = "Width of the clipboard window as a percentage of screen width"; }; };
ui.window-height-percentage = { _meta = { type = $type.int; default = 50; description = "Height of the clipboard window as a percentage of screen height"; }; };
ui.item-height = { _meta = { type = $type.int; default = 90; description = "Fixed vertical height for each clipboard list item"; }; };
ui.show-type-icon = { _meta = { type = $type.bool; default = true; description = "Display icons indicating the data type (text, image, etc.)"; }; };
ui.show-text = { _meta = { type = $type.bool; default = true; description = "Display the text content or filename of the clipboard entry"; }; };
character-item.max-characters = { _meta = { type = $type.int; default = 1; description = "Threshold for recognizing an entry as a standalone character"; }; };
character-item.show-unicode = { _meta = { type = $type.bool; default = false; description = "Display the Unicode codepoint for single-character items"; }; };
theme.mode = { _meta = { type = $type.enum [ "system" "dark" "light" "custom" ]; default = "system"; description = "Extension color theme mode"; }; };
theme.custom.scheme = { _meta = { type = $type.enum [ "dark" "light" ]; default = "dark"; description = "Base color scheme for custom theming"; }; };
theme.custom.background-color = { _meta = { type = $type.string; default = ""; description = "Custom CSS color for the window background"; }; };
theme.custom.foreground-color = { _meta = { type = $type.string; default = ""; description = "Custom CSS color for the text and icons"; }; };
shortcuts.toggle-menu = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super><Shift>v" ]; description = "Keyboard shortcut to show/hide the clipboard window"; }; };
shortcuts.move-next = { _meta = { type = $type.list [ $type.string ]; default = [ "Down" ]; description = "Navigation key to move to the next item"; }; };
shortcuts.move-previous = { _meta = { type = $type.list [ $type.string ]; default = [ "Up" ]; description = "Navigation key to move to the previous item"; }; };
shortcuts.select = { _meta = { type = $type.list [ $type.string ]; default = [ "Return" "KP_Enter" ]; description = "Shortcut to select and/or paste the focused item"; }; };
shortcuts.delete = { _meta = { type = $type.list [ $type.string ]; default = [ "Delete" ]; description = "Shortcut to remove the focused item from history"; }; };
shortcuts.pin = { _meta = { type = $type.list [ $type.string ]; default = [ "p" ]; description = "Shortcut to toggle the pinned status of an item"; }; };
shortcuts.cycle-view = { _meta = { type = $type.list [ $type.string ]; default = [ "Tab" ]; description = "Shortcut to cycle through different history filters"; }; };
shortcuts.search = { _meta = { type = $type.list [ $type.string ]; default = [ "slash" ]; description = "Shortcut to focus the history search bar"; }; };
