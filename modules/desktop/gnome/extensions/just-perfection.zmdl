_meta = {
  zenosVersion = 1.0.0Na;
  id = "desktop.gnome.extensions.just-perfection";
  brief = "Universal GNOME Shell customization utility";
  description = ''
    Universal GNOME Shell customization utility

    This module installs and configures the **Just Perfection** extension for GNOME.
    It is a comprehensive "all-in-one" utility to customize GNOME Shell, allowing you to
    tweak visibility of UI elements, adjust panel sizes, and change core behaviors.

    **Features:**
    - Extensive visibility controls for almost every shell element.
    - Behavior tweaks (window focus, workspace wrapping).
    - Positioning and sizing customizations.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Just Perfection GNOME extension configuration";
  s! {
    environment.systemPackages = [ $pkgs.legacy.gnomeExtensions.just-perfection ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/just-perfection" = {
        panel = $path.visibility.panel;
        background-menu = $path.visibility.background-menu;
        search = $path.visibility.search;
        workspace = $path.visibility.workspace;
        dash = $path.visibility.dash;
        osd = $path.visibility.osd;
        theme = $path.visibility.theme;
        calendar = $path.visibility.calendar;
        events-button = $path.visibility.events-button;
        screen-sharing-indicator = $path.visibility.screen-sharing-indicator;
        screen-recording-indicator = $path.visibility.screen-recording-indicator;
        world-clock = $path.visibility.world-clock;
        weather = $path.visibility.weather;
        panel-in-overview = $path.visibility.panel-in-overview;
        workspace-popup = $path.visibility.workspace-popup;
        activities-button = $path.visibility.activities-button;
        clock-menu = $path.visibility.clock-menu;
        panel-notification-icon = $path.visibility.panel-notification-icon;
        keyboard-layout = $path.visibility.keyboard-layout;
        accessibility-menu = $path.visibility.accessibility-menu;
        quick-settings = $path.visibility.quick-settings;
        power-icon = $path.visibility.power-icon;
        window-picker-icon = $path.visibility.window-picker-icon;
        show-apps-button = $path.visibility.show-apps-button;
        workspaces-in-app-grid = $path.visibility.workspaces-in-app-grid;
        workspace-switcher-should-show = $path.behavior.workspace-switcher-always-show;
        window-preview-caption = $path.visibility.window-preview-caption;
        window-preview-close-button = $path.visibility.window-preview-close-button;
        ripple-box = $path.visibility.ripple-box;
        dash-separator = $path.visibility.dash-separator;
        window-menu = $path.visibility.window-menu;
        window-menu-take-screenshot-button = $path.visibility.window-menu-take-screenshot-button;
        dash-app-running = $path.visibility.dash-app-running;
        quick-settings-dark-mode = $path.quick-settings.dark-mode;
        quick-settings-night-light = $path.quick-settings.night-light;
        quick-settings-do-not-disturb = $path.quick-settings.do-not-disturb;
        quick-settings-backlight = $path.quick-settings.backlight;
        quick-settings-airplane-mode = $path.quick-settings.airplane-mode;
        type-to-search = $path.behavior.type-to-search;
        window-demands-attention-focus = $path.behavior.window-demands-attention-focus;
        window-maximized-on-create = $path.behavior.window-maximized-on-create;
        workspace-wrap-around = $path.behavior.workspace-wrap-around;
        double-super-to-appgrid = $path.behavior.double-super-to-appgrid;
        overlay-key = $path.behavior.overlay-key;
        switcher-popup-delay = $path.behavior.switcher-popup-delay;
        workspace-peek = $path.behavior.workspace-peek;
        accent-color-icon = $path.behavior.accent-color-icon;
        workspace-thumbnail-to-main-view = $path.behavior.workspace-thumbnail-to-main-view;
        invert-calendar-column-items = $path.behavior.invert-calendar-column-items;
        panel-corner-size = $path.appearance.panel-corner-size;
        workspace-switcher-size = $path.appearance.workspace-switcher-size;
        dash-icon-size = $path.appearance.dash-icon-size;
        panel-size = $path.appearance.panel-size;
        panel-button-padding-size = $path.appearance.panel-button-padding-size;
        panel-indicator-padding-size = $path.appearance.panel-indicator-padding-size;
        workspace-background-corner-size = $path.appearance.workspace-background-corner-size;
        panel-icon-size = $path.appearance.panel-icon-size;
        looking-glass-width = $path.appearance.looking-glass-width;
        looking-glass-height = $path.appearance.looking-glass-height;
        alt-tab-window-preview-size = $path.appearance.alt-tab-window-preview-size;
        alt-tab-small-icon-size = $path.appearance.alt-tab-small-icon-size;
        alt-tab-icon-size = $path.appearance.alt-tab-icon-size;
        controls-manager-spacing-size = $path.appearance.controls-manager-spacing-size;
        max-displayed-search-results = $path.appearance.max-displayed-search-results;
        top-panel-position = $path.positioning.top-panel-position;
        clock-menu-position = $path.positioning.clock-menu-position;
        clock-menu-position-offset = $path.positioning.clock-menu-position-offset;
        notification-banner-position = $path.positioning.notification-banner-position;
        osd-position = $path.positioning.osd-position;
        animation = $path.general.animation;
        startup-status = $path.general.startup-status;
        support-notifier-type = $path.general.support-notifier-type;
        support-notifier-showed-version = $path.general.support-notifier-showed-version;
      };
    } ];
  };
};

visibility.panel = { _meta = { type = $type.bool; default = true; description = "Master visibility switch for the top panel"; }; };
visibility.panel-in-overview = { _meta = { type = $type.bool; default = false; description = "Toggle panel visibility while in the activities overview"; }; };
visibility.dash = { _meta = { type = $type.bool; default = true; description = "Master visibility switch for the GNOME dash"; }; };
visibility.dash-separator = { _meta = { type = $type.bool; default = true; description = "Show or hide the separator between favorites and running apps"; }; };
visibility.dash-app-running = { _meta = { type = $type.bool; default = true; description = "Toggle visibility of the dots under running applications"; }; };
visibility.search = { _meta = { type = $type.bool; default = true; description = "Toggle visibility of the search box in overview"; }; };
visibility.workspace = { _meta = { type = $type.bool; default = true; description = "Master visibility for the workspace switcher"; }; };
visibility.workspace-popup = { _meta = { type = $type.bool; default = true; description = "Toggle the workspace indicator popup on desktop switch"; }; };
visibility.workspaces-in-app-grid = { _meta = { type = $type.bool; default = true; description = "Show or hide workspace thumbnails in the application grid"; }; };
visibility.background-menu = { _meta = { type = $type.bool; default = true; description = "Toggle the desktop right-click background menu"; }; };
visibility.osd = { _meta = { type = $type.bool; default = true; description = "Toggle On-Screen Display (Volume, Brightness popups)"; }; };
visibility.activities-button = { _meta = { type = $type.bool; default = true; description = "Show or hide the 'Activities' label button"; }; };
visibility.clock-menu = { _meta = { type = $type.bool; default = true; description = "Toggle the central clock and date menu"; }; };
visibility.keyboard-layout = { _meta = { type = $type.bool; default = true; description = "Toggle the input source/keyboard layout panel menu"; }; };
visibility.accessibility-menu = { _meta = { type = $type.bool; default = true; description = "Toggle the accessibility features panel menu"; }; };
visibility.power-icon = { _meta = { type = $type.bool; default = true; description = "Toggle the system status and power icon"; }; };
visibility.panel-notification-icon = { _meta = { type = $type.bool; default = true; description = "Toggle the notifications indicator in the panel"; }; };
visibility.window-picker-icon = { _meta = { type = $type.bool; default = true; description = "Toggle icons on window previews in overview"; }; };
visibility.show-apps-button = { _meta = { type = $type.bool; default = true; description = "Toggle the 'Show Applications' grid button"; }; };
visibility.theme = { _meta = { type = $type.bool; default = false; description = "Enable advanced theme override visibility"; }; };
visibility.quick-settings = { _meta = { type = $type.bool; default = true; description = "Toggle the entire GNOME Quick Settings menu"; }; };
visibility.world-clock = { _meta = { type = $type.bool; default = true; description = "Toggle world clock visibility in the date menu"; }; };
visibility.weather = { _meta = { type = $type.bool; default = true; description = "Toggle weather info visibility in the date menu"; }; };
visibility.calendar = { _meta = { type = $type.bool; default = true; description = "Toggle the calendar view in the date menu"; }; };
visibility.events-button = { _meta = { type = $type.bool; default = true; description = "Toggle the events section in the date menu"; }; };
visibility.ripple-box = { _meta = { type = $type.bool; default = true; description = "Toggle the visual ripple effect when hitting hot corners"; }; };
visibility.window-menu = { _meta = { type = $type.bool; default = true; description = "Toggle the right-click menu on window titlebars"; }; };
visibility.window-menu-take-screenshot-button = { _meta = { type = $type.bool; default = true; description = "Toggle the screenshot button within the window menu"; }; };
visibility.window-preview-caption = { _meta = { type = $type.bool; default = true; description = "Toggle application names on window previews"; }; };
visibility.window-preview-close-button = { _meta = { type = $type.bool; default = true; description = "Toggle close buttons on window previews"; }; };
visibility.screen-sharing-indicator = { _meta = { type = $type.bool; default = true; description = "Toggle visibility of the screen sharing status icon"; }; };
visibility.screen-recording-indicator = { _meta = { type = $type.bool; default = true; description = "Toggle visibility of the screen recording status icon"; }; };

quick-settings.dark-mode = { _meta = { type = $type.bool; default = true; description = "Toggle Dark Mode switch visibility"; }; };
quick-settings.night-light = { _meta = { type = $type.bool; default = true; description = "Toggle Night Light switch visibility"; }; };
quick-settings.do-not-disturb = { _meta = { type = $type.bool; default = true; description = "Toggle Do Not Disturb switch visibility"; }; };
quick-settings.backlight = { _meta = { type = $type.bool; default = true; description = "Toggle display brightness slider visibility"; }; };
quick-settings.airplane-mode = { _meta = { type = $type.bool; default = true; description = "Toggle Airplane Mode switch visibility"; }; };

behavior.workspace-switcher-always-show = { _meta = { type = $type.bool; default = false; description = "Force persistent visibility of the workspace list"; }; };
behavior.workspace-wrap-around = { _meta = { type = $type.bool; default = false; description = "Allow workspace switching to loop from last to first"; }; };
behavior.workspace-peek = { _meta = { type = $type.bool; default = true; description = "Enable horizontal workspace peeking in overview"; }; };
behavior.workspace-thumbnail-to-main-view = { _meta = { type = $type.bool; default = false; description = "Switch to main view immediately on thumbnail click"; }; };
behavior.window-demands-attention-focus = { _meta = { type = $type.bool; default = false; description = "Automatically focus windows requesting user attention"; }; };
behavior.window-maximized-on-create = { _meta = { type = $type.bool; default = false; description = "Automatically maximize newly opened application windows"; }; };
behavior.type-to-search = { _meta = { type = $type.bool; default = true; description = "Enable immediate search indexing on overview keystrokes"; }; };
behavior.double-super-to-appgrid = { _meta = { type = $type.bool; default = true; description = "Toggle app grid on double Super key press"; }; };
behavior.overlay-key = { _meta = { type = $type.bool; default = true; description = "Use the Super key as the primary overview shortcut"; }; };
behavior.switcher-popup-delay = { _meta = { type = $type.bool; default = true; description = "Enable or disable delays for Alt-Tab popups"; }; };
behavior.invert-calendar-column-items = { _meta = { type = $type.bool; default = false; description = "Invert the sorting order of calendar columns"; }; };

appearance.accent-color-icon = { _meta = { type = $type.bool; default = false; description = "Apply system accent color to shell icons"; }; };
appearance.panel-size = { _meta = { type = $type.int; default = 0; description = "Custom vertical height for the top bar (0 for default)"; }; };
appearance.panel-icon-size = { _meta = { type = $type.int; default = 0; description = "Custom pixel size for panel icons (0 for default)"; }; };
appearance.panel-button-padding-size = { _meta = { type = $type.int; default = 0; description = "Custom horizontal padding for panel buttons"; }; };
appearance.panel-indicator-padding-size = { _meta = { type = $type.int; default = 0; description = "Custom horizontal padding for panel indicators"; }; };
appearance.panel-corner-size = { _meta = { type = $type.int; default = 0; description = "Custom corner radius for the top bar"; }; };
appearance.dash-icon-size = { _meta = { type = $type.int; default = 0; description = "Custom pixel size for dash icons (0 for default)"; }; };
appearance.workspace-switcher-size = { _meta = { type = $type.int; default = 0; description = "Width percentage for the workspace switcher (0 for default)"; }; };
appearance.workspace-background-corner-size = { _meta = { type = $type.int; default = 0; description = "Corner radius for workspace background containers"; }; };
appearance.looking-glass-width = { _meta = { type = $type.int; default = 0; description = "Width percentage for the Looking Glass debug tool"; }; };
appearance.looking-glass-height = { _meta = { type = $type.int; default = 0; description = "Height percentage for the Looking Glass debug tool"; }; };
appearance.alt-tab-window-preview-size = { _meta = { type = $type.int; default = 0; description = "Custom size for Alt-Tab window previews"; }; };
appearance.alt-tab-icon-size = { _meta = { type = $type.int; default = 0; description = "Custom size for Alt-Tab application icons"; }; };
appearance.alt-tab-small-icon-size = { _meta = { type = $type.int; default = 0; description = "Custom size for Alt-Tab secondary icons"; }; };
appearance.controls-manager-spacing-size = { _meta = { type = $type.int; default = 0; description = "Custom spacing for internal controls containers"; }; };
appearance.max-displayed-search-results = { _meta = { type = $type.int; default = 0; description = "Cap the number of search results shown in overview"; }; };

positioning.top-panel-position = { _meta = { type = $type.int; default = 0; description = "Anchor position for the main panel (0: Top, 1: Bottom)"; }; };
positioning.clock-menu-position = { _meta = { type = $type.int; default = 0; description = "Panel alignment for the clock (0: Center, 1: Right, 2: Left)"; }; };
positioning.clock-menu-position-offset = { _meta = { type = $type.int; default = 0; description = "Numerical offset for clock positioning"; }; };
positioning.notification-banner-position = { _meta = { type = $type.int; default = 1; description = "Display corner for notification banners (0-5)"; }; };
positioning.osd-position = { _meta = { type = $type.int; default = 0; description = "Anchor location for system popups (0-9)"; }; };

general.startup-status = { _meta = { type = $type.int; default = 1; description = "Initial state after login (0: Desktop, 1: Overview)"; }; };
general.animation = { _meta = { type = $type.int; default = 1; description = "Global animation speed scaling (0: Disabled, 1: Default)"; }; };
general.support-notifier-type = { _meta = { type = $type.int; default = 1; description = "Frequency of extension update notifications"; }; };
general.support-notifier-showed-version = { _meta = { type = $type.int; default = 0; description = "Internal tracker for last notified version"; }; };
