_meta = {
  zenosVersion = 1.0.0Na;
  id = "desktop.gnome.extensions.caffeine";
  brief = "Manual and automatic screensaver inhibition for GNOME";
  description = ''
    Manual and automatic screensaver inhibition for GNOME

    This module installs and configures the **Caffeine** extension for GNOME.
    It allows users to temporarily disable the screensaver and auto-suspend modes.

    **Features:**
    - Quick settings toggle.
    - Automatic activation for fullscreen apps or specific running applications.
    - Configurable timer and duration settings.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Whether to enable Caffeine GNOME extension configuration.";
  s! {
    environment.systemPackages = [ $pkgs.legacy.gnomeExtensions.caffeine ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/caffeine" = {
        inhibit-apps = $path.inhibit-apps;
        user-enabled = $path.user-enabled;
        duration-timer-list = $path.duration-timer-list;
        use-custom-duration = $path.use-custom-duration;
        countdown-timer = $path.countdown-timer;
        duration-timer = $path.duration-timer;
        restore-state = $path.restore-state;
        show-indicator = $path.show-indicator;
        show-notifications = $path.show-notifications;
        show-timer = $path.show-timer;
        show-toggle = $path.show-toggle;
        enable-fullscreen = $path.enable-fullscreen;
        enable-mpris = $path.enable-mpris;
        nightlight-control = $path.nightlight-control;
        screen-blank = $path.screen-blank;
        trigger-apps-mode = $path.trigger-apps-mode;
        toggle-shortcut = $path.toggle-shortcut;
        prefs-default-width = $path.prefs-default-width;
        prefs-default-height = $path.prefs-default-height;
        indicator-position = $path.indicator-position;
        indicator-position-index = $path.indicator-position-index;
        indicator-position-max = $path.indicator-position-max;
        cli-toggle = $path.cli-toggle;
      };
    } ];
  };
};

inhibit-apps = { _meta = { type = $type.list [ $type.string ]; default = [ ]; description = ''
  Auto-inhibit application list

  List of applications (desktop file IDs) that trigger caffeine when running.
''; }; };
user-enabled = { _meta = { type = $type.bool; default = false; description = ''
  Manual toggle state persistence

  Whether caffeine should remember its enabled state across sessions.
''; }; };
duration-timer-list = { _meta = { type = $type.list [ $type.int ]; default = [ 900 1800 3600 ]; description = ''
  Available timer duration intervals

  List of possible timer values in seconds for the dropdown menu.
''; }; };
use-custom-duration = { _meta = { type = $type.bool; default = false; description = ''
  Enable custom duration timer

  Whether to use custom user-defined values for the inhibition timer.
''; }; };
countdown-timer = { _meta = { type = $type.int; default = 0; description = ''
  Active countdown remaining time

  Internal timer state representing seconds remaining until inhibition ends.
''; }; };
duration-timer = { _meta = { type = $type.int; default = 2; description = ''
  Default timer duration index

  The default index from the duration list used when starting a timer.
''; }; };
restore-state = { _meta = { type = $type.bool; default = false; description = ''
  Restore inhibition state on startup

  Whether to automatically re-enable caffeine if it was active on shutdown.
''; }; };
show-indicator = { _meta = { type = $type.string; default = "only-active"; description = ''
  Indicator visibility mode

  Controls the top bar icon visibility: 'only-active', 'always', or 'never'.
''; }; };
show-notifications = { _meta = { type = $type.bool; default = true; description = ''
  Display status notifications

  Whether to show desktop notifications when caffeine is toggled.
''; }; };
show-timer = { _meta = { type = $type.bool; default = true; description = ''
  Display countdown in top bar

  Whether to show the remaining inhibition time next to the icon.
''; }; };
show-toggle = { _meta = { type = $type.bool; default = true; description = ''
  Enable quick settings toggle

  Whether the toggle switch appears in the GNOME Quick Settings menu.
''; }; };
enable-fullscreen = { _meta = { type = $type.bool; default = true; description = ''
  Auto-inhibit on fullscreen apps

  Enable caffeine automatically when any application enters fullscreen mode.
''; }; };
enable-mpris = { _meta = { type = $type.bool; default = false; description = ''
  Auto-inhibit on media playback

  Enable caffeine automatically when an MPRIS-compatible media player is active.
''; }; };
nightlight-control = { _meta = { type = $type.string; default = "never"; description = ''
  Inhibit GNOME Night Light

  Mode for suppressing Night Light: 'never', 'always', or 'for-apps'.
''; }; };
screen-blank = { _meta = { type = $type.string; default = "never"; description = ''
  Allow screen blanking while active

  Mode for allowing the screen to turn off: 'never', 'always', or 'for-apps'.
''; }; };
trigger-apps-mode = { _meta = { type = $type.string; default = "on-running"; description = ''
  Application trigger logic

  Criteria for app-based inhibition: 'on-running', 'on-focus', 'on-active-workspace'.
''; }; };
toggle-shortcut = { _meta = { type = $type.list [ $type.string ]; default = [ ]; description = ''
  Keyboard shortcut to toggle state

  List of key combination strings used to manually enable/disable caffeine.
''; }; };
prefs-default-width = { _meta = { type = $type.int; default = 570; description = "Default width for the preferences window interface"; }; };
prefs-default-height = { _meta = { type = $type.int; default = 590; description = "Default height for the preferences window interface"; }; };
indicator-position = { _meta = { type = $type.int; default = 0; description = "Visual offset for the status icon in the panel"; }; };
indicator-position-index = { _meta = { type = $type.int; default = 0; description = "Logical sorting index for the status icon"; }; };
indicator-position-max = { _meta = { type = $type.int; default = 1; description = "Maximum index for icon positioning in the indicator menu"; }; };
cli-toggle = { _meta = { type = $type.bool; default = false; description = "Allow toggling caffeine via command line signals"; }; };
