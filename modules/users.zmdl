_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Enhanced user management for ZenOS";
  description = ''
    Provides a unified system-side bridge for user and Home Manager configuration.

    User package selectors are resolved against filesystem-derived pkgs.zenos paths
    by the structure runtime rather than by this module.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

(freeform user) = {
  _meta.summary = "Configuration for user ${$f.user}";

  groups = {
    _meta = {
      type = $type.list [ $type.string ];
      default = [ ];
      summary = "Additional groups for this user";
    };
  };

  keys = {
    _meta = {
      type = $type.list [ $type.string ];
      default = [ ];
      summary = "Authorized SSH public keys for this user";
    };
  };

  shell = {
    _meta = {
      type = $type.either [ $type.null $type.package ];
      default = null;
      summary = "Login shell for this user";
    };
  };

  s!! {
    users.users.($f.user) =
      ($path.($f.user).legacy or { })
      // {
        extraGroups = ($path.($f.user).legacy.extraGroups or [ ])
          ++ $path.($f.user).groups;
        openssh.authorizedKeys.keys =
          ($path.($f.user).legacy.openssh.authorizedKeys.keys or [ ])
          ++ $path.($f.user).keys;
      }
      // (if $path.($f.user).shell != null then {
        shell = $path.($f.user).shell;
      } else { });
    home-manager.users.($f.user) = {
      home = $path.($f.user).home or { };
      xdg = $path.($f.user).xdg or { };
      programs = $path.($f.user).programs or { };
      services = $path.($f.user).services or { };
      dconf = $path.($f.user).dconf or { };
      gtk = $path.($f.user).gtk or { };
      qt = $path.($f.user).qt or { };
      systemd = $path.($f.user).systemd or { };
      wayland = $path.($f.user).wayland or { };
    };
  };
};
