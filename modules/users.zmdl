_meta = {
  zenosVersion = 1.0.0Na;
  name = "User accounts";
  summary = "Account profiles for managed users";
  description = ''Declares account settings alongside session preferences in the unified user tree.'';
  tags = [ "users" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

(freeform user) = {
  _meta = {
    name = "User ${$f.user}";
    summary = "Account and personal settings";
    description = ''Settings belonging to user ${$f.user}.'';
    tags = [ "users" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  profile._meta = {
    name = "Account profile";
    summary = "Login account and identity";
    description = ''Account choices apply only to this user. Unset choices preserve the existing account policy.'';
    tags = [ "users" "profile" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };

  profile.normalUser = {
    _meta = {
      name = "Create a regular login account";
      summary = "Create a regular login account";
      description = ''Create a regular login account. True creates a normal user; false does not implicitly select a system account. Existing accounts may leave this unset. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.boolean) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).isNormalUser = $lib.mkIf ($path.($f.user).profile.normalUser != null) ($path.($f.user).profile.normalUser);
    };
  };

  profile.displayName = {
    _meta = {
      name = "Name shown on the login screen";
      summary = "Name shown on the login screen";
      description = ''Name shown on the login screen. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.string) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).description = $lib.mkIf ($path.($f.user).profile.displayName != null) ($path.($f.user).profile.displayName);
    };
  };

  profile.homeDirectory = {
    _meta = {
      name = "Absolute path to the home directory";
      summary = "Absolute path to the home directory";
      description = ''Absolute path to the home directory. Must be absolute. Changing this path does not migrate existing files. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.string) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).home = $lib.mkIf ($path.($f.user).profile.homeDirectory != null) ($path.($f.user).profile.homeDirectory);
    };
  };

  profile.uid = {
    _meta = {
      name = "Stable numeric user identifier";
      summary = "Stable numeric user identifier";
      description = ''Stable numeric user identifier. Must be between 0 and 4294967294. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.int) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).uid = $lib.mkIf ($path.($f.user).profile.uid != null) ($path.($f.user).profile.uid);
    };
  };

  profile.groups = {
    _meta = {
      name = "Additional group memberships";
      summary = "Additional group memberships";
      description = ''Additional group memberships. Uses normal additive group-list merging; an empty list adds no groups. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.list [ $type.string ]) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).extraGroups = $lib.mkIf ($path.($f.user).profile.groups != null) ($path.($f.user).profile.groups);
    };
  };

  profile.sshKeys = {
    _meta = {
      name = "Authorized SSH public keys";
      summary = "Authorized SSH public keys";
      description = ''Authorized SSH public keys. Public keys only; uses normal additive list merging. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.list [ $type.string ]) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).openssh.authorizedKeys.keys = $lib.mkIf ($path.($f.user).profile.sshKeys != null) ($path.($f.user).profile.sshKeys);
    };
  };

  profile.passwordHashFile = {
    _meta = {
      name = "Runtime file containing the password hash";
      summary = "Runtime file containing the password hash";
      description = ''Runtime file containing the password hash. An absolute runtime path, never a plaintext password or store-imported secret. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.string) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).hashedPasswordFile = $lib.mkIf ($path.($f.user).profile.passwordHashFile != null) ($path.($f.user).profile.passwordHashFile);
    };
  };

  profile.linger = {
    _meta = {
      name = "Keep user services running after logout";
      summary = "Keep user services running after logout";
      description = ''Keep user services running after logout. Null leaves this preference unchanged.'';
      tags = [ "users" "profile" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.boolean) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).linger = $lib.mkIf ($path.($f.user).profile.linger != null) ($path.($f.user).profile.linger);
    };
  };

  s!! {
    assertions = [
      { assertion = $path.($f.user).profile.uid == null || ($path.($f.user).profile.uid >= 0 && $path.($f.user).profile.uid <= 4294967294); message = "UID must be between 0 and 4294967294."; }
      { assertion = $path.($f.user).profile.homeDirectory == null || ($lib.hasPrefix "/" $path.($f.user).profile.homeDirectory); message = "homeDirectory must be an absolute path."; }
      { assertion = $path.($f.user).profile.passwordHashFile == null || ($lib.hasPrefix "/" $path.($f.user).profile.passwordHashFile); message = "passwordHashFile must be an absolute path."; }
    ];
  };

  profile.loginShell = {
    _meta = {
      name = "Login shell package";
      summary = "Login shell package";
      description = ''Login shell package. The selected shell must be supported and enabled by the system. This does not enable a system-wide shell service. Null leaves this preference unchanged.'';
      tags = [ "users" "shell" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
      type = $type.either [ ($type.package) $type.null ];
      default = null;
    };
    s!! {
      users.users.($f.user).shell = $lib.mkIf ($path.($f.user).profile.loginShell != null) ($path.($f.user).profile.loginShell);
    };
  };

  # Optional account-scoped VR runtime requirements.
  s!! {

    programs.steam.enable = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault true);
    programs.steam.extraCompatPackages = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ([ $pkgs.apps.gaming.proton-ge-bin ]);
    programs.steam.extraPackages = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ([ $pkgs.libs.libice $pkgs.libs.libsm ]);
    programs.alvr.enable = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault true);
    programs.alvr.package = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault $pkgs.apps.gaming.alvr-zenos-compat);
    programs.alvr.openFirewall = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault ($lib.any (u: (u.services.vr.enable or false) && (u.services.vr.allowNetworkAccess or false)) ($lib.attrValues $cfg.users)));
    hardware.steam-hardware.enable = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault true);
    hardware.graphics.enable = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault true);
    hardware.graphics.enable32Bit = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault true);
    security.rtkit.enable = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault true);
    programs.gamemode.enable = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault true);
    boot.kernel.sysctl."vm.max_map_count" = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) ($lib.mkDefault 2147483642);
    security.pam.loginLimits = $lib.mkIf ($cfg.users.($f.user).services.vr.enable or false) [
      { domain = $f.user; type = "hard"; item = "nofile"; value = "524288"; }
      { domain = $f.user; type = "-"; item = "rtprio"; value = "95"; }
      { domain = $f.user; type = "-"; item = "nice"; value = "-19"; }
    ];
    };

  s!! {
    environment.systemPackages = $lib.mkIf ($cfg.users.($f.user).services.zbridge.enable or false) [ $pkgs.apps.development.android-tools ];
  };
  s!! {
    services.udev.packages = $lib.mkIf ($cfg.users.($f.user).services.haptics.enable or false) [ $pkgs.apps.accessibility.hapticspp ];
  };
};
