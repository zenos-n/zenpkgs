_let preferences: $type.set = $lib.filterAttrs (_: value: value != null) {
  "remember-window-size" = if $path.rememberWindowSize == null then null else $path.rememberWindowSize;
  "font" = if $path.font == null then null else $path.font;
  "pretty" = if $path.themeWindow == null then null else $path.themeWindow;
  "opacity" = if $path.opacity == null then null else $lib.gvariant.mkUint32 $path.opacity;
  "fill-tabs" = if $path.expandTabs == null then null else $path.expandTabs;
  "tab-switching-order" = if $path.tabSwitchingOrder == null then null else $lib.gvariant.mkUint32 ($lib.getAttr $path.tabSwitchingOrder {
    position = 0;
    recent = 1;
  });
  "show-headerbar" = if $path.showHeaderBar == null then null else $path.showHeaderBar;
  "context-aware-header-bar" = if $path.contextAwareHeaderBar == null then null else $path.contextAwareHeaderBar;
  "show-menu-button" = if $path.showMenuButton == null then null else $path.showMenuButton;
  "headerbar-drag-area" = if $path.headerBarDragArea == null then null else $path.headerBarDragArea;
  "show-scrollbars" = if $path.showScrollbars == null then null else $path.showScrollbars;
  "use-overlay-scrolling" = if $path.useOverlayScrolling == null then null else $path.useOverlayScrolling;
  "pixel-scrolling" = if $path.pixelScrolling == null then null else $path.pixelScrolling;
  "use-sixel" = if $path.sixel == null then null else $path.sixel;
  "scrollback-mode" = if $path.scrollbackMode == null then null else $lib.gvariant.mkUint32 ($lib.getAttr $path.scrollbackMode {
      fixed = 0;
      unlimited = 1;
      disabled = 2;
    });
  "scrollback-lines" = if $path.scrollbackLines == null then null else $lib.gvariant.mkUint32 $path.scrollbackLines;
  "floating-controls" = if $path.floatingControls == null then null else $path.floatingControls;
  "floating-controls-hover-area" = if $path.floatingControlsHoverArea == null then null else $lib.gvariant.mkUint32 $path.floatingControlsHoverArea;
  "delay-before-showing-floating-controls" = if $path.floatingControlsDelay == null then null else $lib.gvariant.mkUint32 $path.floatingControlsDelay;
  "theme-light" = if $path.themeLight == null then null else $path.themeLight;
  "theme-dark" = if $path.themeDark == null then null else $path.themeDark;
  "style-preference" = if $path.stylePreference == null then null else $lib.gvariant.mkUint32 ($lib.getAttr $path.stylePreference {
      system = 0;
      light = 1;
      dark = 2;
    });
  "theme-bold-is-bright" = if $path.boldIsBright == null then null else $path.boldIsBright;
  "terminal-hide-cursor-while-typing" = if $path.hidePointerWhileTyping == null then null else $path.hidePointerWhileTyping;
  "terminal-padding" = if $path.padding == null then null else $lib.gvariant.mkTuple ($lib.map $lib.gvariant.mkUint32 $path.padding);
  "terminal-cell-width" = if $path.cellWidth == null then null else $lib.gvariant.mkDouble $path.cellWidth;
  "terminal-cell-height" = if $path.cellHeight == null then null else $lib.gvariant.mkDouble $path.cellHeight;
  "terminal-bell" = if $path.bell == null then null else $path.bell;
  "cursor-shape" = if $path.cursorShape == null then null else $lib.gvariant.mkUint32 ($lib.getAttr $path.cursorShape {
      block = 0;
      ibeam = 1;
      underline = 2;
    });
  "cursor-blink-mode" = if $path.cursorBlinkMode == null then null else $lib.gvariant.mkUint32 ($lib.getAttr $path.cursorBlinkMode {
      system = 0;
      on = 1;
      off = 2;
    });
  "cursor-trail" = if $path.cursorTrail == null then null else $path.cursorTrail;
  "cursor-use-accent" = if $path.cursorUseAccent == null then null else $path.cursorUseAccent;
  "easy-copy-paste" = if $path.easyCopyPaste == null then null else $path.easyCopyPaste;
  "command-as-login-shell" = if $path.loginShell == null then null else $path.loginShell;
  "use-custom-command" = if $path.useCustomCommand == null then null else $path.useCustomCommand;
  "custom-shell-command" = if $path.customShellCommand == null then null else $path.customShellCommand;
  "notify-process-completion" = if $path.notifyProcessCompletion == null then null else $path.notifyProcessCompletion;
  "working-directory-mode" = if $path.workingDirectoryMode == null then null else $lib.gvariant.mkUint32 ($lib.getAttr $path.workingDirectoryMode {
      previous = 0;
      home = 1;
      custom = 2;
    });
  "custom-working-directory" = if $path.customWorkingDirectory == null then null else $path.customWorkingDirectory;
};
enable = enableOption {
  _meta = {
    name = "Enable";
    summary = "Install and configure Blankbox";
    description = ''Install the package and apply selected preferences through Home Manager dconf. Preferences remain writable; rebuilds reapply managed selections.'';
    tags = [ "programs" "terminal" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  u! {
    home.packages = [ $path.package ];
    home.sessionVariables = $lib.optionalAttrs $path.defaultTerminal {
      TERMINAL = "${$path.package}/bin/blankbox";
    };
    xdg.terminal-exec = $lib.optionalAttrs $path.defaultTerminal {
      enable = true;
      package = $pkgs.legacy.xdg-terminal-exec;
      settings = {
        default = [ "com.neg-zero.Blankbox.desktop" ];
        GNOME = [ "com.neg-zero.Blankbox.desktop" ];
      };
    };
    dconf.settings = $lib.optionalAttrs ($v.preferences != {}) {
      "com/neg-zero/BlackBoxNext" = $v.preferences;
    };
    assertions = [
      {
        assertion = $path.opacity == null || ($path.opacity >= 0 && $path.opacity <= 100);
        message = "Blankbox: opacity must be between 0 and 100.";
      }
      {
        assertion = $path.scrollbackLines == null || ($path.scrollbackLines >= 0 && $path.scrollbackLines <= 4294967295);
        message = "Blankbox: scrollbackLines must be between 0 and 4294967295.";
      }
      {
        assertion = $path.floatingControlsHoverArea == null || ($path.floatingControlsHoverArea >= 0 && $path.floatingControlsHoverArea <= 4294967295);
        message = "Blankbox: floatingControlsHoverArea must be between 0 and 4294967295.";
      }
      {
        assertion = $path.floatingControlsDelay == null || ($path.floatingControlsDelay >= 0 && $path.floatingControlsDelay <= 4294967295);
        message = "Blankbox: floatingControlsDelay must be between 0 and 4294967295.";
      }
      {
        assertion = $path.padding == null || ($lib.length $path.padding == 4 && $lib.all (x: x >= 0 && x <= 4294967295) $path.padding);
        message = "Blankbox: padding requires four unsigned 32-bit values (top, right, bottom, left).";
      }
      {
        assertion = $path.cellWidth == null || ($path.cellWidth >= 1.0 && $path.cellWidth <= 2.0);
        message = "Blankbox: cellWidth must be between 1.0 and 2.0.";
      }
      {
        assertion = $path.cellHeight == null || ($path.cellHeight >= 1.0 && $path.cellHeight <= 2.0);
        message = "Blankbox: cellHeight must be between 1.0 and 2.0.";
      }
    ];
  };
};
