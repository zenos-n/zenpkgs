_meta = {
  name = "Blankbox";
  summary = "Install and configure Blankbox";
  description = ''GNOME terminal preferences and optional desktop terminal defaults. Unselected preferences use the application defaults or existing live settings.'';
  zenosVersion = 1.0.0Nb;
  tags = [ "programs" "terminal" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};
package._meta = {
  name = "Package";
  summary = "Blankbox package";
  description = ''Package providing bin/blankbox and com.neg-zero.Blankbox.desktop.'';
  type = $type.package;
  default = $pkgs.byCategories.apps.terminal.blankbox;
  tags = [ "programs" "terminal" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};
defaultTerminal._meta = {
  name = "Default terminal";
  summary = "Use Blankbox as the desktop terminal";
  description = ''Set TERMINAL and the GNOME and fallback xdg-terminal-exec preferences. Existing explicit shortcuts must be updated separately.'';
  type = $type.boolean;
  default = false;
  tags = [ "programs" "terminal" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};
rememberWindowSize._meta = {
