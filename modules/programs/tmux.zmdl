enable = enableOption {
  _meta = {
    name = "Install and configure Tmux";
    summary = "Install and configure Tmux";
    description = ''Enable Tmux for the selected user scope. Preferences apply while enabled.'';
    tags = [ "shell" "tmux" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  u! {
    programs.tmux.enable = true;
    programs.tmux.mouse = $lib.mkIf ($path.mouse != null) ($path.mouse);
    programs.tmux.keyMode = $lib.mkIf ($path.keyMode != null) ($path.keyMode);
    programs.tmux.prefix = $lib.mkIf ($path.prefix != null) ($path.prefix);
    programs.tmux.baseIndex = $lib.mkIf ($path.firstWindowIndex != null) ($path.firstWindowIndex);
    programs.tmux.historyLimit = $lib.mkIf ($path.historyLines != null) ($path.historyLines);
    programs.tmux.escapeTime = $lib.mkIf ($path.escapeDelayMilliseconds != null) ($path.escapeDelayMilliseconds);
    programs.tmux.resizeAmount = $lib.mkIf ($path.resizeStep != null) ($path.resizeStep);
    programs.tmux.clock24 = $lib.mkIf ($path.clock24Hours != null) ($path.clock24Hours);
    programs.tmux.focusEvents = $lib.mkIf ($path.focusEvents != null) ($path.focusEvents);
    programs.tmux.newSession = $lib.mkIf ($path.createSessionOnAttach != null) ($path.createSessionOnAttach);
    programs.tmux.reverseSplit = $lib.mkIf ($path.reverseSplitKeys != null) ($path.reverseSplitKeys);
    programs.tmux.customPaneNavigationAndResize = $lib.mkIf ($path.paneNavigationKeys != null) ($path.paneNavigationKeys);
    programs.tmux.aggressiveResize = $lib.mkIf ($path.aggressiveResize != null) ($path.aggressiveResize);
    programs.tmux.secureSocket = $lib.mkIf ($path.secureSocket != null) ($path.secureSocket);
    programs.tmux.terminal = $lib.mkIf ($path.terminalType != null) ($path.terminalType);
    programs.tmux.shell = $lib.mkIf ($path.shellCommand != null) ($path.shellCommand);
    programs.tmux.tmuxp.enable = $lib.mkIf ($path.sessionManager != null) ($path.sessionManager);
    programs.tmux.extraConfig = $lib.mkIf ($path.extraConfiguration != null) ($path.extraConfiguration);
    programs.tmux.disableConfirmationPrompt = $lib.mkIf ($path.confirmClose != null) (!$path.confirmClose);
    assertions = [
      { assertion = $path.firstWindowIndex == null || $path.firstWindowIndex >= 0; message = "programs.tmux.firstWindowIndex must be at least 0."; }
      { assertion = $path.historyLines == null || $path.historyLines >= 1; message = "programs.tmux.historyLines must be at least 1."; }
      { assertion = $path.escapeDelayMilliseconds == null || $path.escapeDelayMilliseconds >= 0; message = "programs.tmux.escapeDelayMilliseconds must be at least 0."; }
      { assertion = $path.resizeStep == null || $path.resizeStep >= 1; message = "programs.tmux.resizeStep must be at least 1."; }
    ];
  };
};
