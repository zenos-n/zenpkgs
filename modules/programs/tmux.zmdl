confirmClose = {
  _meta = {
    name = "Confirm before closing a pane or window";
    summary = "Confirm before closing a pane or window";
    description = ''Confirm before closing a pane or window. Null preserves existing behavior.'';
    tags = [ "shell" "tmux" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
