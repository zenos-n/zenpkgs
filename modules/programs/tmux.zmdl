_meta = {
  zenosVersion = 1.0.0Na;
  name = "Tmux configuration";
  summary = "Tmux configuration";
  description = ''Configure Tmux with typed preferences. Unset values preserve existing behavior.'';
  tags = [ "shell" "tmux" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

mouse = {
  _meta = {
    name = "Use the mouse to select panes";
    summary = "Use the mouse to select panes";
    description = ''Use the mouse to select panes. Null preserves existing behavior.'';
    tags = [ "shell" "tmux" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

