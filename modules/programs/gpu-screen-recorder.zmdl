_meta = {
  name = "GPU Screen Recorder";
  tags = [ "programs" "video" ];
  summary = "GPU recording, replay buffer and GNOME shortcuts";
  description = ''System support grants the standard NixOS KMS helper capability. User enable installs the GUI and replay service; capture starts only when autoStart is selected or the service is started manually.'';
  zenosVersion = 1.0.0Nb;
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

systemSupport = {
  _meta = { type = $type.boolean; default = false; summary = "Install system KMS capture support (system scope only)";  name = "Install system KMS capture support (system scope only)"; description = ''Install system KMS capture support (system scope only).''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
  s!! {
    programs.gpu-screen-recorder.enable = $lib.mkIf $path.systemSupport true;
    programs.gpu-screen-recorder.package = $lib.mkIf $path.systemSupport $pkgs.byCategories.apps.video.gpu-screen-recorder;
  };
};
autoStart._meta = { type = $type.boolean; default = false; summary = "Start the replay buffer with the graphical session";  name = "Start the replay buffer with the graphical session"; description = ''Start the replay buffer with the graphical session.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
replaySeconds._meta = { type = $type.int; default = 60; summary = "Replay duration in seconds";  name = "Replay duration in seconds"; description = ''Replay duration in seconds.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
frameRate._meta = { type = $type.int; default = 60; summary = "Maximum frames per second";  name = "Maximum frames per second"; description = ''Maximum frames per second.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
monitor._meta = { type = $type.string; default = "focused_monitor"; summary = "Capture target accepted by the overlay, such as focused_monitor or a connector name";  name = "Capture target accepted by the overlay, such as focused_monitor or a connector name"; description = ''Capture target accepted by the overlay, such as focused_monitor or a connector name.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
audioDevice._meta = { type = $type.string; default = "default_output"; summary = "Audio source; default is system output, without microphone";  name = "Audio source; default is system output, without microphone"; description = ''Audio source; default is system output, without microphone.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
clipsDirectory._meta = { type = $type.string; default = "%h/Videos/Clips"; summary = "Clip output directory; supports systemd user specifiers";  name = "Clip output directory; supports systemd user specifiers"; description = ''Clip output directory; supports systemd user specifiers.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
recordingsDirectory._meta = { type = $type.string; default = "%h/Videos/Recordings"; summary = "Recording output directory";  name = "Recording output directory"; description = ''Recording output directory.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
recordShortcut._meta = { type = $type.string; default = ""; summary = "GNOME shortcut to toggle regular recording";  name = "GNOME shortcut to toggle regular recording"; description = ''GNOME shortcut to toggle regular recording.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
clipShortcut._meta = { type = $type.string; default = ""; summary = "GNOME shortcut to save replay";  name = "GNOME shortcut to save replay"; description = ''GNOME shortcut to save replay.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };

hudShortcut._meta = { type = $type.string; default = ""; summary = "GNOME shortcut to show or hide the recording overlay"; name = "Show recording HUD"; description = ''Toggle the NVIDIA-style overlay using the desktop shortcut service.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };

_let preferences: $type.list [ $type.set ] = [
  { path = [ "main" "hotkeys_enable_option" ]; value = "disable_hotkeys"; }
  { path = [ "main" "joystick_hotkeys_enable_option" ]; value = "disable_hotkeys"; }
  { path = [ "replay" "turn_on_replay_automatically_mode" ]; value = if $path.autoStart then "turn_on_at_system_startup" else "dont_turn_on_automatically"; }
  { path = [ "replay" "time" ]; value = $path.replaySeconds; }
  { path = [ "replay" "save_directory" ]; value = $path.clipsDirectory; }
  { path = [ "record" "save_directory" ]; value = $path.recordingsDirectory; }
] ++ ($lib.concatMap (mode: [
  { path = [ mode "record_options" "record_area_option" ]; value = $path.monitor; }
  { path = [ mode "record_options" "fps" ]; value = $path.frameRate; }
  { path = [ mode "record_options" "codec" ]; value = "h264"; }
  { path = [ mode "record_options" "audio_codec" ]; value = "aac"; }
  { path = [ mode "record_options" "video_quality" ]; value = "high"; }
  { path = [ mode "record_options" "audio_track_item" ]; value = [ { name = ""; audio_inputs = [ $path.audioDevice ]; application_audio_invert = false; } ]; }
]) [ "record" "replay" ]);

enable = enableOption {
  _meta = { name = "Enable recorder"; summary = "Install the recorder and configure its replay service"; description = ''Creates the user service and selected GNOME shortcuts. Capture starts at login only when autoStart is true.''; tags = [ "programs" "video" ]; maintainers = [ $m.doromiert ]; license = $l.napl; };
  u! {
    home.packages = [ $pkgs.byCategories.apps.video.gpu-screen-recorder-ui ];
    home.activation.zenosScreenRecorderPreferences = $lib.mkWritableProgramConfig {
      pkgs = $pkgs.legacy; application = "gpu-screen-recorder-ui"; assignments = $v.preferences;
    };
    systemd.user.services.zenos-screen-recorder = {
      Unit = {
        Description = "GPU Screen Recorder overlay, replay and recording";
        After = [ "graphical-session.target" "pipewire-pulse.service" ];
        PartOf = [ "graphical-session.target" ];
      };
      Service = {
        ExecStartPre = $lib.escapeShellArgs [ "${$pkgs.legacy.coreutils}/bin/mkdir" "-p" $path.clipsDirectory $path.recordingsDirectory ];
        ExecStart = "${$pkgs.byCategories.apps.video.gpu-screen-recorder-ui}/bin/gsr-ui launch-hide";
        KillSignal = "SIGINT";
        TimeoutStopSec = 30;
        Restart = "on-failure";
        RestartSec = 5;
      };
      Install.WantedBy = if $path.autoStart then [ "graphical-session.target" ] else [ ];
    };
    dconf.settings = $lib.mkMerge [
      {
        "org/gnome/settings-daemon/plugins/media-keys".custom-keybindings =
          $lib.mkIf ($path.recordShortcut != "" || $path.clipShortcut != "" || $path.hudShortcut != "")
          ($lib.concatMap (database:
            database.settings."org/gnome/settings-daemon/plugins/media-keys".custom-keybindings or [ ])
            ($cfg.legacy.programs.dconf.profiles.user.databases or [ ]));
      }
      ($lib.optionalAttrs ($path.recordShortcut != "") {
        "org/gnome/settings-daemon/plugins/media-keys".custom-keybindings = [ "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gsr-record/" ];
        "org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gsr-record" = {
          name = "Toggle GPU recording";
          binding = $path.recordShortcut;
          command = "${$pkgs.byCategories.apps.video.gpu-screen-recorder-ui}/bin/gsr-ui-cli toggle-record";
        };
      })
      ($lib.optionalAttrs ($path.clipShortcut != "") {
        "org/gnome/settings-daemon/plugins/media-keys".custom-keybindings = [ "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gsr-clip/" ];
        "org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gsr-clip" = {
          name = "Save GPU replay clip";
          binding = $path.clipShortcut;
          command = "${$pkgs.byCategories.apps.video.gpu-screen-recorder-ui}/bin/gsr-ui-cli replay-save";
        };
      })
      ($lib.optionalAttrs ($path.hudShortcut != "") {
        "org/gnome/settings-daemon/plugins/media-keys".custom-keybindings = [ "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gsr-hud/" ];
        "org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/gsr-hud" = {
          name = "Toggle GPU recording HUD";
          binding = $path.hudShortcut;
          command = "${$pkgs.byCategories.apps.video.gpu-screen-recorder-ui}/bin/gsr-ui-cli toggle-show";
        };
      })
    ];
    assertions = [
      { assertion = $path.replaySeconds > 0 && $path.frameRate > 0; message = "GPU Screen Recorder requires positive replay duration and frame rate."; }
    ];
  };
};
