_meta = {
  zenosVersion = 1.0.0Nb;
  name = "Gnosis browser";
  summary = "Install the native Gnosis browser";
  description = ''
    Installs Gnosis, the Epiphany-based browser with a Chromium engine, for the
    selected user scope. Browser profiles, credentials, extensions, and writable
    application settings remain managed by Gnosis.
  '';
  tags = [ "programs" "browsers" "internet" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

enable = enableOption {
  _meta = {
    name = "Enable Gnosis";
    summary = "Install Gnosis for the selected user scope";
    description = ''Install the selected Gnosis package without replacing its writable profile or preferences.'';
    tags = [ "programs" "browsers" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };

  u! {
    home.packages = [ $path.package ];
    xdg.desktopEntries = $lib.mapAttrs' (key: app:
      let
        id = "com.neg-zero.Gnosis.WebApp_${key}";
      in $lib.nameValuePair id {
        name = app.name;
        genericName = "Web Application";
        exec = "${$path.package}/bin/gnosis --application-mode=${id}.desktop \"${$lib.replaceStrings [ "\\" "\"" "%" ] [ "\\\\" "\\\"" "%%" ] app.url}\"";
        icon = app.icon;
        terminal = false;
        categories = [ "Network" "WebBrowser" ];
        settings = {
          StartupWMClass = id;
          "X-Gnosis-Declarative" = "true";
        };
      }) $path.apps;
    assertions = $lib.mapAttrsToList (key: app: {
      assertion = $lib.match "[A-Za-z0-9_-]+" key != null && app.name != "" &&
        $lib.match "https?://[^[:space:]\"\\\\]+" app.url != null;
      message = "Gnosis app ${key}: key must contain letters, digits, hyphens or underscores; name must be nonempty and URL must be HTTP(S) without whitespace, quotes or backslashes.";
    }) $path.apps;
    xdg.mimeApps = $lib.optionalAttrs $path.defaultBrowser {
      enable = true;
      defaultApplications = {
        "x-scheme-handler/http" = [ "io.github.doromiert.Jupiter.desktop" ];
        "x-scheme-handler/https" = [ "io.github.doromiert.Jupiter.desktop" ];
        "text/html" = [ "io.github.doromiert.Jupiter.desktop" ];
        "application/xhtml+xml" = [ "io.github.doromiert.Jupiter.desktop" ];
      };
    };
  };
};

apps = {
  _meta = {
    name = "Web applications";
    summary = "Named Gnosis web applications";
    description = ''Create application launchers while Gnosis keeps each browsing profile writable. Removing an entry leaves its profile intact.'';
    tags = [ "programs" "browsers" "web-apps" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  (freeform app) = {
    _meta = {
      name = "Web application";
      summary = "A named Gnosis web application";
      description = ''A launcher with an independent, writable Gnosis profile.'';
      tags = [ "programs" "browsers" "web-apps" ];
      maintainers = [ $m.doromiert ];
      license = $l.napl;
    };
    name._meta = {
      name = "Name"; summary = "Application name";
      description = ''Display name. The named app key is its stable profile identity.'';
      type = $type.string;
      tags = [ "programs" "web-apps" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
    };
    url._meta = {
      name = "URL"; summary = "Application URL";
      description = ''HTTP or HTTPS address opened by the launcher.'';
      type = $type.string;
      tags = [ "programs" "web-apps" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
    };
    icon._meta = {
      name = "Icon"; summary = "Application icon";
      description = ''Icon theme name or absolute icon path.'';
      type = $type.string; default = "web-browser";
      tags = [ "programs" "web-apps" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
    };
  };
};

package = {
  _meta = {
    name = "Gnosis package";
    summary = "Gnosis package to install";
    description = ''
      Gnosis derivation providing bin/gnosis and the
      io.github.doromiert.Jupiter.desktop desktop entry. The default is the
      published development snapshot in the Zenpkgs browser catalog; override
      this option to select a newer development package.
    '';
    type = $type.package;
    default = $pkgs.byCategories.apps.browsers.gnosis;
    tags = [ "programs" "browsers" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
};

defaultBrowser = {
  _meta = {
    name = "Default browser";
    summary = "Use Gnosis for web links and HTML documents";
    description = ''Declare Gnosis as the default handler for HTTP, HTTPS, HTML, and XHTML. False leaves existing associations untouched.'';
    type = $type.boolean;
    default = false;
    tags = [ "programs" "browsers" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
};
