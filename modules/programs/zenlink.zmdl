_meta = {
  zenosVersion = 1.0.0Nb;
  summary = "ZenLink phone integration";
  description = ''
    Installs the native ZenLink desktop service and GNOME extension. Provides
    the host virtual webcam and pairing ports. Streaming settings and live
    camera/microphone selection belong to the Android app. Pairing and media
    settings remain writable at runtime.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.summary = "Enable ZenLink phone integration";

  s! {
    programs.zenlink.enable = true;
    environment.systemPackages = [ $path.package ];
  };
  u! {
    home.packages = $lib.mkDefault [ $path.package ];
    dconf.settings."org/gnome/shell" = {
      enabled-extensions = $lib.mkDefault [ "zenlink@zenos-n.github.io" ];
      disabled-extensions = $lib.mkDefault [ "gsconnect@andyholmes.github.io" ];
    };
    dconf.settings."org/zenos/zenlink".enabled = $path.autoStart;
    xdg.dataFile."dbus-1/services/org.zenos.ZenLink.service".text = "[D-BUS Service]\nName=org.zenos.ZenLink\nExec=${$path.package}/bin/zenlink\nSystemdService=zenlink.service\n";
    systemd.user.services.zenlink = {
      Unit = {
        Description = "ZenLink device service";
        After = [ "graphical-session-pre.target" "pipewire.service" "pipewire-pulse.service" ];
        PartOf = [ "graphical-session.target" ];
      };
      Service = {
        Type = "dbus";
        BusName = "org.zenos.ZenLink";
        ExecStart = "${$path.package}/bin/zenlink";
        Restart = "on-failure";
        RestartSec = "3s";
      };
      Install.WantedBy = if $path.autoStart then [ "graphical-session.target" ] else [ ];
    };
  };
};

package._meta = {
  type = $type.package;
  default = $pkgs.byCategories.system.zenlink;
  summary = "ZenLink desktop package";
};

autoStart._meta = {
  type = $type.boolean;
  default = true;
  summary = "Start ZenLink with the graphical session";
};
