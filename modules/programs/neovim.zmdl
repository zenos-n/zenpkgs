enable = enableOption {
  _meta = {
    name = "Install and configure Neovim";
    summary = "Install and configure Neovim";
    description = ''Enable Neovim for the selected user scope. Preferences apply while enabled.'';
    tags = [ "shell" "neovim" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  u! {
    programs.neovim.enable = true;
    programs.neovim.viAlias = $lib.mkIf ($path.aliasVi != null) ($path.aliasVi);
    programs.neovim.vimAlias = $lib.mkIf ($path.aliasVim != null) ($path.aliasVim);
    programs.neovim.vimdiffAlias = $lib.mkIf ($path.aliasVimdiff != null) ($path.aliasVimdiff);
    programs.neovim.defaultEditor = $lib.mkIf ($path.defaultEditor != null) ($path.defaultEditor);
    programs.neovim.withPython3 = $lib.mkIf ($path.pythonPlugins != null) ($path.pythonPlugins);
    programs.neovim.withNodeJs = $lib.mkIf ($path.nodePlugins != null) ($path.nodePlugins);
    programs.neovim.withRuby = $lib.mkIf ($path.rubyPlugins != null) ($path.rubyPlugins);
    programs.neovim.withPerl = $lib.mkIf ($path.perlPlugins != null) ($path.perlPlugins);
    programs.neovim.waylandSupport = $lib.mkIf ($path.waylandClipboard != null) ($path.waylandClipboard);
    programs.neovim.extraConfig = $lib.mkIf ($path.vimConfiguration != null) ($path.vimConfiguration);
    programs.neovim.initLua = $lib.mkIf ($path.luaConfiguration != null) ($path.luaConfiguration);
  };
};
