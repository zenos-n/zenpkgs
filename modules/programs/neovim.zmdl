waylandClipboard = {
  _meta = {
    name = "Provide Wayland clipboard utilities";
    summary = "Provide Wayland clipboard utilities";
    description = ''Provide Wayland clipboard utilities. Null preserves existing behavior.'';
    tags = [ "shell" "neovim" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

vimConfiguration = {
  _meta = {
    name = "Additional Vimscript configuration";
    summary = "Additional Vimscript configuration";
    description = ''Additional Vimscript configuration. Null preserves existing behavior.'';
    tags = [ "shell" "neovim" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.string) $type.null ];
    default = null;
  };
};

luaConfiguration = {
  _meta = {
    name = "Additional Lua configuration";
    summary = "Additional Lua configuration";
    description = ''Additional Lua configuration. Null preserves existing behavior.'';
    tags = [ "shell" "neovim" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.string) $type.null ];
    default = null;
  };
