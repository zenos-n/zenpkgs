  _meta = {
    name = "Use Neovim as the session editor";
    summary = "Use Neovim as the session editor";
    description = ''Use Neovim as the session editor. Avoid conflicting EDITOR and VISUAL settings in the session environment. Null preserves existing behavior.'';
    tags = [ "shell" "neovim" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

