_meta = {
  zenosVersion = 1.0.0Na;
  name = "Neovim configuration";
  summary = "Neovim configuration";
  description = ''Configure Neovim with typed preferences. Unset values preserve existing behavior.'';
  tags = [ "shell" "neovim" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

aliasVi = {
  _meta = {
    name = "Use Neovim for vi";
    summary = "Use Neovim for vi";
    description = ''Use Neovim for vi. Null preserves existing behavior.'';
    tags = [ "shell" "neovim" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

