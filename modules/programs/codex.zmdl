_let preferences: $type.list [ $type.set ] =
    ($lib.optional ($path.model != null) { path = [ "model" ]; value = $path.model; }) ++
    ($lib.optional ($path.reviewModel != null) { path = [ "review_model" ]; value = $path.reviewModel; }) ++
    ($lib.optional ($path.reasoningEffort != null) { path = [ "model_reasoning_effort" ]; value = $path.reasoningEffort; }) ++
    ($lib.optional ($path.planningReasoningEffort != null) { path = [ "plan_mode_reasoning_effort" ]; value = $path.planningReasoningEffort; }) ++
    ($lib.optional ($path.responsePriority != null) { path = [ "service_tier" ]; value = $path.responsePriority; }) ++
    ($lib.optional ($path.modelProvider != null) { path = [ "model_provider" ]; value = $path.modelProvider; }) ++
    ($lib.optional ($path.instructionFile != null) { path = [ "model_instructions_file" ]; value = $path.instructionFile; }) ++
    ($lib.optional ($path.extraInstructions != null) { path = [ "developer_instructions" ]; value = $path.extraInstructions; }) ++
    ($lib.optional ($path.logDirectory != null) { path = [ "log_dir" ]; value = $path.logDirectory; }) ++
    ($lib.optional ($path.reasoningSummary != null) { path = [ "model_reasoning_summary" ]; value = $path.reasoningSummary; }) ++
    ($lib.optional ($path.answerDetail != null) { path = [ "model_verbosity" ]; value = $path.answerDetail; }) ++
    ($lib.optional ($path.localModelServer != null) { path = [ "oss_provider" ]; value = $path.localModelServer; }) ++
    ($lib.optional ($path.contextWindowTokens != null) { path = [ "model_context_window" ]; value = $path.contextWindowTokens; }) ++
    ($lib.optional ($path.compactAfterTokens != null) { path = [ "model_auto_compact_token_limit" ]; value = $path.compactAfterTokens; }) ++
    ($lib.optional ($path.compactAfterReplyPercent != null) { path = [ "model_post_turn_compact_threshold_percent" ]; value = $path.compactAfterReplyPercent; }) ++
    ($lib.optional ($path.instructionLimitBytes != null) { path = [ "project_doc_max_bytes" ]; value = $path.instructionLimitBytes; }) ++
    ($lib.optional ($path.tools.outputLimitTokens != null) { path = [ "tool_output_token_limit" ]; value = $path.tools.outputLimitTokens; }) ++
    ($lib.optional ($path.tools.backgroundPollLimitMilliseconds != null) { path = [ "background_terminal_max_timeout" ]; value = $path.tools.backgroundPollLimitMilliseconds; }) ++
    ($lib.optional ($path.tools.optionalServerWaitMilliseconds != null) { path = [ "mcp_optional_startup_grace_ms" ]; value = $path.tools.optionalServerWaitMilliseconds; }) ++
    ($lib.optional ($path.historyLimitBytes != null) { path = [ "history" "max_bytes" ]; value = $path.historyLimitBytes; }) ++
    ($lib.optional ($path.commandApproval != null) { path = [ "approval_policy" ]; value = ($lib.getAttr $path.commandApproval { "ask-when-needed" = "on-request"; "never" = "never"; }); }) ++
    ($lib.optional ($path.fileAccess != null) { path = [ "sandbox_mode" ]; value = ($lib.getAttr $path.fileAccess { "read-only" = "read-only"; "workspace" = "workspace-write"; "unrestricted" = "danger-full-access"; }); }) ++
    ($lib.optional ($path.commandNetworkAccess != null) { path = [ "sandbox_workspace_write" "network_access" ]; value = $path.commandNetworkAccess; }) ++
    ($lib.optional ($path.workspace.extraWritableDirectories != null) { path = [ "sandbox_workspace_write" "writable_roots" ]; value = $path.workspace.extraWritableDirectories; }) ++
    ($lib.optional ($path.workspace.writeSystemTemporaryFiles != null) { path = [ "sandbox_workspace_write" "exclude_slash_tmp" ]; value = (!$path.workspace.writeSystemTemporaryFiles); }) ++
    ($lib.optional ($path.workspace.writeSessionTemporaryFiles != null) { path = [ "sandbox_workspace_write" "exclude_tmpdir_env_var" ]; value = (!$path.workspace.writeSessionTemporaryFiles); }) ++
