enable = enableOption {
  _meta = {
    name = "Install and configure Codex"; summary = "Install and configure Codex";
    description = ''Enable this program for the selected user scope. Restart running instances after applying preferences.'';
    tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
  };
  u! {
    home.packages = [ $pkgs.apps.ai.codex ];
    home.sessionVariables = $lib.optionalAttrs ($path.stateDirectory != null) { CODEX_HOME = $path.stateDirectory; };
    home.activation.zenosCodexPreferences = $lib.mkWritableProgramConfig {
      pkgs = $pkgs.legacy; application = "codex"; assignments = $v.preferences;
      stateDirectory = $path.stateDirectory;
    };
    assertions = [
      { assertion = $lib.all (entry: (entry.requestRetryLimit == null || entry.requestRetryLimit >= 0) && (entry.streamRetryLimit == null || entry.streamRetryLimit >= 0) && (entry.streamIdleTimeoutMilliseconds == null || entry.streamIdleTimeoutMilliseconds >= 0) && (entry.connectionTimeoutMilliseconds == null || entry.connectionTimeoutMilliseconds >= 0)) ($lib.attrValues $path.providers); message = "Codex: providers timeouts and retry counts must be nonnegative."; }
      { assertion = $lib.all (entry: (entry.startupTimeoutSeconds == null || entry.startupTimeoutSeconds >= 0) && (entry.toolTimeoutSeconds == null || entry.toolTimeoutSeconds >= 0)) ($lib.attrValues $path.toolServers); message = "Codex: toolServers timeouts and retry counts must be nonnegative."; }
      { assertion = $path.reasoningEffort == null || $path.reasoningEffort != ""; message = "Codex: reasoningEffort must not be empty."; }
      { assertion = $path.planningReasoningEffort == null || $path.planningReasoningEffort != ""; message = "Codex: planningReasoningEffort must not be empty."; }
      { assertion = $path.agents.reasoningEffort == null || $path.agents.reasoningEffort != ""; message = "Codex: agents.reasoningEffort must not be empty."; }
      { assertion = $path.contextWindowTokens == null || ($path.contextWindowTokens >= 1); message = "Codex: contextWindowTokens is outside its supported range."; }
      { assertion = $path.compactAfterTokens == null || ($path.compactAfterTokens >= 1); message = "Codex: compactAfterTokens is outside its supported range."; }
      { assertion = $path.compactAfterReplyPercent == null || ($path.compactAfterReplyPercent >= 0 && $path.compactAfterReplyPercent <= 100); message = "Codex: compactAfterReplyPercent is outside its supported range."; }
      { assertion = $path.instructionLimitBytes == null || ($path.instructionLimitBytes >= 0); message = "Codex: instructionLimitBytes is outside its supported range."; }
      { assertion = $path.tools.outputLimitTokens == null || ($path.tools.outputLimitTokens >= 0); message = "Codex: tools.outputLimitTokens is outside its supported range."; }
      { assertion = $path.tools.backgroundPollLimitMilliseconds == null || ($path.tools.backgroundPollLimitMilliseconds >= 0); message = "Codex: tools.backgroundPollLimitMilliseconds is outside its supported range."; }
      { assertion = $path.tools.optionalServerWaitMilliseconds == null || ($path.tools.optionalServerWaitMilliseconds >= 0); message = "Codex: tools.optionalServerWaitMilliseconds is outside its supported range."; }
      { assertion = $path.historyLimitBytes == null || ($path.historyLimitBytes >= 0); message = "Codex: historyLimitBytes is outside its supported range."; }
      { assertion = $path.agents.maximumConcurrentAgents == null || ($path.agents.maximumConcurrentAgents >= 1); message = "Codex: agents.maximumConcurrentAgents is outside its supported range."; }
      { assertion = $path.agents.maximumDepth == null || ($path.agents.maximumDepth >= 0); message = "Codex: agents.maximumDepth is outside its supported range."; }
      { assertion = $path.memories.maximumConversationAgeDays == null || ($path.memories.maximumConversationAgeDays >= 0); message = "Codex: memories.maximumConversationAgeDays is outside its supported range."; }
      { assertion = $path.memories.minimumIdleHours == null || ($path.memories.minimumIdleHours >= 0); message = "Codex: memories.minimumIdleHours is outside its supported range."; }
      { assertion = $path.memories.minimumRemainingUsagePercent == null || ($path.memories.minimumRemainingUsagePercent >= 0 && $path.memories.minimumRemainingUsagePercent <= 100); message = "Codex: memories.minimumRemainingUsagePercent is outside its supported range."; }
      { assertion = $path.memories.maximumConversationsPerPass == null || ($path.memories.maximumConversationsPerPass >= 0); message = "Codex: memories.maximumConversationsPerPass is outside its supported range."; }
      { assertion = $path.memories.maximumUnusedDays == null || ($path.memories.maximumUnusedDays >= 0); message = "Codex: memories.maximumUnusedDays is outside its supported range."; }
      { assertion = $path.skills.instructionLimitTokens == null || ($path.skills.instructionLimitTokens >= 0); message = "Codex: skills.instructionLimitTokens is outside its supported range."; }
      { assertion = $path.terminal.resizeHistoryLines == null || ($path.terminal.resizeHistoryLines >= 0); message = "Codex: terminal.resizeHistoryLines is outside its supported range."; }
      { assertion = $path.toolLoginCallbackPort == null || ($path.toolLoginCallbackPort >= 1 && $path.toolLoginCallbackPort <= 65535); message = "Codex: toolLoginCallbackPort is outside its supported range."; }
      { assertion = $path.stateDirectory == null || $lib.hasPrefix "/" $path.stateDirectory; message = "Codex: stateDirectory must be an absolute path."; }
      { assertion = $path.instructionFile == null || $lib.hasPrefix "/" $path.instructionFile; message = "Codex: instructionFile must be an absolute path."; }
      { assertion = $path.logDirectory == null || $lib.hasPrefix "/" $path.logDirectory; message = "Codex: logDirectory must be an absolute path."; }
      { assertion = $lib.all (entryName: !($lib.elem entryName [ "enabled" "default_subagent_model" "default_subagent_reasoning_effort" "max_concurrent_threads_per_session" "max_depth" "interrupt_message" ])) ($lib.attrNames $path.agentRoles); message = "Codex: an agent role name collides with a scalar agent setting."; }
      { assertion = $lib.all (entry: entry.apiUrl == null || $lib.hasPrefix "https://" entry.apiUrl || $lib.hasPrefix "http://" entry.apiUrl) ($lib.attrValues $path.providers); message = "Codex: provider API URLs must use HTTP or HTTPS."; }
      { assertion = $lib.all (entry: entry.command == null || entry.serverUrl == null) ($lib.attrValues $path.toolServers); message = "Codex: tool servers must select a command or URL, not both."; }
    ];
  };
};
