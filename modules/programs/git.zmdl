_meta = {
  name = "Git version control";
  summary = "Configure everyday version-control workflows";
  description = ''Choose commit identity, history integration, signing and review preferences.'';
  tags = [ "development" "git" ];
  zenosVersion = 1.0.0Na;
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

enable = enableOption {
  _meta = {
    name = "Install and configure Git";
    summary = "Install and configure Git";
    description = ''Install Git and configure preferences for this user.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  u! {
    programs.git.enable = true;
    programs.git.settings.user.name = $lib.mkIf ($path.authorName != null) ($path.authorName);
    programs.git.settings.user.email = $lib.mkIf ($path.authorEmail != null) ($path.authorEmail);
    programs.git.settings.init.defaultBranch = $lib.mkIf ($path.initialBranch != null) ($path.initialBranch);
    programs.git.settings.core.editor = $lib.mkIf ($path.commitEditor != null) ($path.commitEditor);
    programs.git.settings.user.signingKey = $lib.mkIf ($path.signingKey != null) ($path.signingKey);
    programs.git.settings.user.useConfigOnly = $lib.mkIf ($path.requireExplicitIdentity != null) ($path.requireExplicitIdentity);
    programs.git.settings.commit.gpgSign = $lib.mkIf ($path.signCommits != null) ($path.signCommits);
    programs.git.settings.tag.gpgSign = $lib.mkIf ($path.signTags != null) ($path.signTags);
    programs.git.settings.push.autoSetupRemote = $lib.mkIf ($path.trackNewRemoteBranches != null) ($path.trackNewRemoteBranches);
    programs.git.settings.fetch.prune = $lib.mkIf ($path.pruneDeletedRemoteBranches != null) ($path.pruneDeletedRemoteBranches);
    programs.git.settings.rerere.enabled = $lib.mkIf ($path.rememberConflictResolutions != null) ($path.rememberConflictResolutions);
    programs.git.settings.rerere.autoUpdate = $lib.mkIf ($path.stageReusedConflictResolutions != null) ($path.stageReusedConflictResolutions);
    programs.git.settings.diff.colorMoved = $lib.mkIf ($path.highlightMovedLines != null) ($path.highlightMovedLines);
    programs.git.settings.rebase.autoStash = $lib.mkIf ($path.stashBeforeRebase != null) ($path.stashBeforeRebase);
    programs.git.settings.tag.sort = $lib.mkIf ($path.sortTagsByVersion != null) (if $path.sortTagsByVersion then "version:refname" else "refname");
    programs.git.settings.gpg.format = $lib.mkIf ($path.signingMethod != null) ($path.signingMethod);
    programs.git.settings.pull = $lib.mkIf ($path.pullStrategy != null) ({ rebase = $path.pullStrategy == "rebase"; ff = if $path.pullStrategy == "fast-forward-only" then "only" else true; });
    programs.git.settings.core.autocrlf = $lib.mkIf ($path.lineEndings != null) (if $path.lineEndings == "preserve" then false else if $path.lineEndings == "normalize" then "input" else true);
    programs.git.lfs.enable = $lib.mkIf ($path.largeFileSupport != null) ($path.largeFileSupport);
    programs.git.ignores = $lib.mkIf ($path.ignoredFiles != null) ($path.ignoredFiles);
  };
};

authorName = {
  _meta = {
    name = "Name recorded on new commits";
    summary = "Name recorded on new commits";
    description = ''Name recorded on new commits.  Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.string) $type.null ];
    default = null;
  };
};

