    description = ''Remove remote-tracking branches deleted on the remote. Runs during fetch; does not delete local branches. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
