  _meta = {
    name = "Record and reuse resolutions of repeated merge conflicts";
    summary = "Record and reuse resolutions of repeated merge conflicts";
    description = ''Record and reuse resolutions of repeated merge conflicts. Reuses previously recorded solutions to matching conflicts. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

stageReusedConflictResolutions = {
  _meta = {
    name = "Stage conflict resolutions that Git successfully reuses";
    summary = "Stage conflict resolutions that Git successfully reuses";
    description = ''Stage conflict resolutions that Git successfully reuses. Requires remembered conflict resolutions. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

highlightMovedLines = {
  _meta = {
    name = "Highlight moved lines in diffs";
    summary = "Highlight moved lines in diffs";
    description = ''Highlight moved lines in diffs. Uses the Git default moved-line coloring mode. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

stashBeforeRebase = {
  _meta = {
    name = "Temporarily stash local changes before rebasing";
    summary = "Temporarily stash local changes before rebasing";
    description = ''Temporarily stash local changes before rebasing. Restores the changes after the rebase; restoration can require conflict resolution. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

sortTagsByVersion = {
  _meta = {
    name = "Sort tag names by version rather than alphabetically";
    summary = "Sort tag names by version rather than alphabetically";
    description = ''Sort tag names by version rather than alphabetically.  Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

signingMethod = {
  _meta = {
    name = "Method used to sign commits and tags";
    summary = "Method used to sign commits and tags";
    description = ''Method used to sign commits and tags. The appropriate signing tool and credentials must be available. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.enum [ "openpgp" "ssh" "x509" ]) $type.null ];
    default = null;
  };
};

pullStrategy = {
  _meta = {
    name = "How pulling integrates remote changes";
    summary = "How pulling integrates remote changes";
    description = ''How pulling integrates remote changes. Merge preserves local commits with a merge when needed; rebase replays them; fast-forward-only refuses divergent history. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.enum [ "merge" "rebase" "fast-forward-only" ]) $type.null ];
    default = null;
  };
};

lineEndings = {
  _meta = {
    name = "Line-ending conversion for text files";
    summary = "Line-ending conversion for text files";
    description = ''Line-ending conversion for text files. Preserve disables automatic conversion; normalize converts committed CRLF to LF; windows also checks text out as CRLF. Repository attributes can override this policy. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.enum [ "preserve" "normalize" "windows" ]) $type.null ];
    default = null;
  };
};

largeFileSupport = {
  _meta = {
    name = "Track large files with Git LFS";
    summary = "Track large files with Git LFS";
    description = ''Track large files with Git LFS. Installs and configures Git LFS; repositories must still select which files use LFS. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

ignoredFiles = {
  _meta = {
    name = "File patterns ignored across repositories";
    summary = "File patterns ignored across repositories";
    description = ''File patterns ignored across repositories. Patterns use gitignore syntax; already tracked files remain tracked. Null keeps the existing program policy.'';
    tags = [ "development" "git" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.list [ $type.string ]) $type.null ];
    default = null;
  };
};
