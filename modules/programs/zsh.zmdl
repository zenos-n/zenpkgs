enable = enableOption {
  _meta = {
    name = "Install and configure Zsh";
    summary = "Install and configure Zsh";
    description = ''Enable Zsh for the selected user scope. Preferences apply while enabled.'';
    tags = [ "shell" "zsh" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  u! {
    programs.zsh.enable = true;
    programs.zsh.enableCompletion = $lib.mkIf ($path.completion != null) ($path.completion);
    programs.zsh.autocd = $lib.mkIf ($path.autoChangeDirectory != null) ($path.autoChangeDirectory);
    programs.zsh.cdpath = $lib.mkIf ($path.directorySearchPaths != null) ($path.directorySearchPaths);
    programs.zsh.shellAliases = $lib.mkIf ($path.aliases != null) ($path.aliases);
    programs.zsh.shellGlobalAliases = $lib.mkIf ($path.globalAliases != null) ($path.globalAliases);
    programs.zsh.autosuggestion.enable = $lib.mkIf ($path.suggestions != null) ($path.suggestions);
    programs.zsh.autosuggestion.strategy = $lib.mkIf ($path.suggestionSources != null) ($path.suggestionSources);
    programs.zsh.syntaxHighlighting.enable = $lib.mkIf ($path.syntaxHighlighting != null) ($path.syntaxHighlighting);
    programs.zsh.history.size = $lib.mkIf ($path.historyLines != null) ($path.historyLines);
    programs.zsh.history.save = $lib.mkIf ($path.savedHistoryLines != null) ($path.savedHistoryLines);
    programs.zsh.history.path = $lib.mkIf ($path.historyFile != null) ($path.historyFile);
    programs.zsh.history.share = $lib.mkIf ($path.shareHistory != null) ($path.shareHistory);
    programs.zsh.history.append = $lib.mkIf ($path.appendHistory != null) ($path.appendHistory);
    programs.zsh.history.ignoreDups = $lib.mkIf ($path.ignoreConsecutiveDuplicates != null) ($path.ignoreConsecutiveDuplicates);
    programs.zsh.history.ignoreAllDups = $lib.mkIf ($path.removeOlderDuplicates != null) ($path.removeOlderDuplicates);
    programs.zsh.history.ignoreSpace = $lib.mkIf ($path.ignoreLeadingSpace != null) ($path.ignoreLeadingSpace);
    programs.zsh.history.extended = $lib.mkIf ($path.recordHistoryTimes != null) ($path.recordHistoryTimes);
    programs.zsh.history.ignorePatterns = $lib.mkIf ($path.ignoredHistoryPatterns != null) ($path.ignoredHistoryPatterns);
    programs.zsh.historySubstringSearch.enable = $lib.mkIf ($path.substringHistorySearch != null) ($path.substringHistorySearch);
    programs.zsh.initContent = $lib.mkIf ($path.interactiveCommands != null) ($path.interactiveCommands);
    programs.zsh.profileExtra = $lib.mkIf ($path.loginCommands != null) ($path.loginCommands);
    programs.zsh.defaultKeymap = $lib.mkIf ($path.editingMode != null) (if $path.editingMode == "vi" then "viins" else "emacs");
    assertions = [
      { assertion = $path.historyLines == null || $path.historyLines >= 0; message = "programs.zsh.historyLines must be at least 0."; }
      { assertion = $path.savedHistoryLines == null || $path.savedHistoryLines >= 0; message = "programs.zsh.savedHistoryLines must be at least 0."; }
    ];
  };
};
