_meta = {
  zenosVersion = 1.0.0Na;
  name = "Zsh configuration";
  summary = "Zsh configuration";
  description = ''Configure Zsh with typed preferences. Unset values preserve existing behavior.'';
  tags = [ "shell" "zsh" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

