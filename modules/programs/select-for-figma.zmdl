_meta = {
  name = "Select for Figma";
  summary = "Install and configure the native Select for Figma client";
  description = ''Native GTK Select preferences. Selected settings are reapplied during user activation; other preferences, sessions and login data remain writable and unchanged.'';
  zenosVersion = 1.0.0Nb; tags = [ "programs" "graphics" ];
  maintainers = [ $m.doromiert ]; license = $l.napl;
};

appearance._meta = {
  name = "Appearance"; summary = "Appearance";
  description = ''Follow the desktop appearance or force light or dark mode. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.enum [ "system" "light" "dark" ]) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

adwaitaEditorTheme._meta = {
  name = "Adwaita editor theme"; summary = "Adwaita editor theme";
  description = ''Apply the native Adwaita theme to Figma editor chrome. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.boolean) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

restoreOpenFiles._meta = {
  name = "Restore open files"; summary = "Restore open files";
  description = ''Restore the previous document session when Select starts. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.boolean) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

tabSwitchingOrder._meta = {
  name = "Tab switching order"; summary = "Tab switching order";
  description = ''Cycle with Ctrl+Tab in tab position or most recently used order, including Home. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.enum [ "position" "recent" ]) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

localFonts._meta = {
  name = "Local fonts"; summary = "Local fonts";
  description = ''Make installed local fonts available to Figma. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.boolean) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

notifications._meta = {
  name = "Notifications"; summary = "Notifications";
  description = ''Allow desktop notifications from the embedded Figma client. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.boolean) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

downloadDirectory._meta = {
  name = "Download directory"; summary = "Download directory";
  description = ''Absolute directory for downloads and exported files. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.string) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

zane.chat.model._meta = {
  name = "Chat model"; summary = "Chat model";
  description = ''Chat model identifier, at most 200 UTF-8 bytes. An empty string uses Codex settings. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.string) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

zane.chat.reasoningEffort._meta = {
  name = "Chat reasoning effort"; summary = "Chat reasoning effort";
  description = ''Reasoning level supported by the selected model, at most 32 UTF-8 bytes. An empty string uses Codex settings. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.string) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

zane.work.model._meta = {
  name = "Work model"; summary = "Work model";
  description = ''Work model identifier, at most 200 UTF-8 bytes. An empty string uses Codex settings. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.string) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

zane.work.reasoningEffort._meta = {
  name = "Work reasoning effort"; summary = "Work reasoning effort";
  description = ''Reasoning level supported by the selected model, at most 32 UTF-8 bytes. An empty string uses Codex settings. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.string) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

zane.showAccountPresence._meta = {
  name = "Show account presence"; summary = "Show account presence";
  description = ''Show Zane account presence in the signed-in editor. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.boolean) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

zane.automaticEditAccess._meta = {
  name = "Automatic edit access"; summary = "Automatic edit access";
  description = ''Let Zane request editor access automatically when performing edits. Null preserves the current preference. Restart Select after applying changes.'';
  type = $type.either [ ($type.boolean) $type.null ]; default = null;
  tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
};

_let preferences: $type.list [ $type.set ] =
  ($lib.optional ($path.appearance != null) { path = [ "appearance" ]; value = $path.appearance; }) ++
  ($lib.optional ($path.adwaitaEditorTheme != null) { path = [ "adwaita-editor" ]; value = $path.adwaitaEditorTheme; }) ++
  ($lib.optional ($path.restoreOpenFiles != null) { path = [ "restore-session" ]; value = $path.restoreOpenFiles; }) ++
  ($lib.optional ($path.tabSwitchingOrder != null) { path = [ "tab-switcher-mru" ]; value = $path.tabSwitchingOrder == "recent"; }) ++
  ($lib.optional ($path.localFonts != null) { path = [ "local-fonts" ]; value = $path.localFonts; }) ++
  ($lib.optional ($path.notifications != null) { path = [ "notifications" ]; value = $path.notifications; }) ++
  ($lib.optional ($path.downloadDirectory != null) { path = [ "download-folder" ]; value = $path.downloadDirectory; }) ++
  ($lib.optional ($path.zane.chat.model != null) { path = [ "zane-chat-model" ]; value = $path.zane.chat.model; }) ++
  ($lib.optional ($path.zane.chat.reasoningEffort != null) { path = [ "zane-chat-effort" ]; value = $path.zane.chat.reasoningEffort; }) ++
  ($lib.optional ($path.zane.work.model != null) { path = [ "zane-work-model" ]; value = $path.zane.work.model; }) ++
  ($lib.optional ($path.zane.work.reasoningEffort != null) { path = [ "zane-work-effort" ]; value = $path.zane.work.reasoningEffort; }) ++
  ($lib.optional ($path.zane.showAccountPresence != null) { path = [ "zane-account-presence" ]; value = $path.zane.showAccountPresence; }) ++
  ($lib.optional ($path.zane.automaticEditAccess != null) { path = [ "zane-auto-edit-access" ]; value = $path.zane.automaticEditAccess; });

enable = enableOption {
  _meta = {
    name = "Install and configure Select for Figma"; summary = "Install and configure Select for Figma";
    description = ''Install native Select for the selected user scope. Apply only non-null preferences to its writable state file. Existing figma-gtk data is migrated before the first preference write.'';
    tags = [ "programs" ]; maintainers = [ $m.doromiert ]; license = $l.napl;
  };
  u! {
    home.packages = [ $pkgs.com.neg-zero.select-for-figma ];
    home.activation.zenosSelectForFigmaPreferences = $lib.mkWritableProgramConfig {
      pkgs = $pkgs.legacy; application = "select-for-figma"; assignments = $v.preferences;
    };
    assertions = [
      { assertion = $path.downloadDirectory == null || $lib.hasPrefix "/" $path.downloadDirectory; message = "Select for Figma: downloadDirectory must be an absolute path."; }
      { assertion = $path.zane.chat.model == null || $lib.stringLength $path.zane.chat.model <= 200; message = "Select for Figma: zane.chat.model must be at most 200 UTF-8 bytes."; }
      { assertion = $path.zane.work.model == null || $lib.stringLength $path.zane.work.model <= 200; message = "Select for Figma: zane.work.model must be at most 200 UTF-8 bytes."; }
      { assertion = $path.zane.chat.reasoningEffort == null || $lib.stringLength $path.zane.chat.reasoningEffort <= 32; message = "Select for Figma: zane.chat.reasoningEffort must be at most 32 UTF-8 bytes."; }
      { assertion = $path.zane.work.reasoningEffort == null || $lib.stringLength $path.zane.work.reasoningEffort <= 32; message = "Select for Figma: zane.work.reasoningEffort must be at most 32 UTF-8 bytes."; }
    ];
  };
};
