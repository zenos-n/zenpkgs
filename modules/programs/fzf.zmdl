    tags = [ "shell" "fzf" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

tmuxOptions = {
  _meta = {
    name = "Tmux wrapper arguments";
    summary = "Tmux wrapper arguments";
    description = ''Tmux wrapper arguments. Null preserves existing behavior.'';
    tags = [ "shell" "fzf" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.list [ $type.string ]) $type.null ];
    default = null;
  };
