colors = {
  _meta = {
    name = "Fuzzy-finder color settings";
    summary = "Fuzzy-finder color settings";
    description = ''Fuzzy-finder color settings. Null preserves existing behavior.'';
    tags = [ "shell" "fzf" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.set [ $type.string ]) $type.null ];
    default = null;
