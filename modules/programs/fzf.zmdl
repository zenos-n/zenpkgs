_meta = {
  zenosVersion = 1.0.0Na;
  name = "Fzf configuration";
  summary = "Fzf configuration";
  description = ''Configure Fzf with typed preferences. Unset values preserve existing behavior.'';
  tags = [ "shell" "fzf" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

bashIntegration = {
  _meta = {
    name = "Enable Bash integration";
    summary = "Enable Bash integration";
    description = ''Enable Bash integration. Requires that shell to be managed; does not select a login shell. Null preserves existing behavior.'';
    tags = [ "shell" "fzf" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
};

