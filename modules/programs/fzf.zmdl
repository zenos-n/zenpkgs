enable = enableOption {
  _meta = {
    name = "Install and configure Fzf";
    summary = "Install and configure Fzf";
    description = ''Enable Fzf for the selected user scope. Preferences apply while enabled.'';
    tags = [ "shell" "fzf" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
  };
  u! {
    programs.fzf.enable = true;
    programs.fzf.enableBashIntegration = $lib.mkIf ($path.bashIntegration != null) ($path.bashIntegration);
    programs.fzf.enableZshIntegration = $lib.mkIf ($path.zshIntegration != null) ($path.zshIntegration);
    programs.fzf.enableFishIntegration = $lib.mkIf ($path.fishIntegration != null) ($path.fishIntegration);
    programs.fzf.defaultCommand = $lib.mkIf ($path.fileSourceCommand != null) ($path.fileSourceCommand);
    programs.fzf.defaultOptions = $lib.mkIf ($path.options != null) ($path.options);
    programs.fzf.fileWidgetCommand = $lib.mkIf ($path.fileWidgetCommand != null) ($path.fileWidgetCommand);
    programs.fzf.fileWidgetOptions = $lib.mkIf ($path.fileWidgetOptions != null) ($path.fileWidgetOptions);
    programs.fzf.changeDirWidgetCommand = $lib.mkIf ($path.directoryWidgetCommand != null) ($path.directoryWidgetCommand);
    programs.fzf.changeDirWidgetOptions = $lib.mkIf ($path.directoryWidgetOptions != null) ($path.directoryWidgetOptions);
    programs.fzf.historyWidgetOptions = $lib.mkIf ($path.historyWidgetOptions != null) ($path.historyWidgetOptions);
    programs.fzf.colors = $lib.mkIf ($path.colors != null) ($path.colors);
    programs.fzf.tmux.enableShellIntegration = $lib.mkIf ($path.tmuxPopup != null) ($path.tmuxPopup);
    programs.fzf.tmux.shellIntegrationOptions = $lib.mkIf ($path.tmuxOptions != null) ($path.tmuxOptions);
  };
};
