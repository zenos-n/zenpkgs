_meta = {
  zenosVersion = 1.0.0Na;
  name = "Standard personal folders";
  summary = "Standard personal folders";
  description = ''Settings for one user. Unset values preserve existing policy and preferences.'';
  tags = [ "users" "userDirs" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

enable = {
  _meta = {
    name = "Manage standard personal folders";
    summary = "Manage standard personal folders";
    description = ''Manage standard personal folders. Null leaves this preference unchanged.'';
    tags = [ "users" "userDirs" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
  u!! {
    xdg.userDirs.enable = $lib.mkIf ($path.enable != null) ($path.enable);
  };
  u!! {
    assertions = [
      { assertion = $path.desktop == null || ($lib.hasPrefix "/" $path.desktop); message = "desktop must be an absolute path."; }
      { assertion = $path.documents == null || ($lib.hasPrefix "/" $path.documents); message = "documents must be an absolute path."; }
      { assertion = $path.downloads == null || ($lib.hasPrefix "/" $path.downloads); message = "downloads must be an absolute path."; }
      { assertion = $path.music == null || ($lib.hasPrefix "/" $path.music); message = "music must be an absolute path."; }
      { assertion = $path.pictures == null || ($lib.hasPrefix "/" $path.pictures); message = "pictures must be an absolute path."; }
      { assertion = $path.videos == null || ($lib.hasPrefix "/" $path.videos); message = "videos must be an absolute path."; }
      { assertion = $path.templates == null || ($lib.hasPrefix "/" $path.templates); message = "templates must be an absolute path."; }
      { assertion = $path.publicShare == null || ($lib.hasPrefix "/" $path.publicShare); message = "publicShare must be an absolute path."; }
      { assertion = $path.projects == null || ($lib.hasPrefix "/" $path.projects); message = "projects must be an absolute path."; }
    ];
  };
};

createDirectories = {
  _meta = {
    name = "Create configured personal folders";
    summary = "Create configured personal folders";
    description = ''Create configured personal folders. Requires userDirs.enable = true. Null leaves this preference unchanged.'';
    tags = [ "users" "userDirs" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
  u!! {
    xdg.userDirs.createDirectories = $lib.mkIf ($path.createDirectories != null) ($path.createDirectories);
  };
};

desktop = {
  _meta = {
    name = "Location of the desktop folder";
    summary = "Location of the desktop folder";
    description = ''Location of the desktop folder. Absolute path. Requires userDirs.enable = true. Does not move existing files. Null leaves this preference unchanged.'';
    tags = [ "users" "userDirs" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.string) $type.null ];
    default = null;
  };
  u!! {
    xdg.userDirs.desktop = $lib.mkIf ($path.desktop != null) ($path.desktop);
  };
};

