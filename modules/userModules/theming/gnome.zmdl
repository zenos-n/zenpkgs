appearance.animations = {
  _meta = {
    name = "Animations";
    summary = "Animations";
    description = ''Animations. Personal GNOME preference. Applies when using GNOME; does not enable or install the desktop. Null leaves this preference unchanged.'';
    tags = [ "users" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
  u!! {
    dconf.settings."org/gnome/desktop/interface"."enable-animations" = $lib.mkIf ($path.appearance.animations != null) ($path.appearance.animations);
  };
  u!! {
    assertions = [
      { assertion = $path.accessibility.inactivityTimeoutSeconds == null || ($path.accessibility.inactivityTimeoutSeconds >= 0 && $path.accessibility.inactivityTimeoutSeconds <= 2147483647); message = "users.<name>.theming.gnome.accessibility.inactivityTimeoutSeconds must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.keyboardMouseSpeed == null || ($path.accessibility.keyboardMouseSpeed >= 0 && $path.accessibility.keyboardMouseSpeed <= 2147483647); message = "users.<name>.theming.gnome.accessibility.keyboardMouseSpeed must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.keyboardMouseAccelerationMilliseconds == null || ($path.accessibility.keyboardMouseAccelerationMilliseconds >= 0 && $path.accessibility.keyboardMouseAccelerationMilliseconds <= 2147483647); message = "users.<name>.theming.gnome.accessibility.keyboardMouseAccelerationMilliseconds must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.keyboardMouseDelayMilliseconds == null || ($path.accessibility.keyboardMouseDelayMilliseconds >= 0 && $path.accessibility.keyboardMouseDelayMilliseconds <= 2147483647); message = "users.<name>.theming.gnome.accessibility.keyboardMouseDelayMilliseconds must be between 0 and 2147483647."; }
      { assertion = $path.magnification.zoom == null || ($path.magnification.zoom >= 0.1 && $path.magnification.zoom <= 32.0); message = "users.<name>.theming.gnome.magnification.zoom must be between 0.1 and 32.0."; }
      { assertion = $path.magnification.crosshairThicknessPixels == null || ($path.magnification.crosshairThicknessPixels >= 0 && $path.magnification.crosshairThicknessPixels <= 2147483647); message = "users.<name>.theming.gnome.magnification.crosshairThicknessPixels must be between 0 and 2147483647."; }
      { assertion = $path.magnification.crosshairOpacity == null || ($path.magnification.crosshairOpacity >= 0.0 && $path.magnification.crosshairOpacity <= 1.0); message = "users.<name>.theming.gnome.magnification.crosshairOpacity must be between 0.0 and 1.0."; }
      { assertion = $path.magnification.crosshairLengthPixels == null || ($path.magnification.crosshairLengthPixels >= 20 && $path.magnification.crosshairLengthPixels <= 4096); message = "users.<name>.theming.gnome.magnification.crosshairLengthPixels must be between 20 and 4096."; }
      { assertion = $path.magnification.colorSaturation == null || ($path.magnification.colorSaturation >= 0.0 && $path.magnification.colorSaturation <= 1.0); message = "users.<name>.theming.gnome.magnification.colorSaturation must be between 0.0 and 1.0."; }
      { assertion = $path.accessibility.hoverClickDelaySeconds == null || ($path.accessibility.hoverClickDelaySeconds >= 0.0); message = "users.<name>.theming.gnome.accessibility.hoverClickDelaySeconds must be at least 0.0."; }
      { assertion = $path.accessibility.hoverClickMovementPixels == null || ($path.accessibility.hoverClickMovementPixels >= 0 && $path.accessibility.hoverClickMovementPixels <= 2147483647); message = "users.<name>.theming.gnome.accessibility.hoverClickMovementPixels must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.rightClickHoldSeconds == null || ($path.accessibility.rightClickHoldSeconds >= 0.0); message = "users.<name>.theming.gnome.accessibility.rightClickHoldSeconds must be at least 0.0."; }
      { assertion = $path.appearance.textScale == null || ($path.appearance.textScale >= 0.5 && $path.appearance.textScale <= 3.0); message = "users.<name>.theming.gnome.appearance.textScale must be between 0.5 and 3.0."; }
      { assertion = $path.privacy.cleanupAgeDays == null || ($path.privacy.cleanupAgeDays >= 0 && $path.privacy.cleanupAgeDays <= 4294967295); message = "users.<name>.theming.gnome.privacy.cleanupAgeDays must be between 0 and 4294967295."; }
      { assertion = $path.power.screenBlankSeconds == null || ($path.power.screenBlankSeconds >= 0 && $path.power.screenBlankSeconds <= 4294967295); message = "users.<name>.theming.gnome.power.screenBlankSeconds must be between 0 and 4294967295."; }
      { assertion = $path.security.lockDelaySeconds == null || ($path.security.lockDelaySeconds >= 0 && $path.security.lockDelaySeconds <= 4294967295); message = "users.<name>.theming.gnome.security.lockDelaySeconds must be between 0 and 4294967295."; }
      { assertion = $path.mouse.speed == null || ($path.mouse.speed >= -1 && $path.mouse.speed <= 1); message = "users.<name>.theming.gnome.mouse.speed must be between -1 and 1."; }
      { assertion = $path.touchpad.speed == null || ($path.touchpad.speed >= -1 && $path.touchpad.speed <= 1); message = "users.<name>.theming.gnome.touchpad.speed must be between -1 and 1."; }
      { assertion = $path.keyboard.repeatDelayMilliseconds == null || ($path.keyboard.repeatDelayMilliseconds >= 0 && $path.keyboard.repeatDelayMilliseconds <= 4294967295); message = "users.<name>.theming.gnome.keyboard.repeatDelayMilliseconds must be between 0 and 4294967295."; }
      { assertion = $path.keyboard.repeatIntervalMilliseconds == null || ($path.keyboard.repeatIntervalMilliseconds >= 0 && $path.keyboard.repeatIntervalMilliseconds <= 4294967295); message = "users.<name>.theming.gnome.keyboard.repeatIntervalMilliseconds must be between 0 and 4294967295."; }
      { assertion = $path.windows.raiseDelayMilliseconds == null || ($path.windows.raiseDelayMilliseconds >= 0 && $path.windows.raiseDelayMilliseconds <= 10000); message = "users.<name>.theming.gnome.windows.raiseDelayMilliseconds must be between 0 and 10000."; }
      { assertion = $path.workspaces.count == null || ($path.workspaces.count >= 1 && $path.workspaces.count <= 36); message = "users.<name>.theming.gnome.workspaces.count must be between 1 and 36."; }
      { assertion = $path.nightLight.temperature == null || ($path.nightLight.temperature >= 0 && $path.nightLight.temperature <= 4294967295); message = "users.<name>.theming.gnome.nightLight.temperature must be between 0 and 4294967295."; }
    ];
  };
};

