    default = null;
  };
  u!! {
    dconf.settings."org/gnome/desktop/interface"."text-scaling-factor" = $lib.mkIf ($path.appearance.textScale != null) ($lib.gvariant.mkDouble ($path.appearance.textScale));
  };
};

