_meta = {
  zenosVersion = 1.0.0Na;
  name = "Personal language and formats";
  summary = "Personal language and formats";
  description = ''Settings for one user. Unset values preserve existing policy and preferences.'';
  tags = [ "users" "locale" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

language = {
  _meta = {
    name = "Default language and regional format";
    summary = "Default language and regional format";
    description = ''Default language and regional format. The requested locale must be available on the machine; this does not install system locales. Null leaves this preference unchanged.'';
    tags = [ "users" "locale" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.string) $type.null ];
    default = null;
  };
  u!! {
    home.language.base = $lib.mkIf ($path.language != null) ($path.language);
  };
};

messageLanguage = {
  _meta = {
