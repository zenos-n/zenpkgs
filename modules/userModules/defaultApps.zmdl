_meta = {
  zenosVersion = 1.0.0Na;
  name = "Default applications";
  summary = "Default applications";
  description = ''Settings for one user. Unset values preserve existing policy and preferences.'';
  tags = [ "users" "defaultApps" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

enable = {
  _meta = {
    name = "Manage default applications";
    summary = "Manage default applications";
    description = ''Manage default applications. Null leaves this preference unchanged.'';
    tags = [ "users" "defaultApps" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
  };
  u!! {
    xdg.mimeApps.enable = $lib.mkIf ($path.enable != null) ($path.enable);
  };
};

browser = {
  _meta = {
    name = "Desktop application for browser";
    summary = "Desktop application for browser";
    description = ''Desktop application for browser. An installed .desktop file ID, such as org.gnome.Nautilus.desktop. Requires defaultApps.enable = true; does not install the application. Null leaves this preference unchanged.'';
    tags = [ "users" "defaultApps" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.string) $type.null ];
    default = null;
  };
  u!! {
    xdg.mimeApps.defaultApplications."text/html" = $lib.mkIf ($path.browser != null) ([ $path.browser ]);
    xdg.mimeApps.defaultApplications."x-scheme-handler/http" = $lib.mkIf ($path.browser != null) ([ $path.browser ]);
    xdg.mimeApps.defaultApplications."x-scheme-handler/https" = $lib.mkIf ($path.browser != null) ([ $path.browser ]);
  };
};

