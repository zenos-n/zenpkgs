# Source: hm-modules/janitor/module.nix
# Unsupported: nested watched-directory submodules cannot be typed in production ZMDL.
# Unsupported: builtins.toJSON/writeText generation for janitor_config.json is unavailable.
# Unsupported: all three user services are omitted because their ExecStart requires that generated file.
_meta = {
  zenosVersion = 1.0.0Na;
  id = "users.programs.janitor";
  brief = "Automated organization for ZenOS user directories";
  description = ''
    Declares rule-based sorting, virtual music-library, and machine-learning
    Janitor controls. Service activation remains blocked on generated JSON support.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.brief = "Enable the ZenFS Janitor service";
};

dumb.enable = {
  _meta = { type = $type.boolean; default = false; brief = "Enable rule-based file sorting"; };
};

dumb.batchInterval = {
  _meta = {
    type = $type.string;
    default = "5m";
    brief = "Batch processing idle interval";
    example = "5m";
  };
};

dumb.gracePeriod = {
  _meta = {
    type = $type.string;
    default = "15m";
    brief = "Minimum batch age before processing";
    example = "15m";
  };
};

dumb.watchedDirs = {
  _meta = {
    default = { };
    brief = "Directories monitored for rule-based sorting";
    description = "Freeform directory records containing target-to-extension rule maps.";
  };
};

music.enable = {
  _meta = { type = $type.boolean; default = false; brief = "Enable the music FUSE library"; };
};

music.sourceDir = {
  _meta = { type = $type.string; brief = "Source directory for raw music files"; };
};

music.mountPoint = {
  _meta = { type = $type.string; brief = "Music-library FUSE mount point"; };
};

music.artistSplitSymbols = {
  _meta = {
    type = $type.list [ $type.string ];
    default = [ ";" "," " feat. " "zenfs-reg:\\s*(?:ft\\.|feat)\\s*" ];
    brief = "Delimiters for multi-artist tags";
  };
};

ml.enable = {
  _meta = { type = $type.boolean; default = false; brief = "Enable machine-learning classification"; };
};
