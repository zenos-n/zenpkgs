_meta = {
  zenosVersion = 1.0.0Na;
  brief = "An i3-style workspace bar for GNOME Shell";
  description = ''
    An i3-style workspace bar for GNOME Shell

    This module installs and configures the **Space Bar** extension for GNOME.
    It replaces the Activities button with a highly configurable workspace
    indicator reminiscent of i3/sway status bars.

    **Features:**
    - i3-like workspace indicator.
    - Extensive customization for active, inactive, and empty workspaces.
    - Custom labels and scroll wheel navigation.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Space Bar GNOME extension configuration";
  s! {
    environment.systemPackages = [ $pkgs.zenos.legacy.gnomeExtensions.space-bar ];
    programs.dconf.profiles.user.databases = [ {
      settings = {
        "org/gnome/shell/extensions/space-bar/state" = {
          version = $path.state.version;
          workspace-names-map = $path.state.workspace-names-map;
        };
        "org/gnome/shell/extensions/space-bar/behavior" = {
          smart-workspace-names = $path.behavior.smart-workspace-names;
          always-show-numbers = $path.behavior.always-show-numbers;
          scroll-wheel = $path.behavior.scroll-wheel;
        };
        "org/gnome/shell/extensions/space-bar/appearance" = {
          position = $path.appearance.position;
          application-styles = $path.appearance.styles.application;
          custom-styles-enabled = $path.appearance.styles.custom.enable;
          custom-styles-failed = $path.appearance.styles.custom.failed;
          custom-styles = $path.appearance.styles.custom.css;
        };
        "org/gnome/shell/extensions/space-bar/shortcuts" = {
          enable-activate-workspace-shortcuts = $path.shortcuts.enable-activate;
          back-and-forth = $path.shortcuts.back-and-forth;
          enable-move-to-workspace-shortcuts = $path.shortcuts.enable-move-to;
          move-workspace-left = $path.shortcuts.move-left;
          move-workspace-right = $path.shortcuts.move-right;
          activate-previous-key = $path.shortcuts.activate-previous;
          activate-empty-key = $path.shortcuts.activate-empty;
          open-menu = $path.shortcuts.open-menu;
          activate-1-key = $path.shortcuts.activate-1;
          activate-2-key = $path.shortcuts.activate-2;
          activate-3-key = $path.shortcuts.activate-3;
          activate-4-key = $path.shortcuts.activate-4;
          activate-5-key = $path.shortcuts.activate-5;
          activate-6-key = $path.shortcuts.activate-6;
          activate-7-key = $path.shortcuts.activate-7;
          activate-8-key = $path.shortcuts.activate-8;
          activate-9-key = $path.shortcuts.activate-9;
        };
      };
    } ];
  };
};

state.version = { _meta = { type = $type.int; default = 0; description = "Internal version tracker for settings migrations"; }; };
state.workspace-names-map = { _meta = { type = $type.string; default = "{}"; description = ''
  Custom workspace name dictionary

  JSON string mapping workspace indices to human-readable labels
  (e.g., '{"1": "Web", "2": "Dev"}').
''; }; };
behavior.smart-workspace-names = { _meta = { type = $type.bool; default = true; description = ''
  Automatic workspace naming

  Whether the extension should attempt to name workspaces based
  on the focused application.
''; }; };
behavior.always-show-numbers = { _meta = { type = $type.bool; default = false; description = ''
  Force numerical labels

  Whether to always display the workspace index number even if a
  custom name is assigned.
''; }; };
behavior.scroll-wheel = { _meta = { type = $type.enum [ "disabled" "panel" "bar" ]; default = "panel"; description = ''
  Workspace scrolling behavior

  Determines where mouse scrolling triggers a workspace switch
  (e.g., anywhere on the panel or only on the workspace bar).
''; }; };
appearance.position = { _meta = { type = $type.enum [ "left" "center" "right" ]; default = "left"; description = "Horizontal placement of the workspace bar in the GNOME panel"; }; };
appearance.styles.application = { _meta = { type = $type.enum [ "none" "icon" "name" "both" ]; default = "none"; description = "Visual representation of open apps within the workspace tags"; }; };
appearance.styles.custom.enable = { _meta = { type = $type.bool; default = false; description = "Activate CSS style overrides"; }; };
appearance.styles.custom.css = { _meta = { type = $type.lines; default = ""; description = "Custom CSS injected into the workspace bar UI"; }; };
appearance.styles.custom.failed = { _meta = { type = $type.bool; default = false; description = "Internal flag indicating CSS parsing errors"; }; };
shortcuts.enable-activate = { _meta = { type = $type.bool; default = true; description = "Enable Super+Num shortcuts to switch workspaces"; }; };
shortcuts.enable-move-to = { _meta = { type = $type.bool; default = true; description = "Enable Shift+Super+Num shortcuts to move windows"; }; };
shortcuts.back-and-forth = { _meta = { type = $type.bool; default = false; description = "Toggle to previous workspace if current index is requested"; }; };
shortcuts.move-left = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super><Alt>Left" ]; description = "Shortcut to shift workspace focus leftward"; }; };
shortcuts.move-right = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super><Alt>Right" ]; description = "Shortcut to shift workspace focus rightward"; }; };
shortcuts.activate-previous = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>Escape" ]; description = "Shortcut to return to the last active workspace"; }; };
shortcuts.activate-empty = { _meta = { type = $type.list [ $type.string ]; default = [ ]; description = "Shortcut to switch focus to the first empty workspace"; }; };
shortcuts.open-menu = { _meta = { type = $type.list [ $type.string ]; default = [ ]; description = "Shortcut to reveal the Space Bar settings menu"; }; };
shortcuts.activate-1 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>1" ]; description = "Shortcut to focus workspace 1"; }; };
shortcuts.activate-2 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>2" ]; description = "Shortcut to focus workspace 2"; }; };
shortcuts.activate-3 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>3" ]; description = "Shortcut to focus workspace 3"; }; };
shortcuts.activate-4 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>4" ]; description = "Shortcut to focus workspace 4"; }; };
shortcuts.activate-5 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>5" ]; description = "Shortcut to focus workspace 5"; }; };
shortcuts.activate-6 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>6" ]; description = "Shortcut to focus workspace 6"; }; };
shortcuts.activate-7 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>7" ]; description = "Shortcut to focus workspace 7"; }; };
shortcuts.activate-8 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>8" ]; description = "Shortcut to focus workspace 8"; }; };
shortcuts.activate-9 = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>9" ]; description = "Shortcut to focus workspace 9"; }; };
