# Production ZMDL has no submodule type constructor. The global settings
# submodule is expanded into typed nested options; custom-settings retains its
# outer and inner attribute-set shape but cannot enforce per-application fields.
_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Consistent corner rounding for all window types in GNOME";
  description = ''
    Consistent corner rounding for all window types in GNOME

    This module installs and configures **Rounded Window Corners Reborn**. It brings
    consistent rounded corners to all applications, including legacy GTK3/4
    and non-GTK windows.

    **Features:**
    - Global corner rounding with custom radius.
    - Per-application setting overrides.
    - Custom shadow and border configurations.
    - Special tweaks for Kitty terminal compatibility.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

_let toRgbaList: $type.function [ $type.string ] = value:
  if $lib.isString value && $lib.hasPrefix "#" value then
    let
      hex = $lib.removePrefix "#" value;
      red = ($lib.fromHexString ($lib.substring 0 2 hex)) / 255.0;
      green = ($lib.fromHexString ($lib.substring 2 2 hex)) / 255.0;
      blue = ($lib.fromHexString ($lib.substring 4 2 hex)) / 255.0;
      alpha = if $lib.stringLength hex == 8
        then ($lib.fromHexString ($lib.substring 6 2 hex)) / 255.0
        else 1.0;
    in [ red green blue alpha ]
  else value;
_let toVariant: $type.function "value" =
  let
    convert = value:
      if $lib.isAttrs value && !($lib.gvariant.isGVariant value) then
        if value == { } then $lib.gvariant.mkEmptyArray "{sv}"
        else $lib.gvariant.mkArray ($lib.mapAttrsToList
          (key: item: $lib.gvariant.mkDictionaryEntry key ($lib.gvariant.mkVariant (convert item))) value)
      else if $lib.isInt value then $lib.gvariant.mkInt32 value
      else $lib.gvariant.mkValue value;
  in convert;
_let shadow: $type.function "json" = json:
  $lib.gvariant.mkArray ($lib.mapAttrsToList
    (key: value: $lib.gvariant.mkDictionaryEntry key ($lib.gvariant.mkInt32 value))
    ($lib.fromJSON json));

enable = enableOption {
  _meta.description = ''Rounded Window Corners Reborn configuration'';
  s! {
    environment.systemPackages = [ $pkgs.apps.gnome-extensions.rounded-window-corners-reborn ];
  };
  u! {
    dconf.settings."org/gnome/shell".enabled-extensions = [ $pkgs.apps.gnome-extensions.rounded-window-corners-reborn.extensionUuid ];
    dconf.settings."org/gnome/shell/extensions/rounded-window-corners-reborn" = {
        border-width = $lib.gvariant.mkInt32 $path.settings.border-size;
        settings-version = $lib.gvariant.mkUint32 $path.general.settings-version;
        skip-libadwaita-app = $path.skip-libadwaita-app;
        debug-mode = $path.general.debug;
        tweak-kitty-terminal = $path.general.tweak-kitty;
        global-rounded-corner-settings = $v.toVariant {
          padding = $lib.mapAttrs (_: value: $lib.gvariant.mkUint32 value) $path.settings.padding;
          keepRoundedCorners = {
            maximized = $path.settings.keep-rounded-corners;
            fullscreen = $path.settings.keep-rounded-corners;
          };
          borderRadius = $lib.gvariant.mkUint32 $path.settings.border-radius;
          smoothing = $path.settings.smoothing;
          borderColor = $v.toRgbaList $path.settings.border-color;
          enabled = true;
        };
        custom-rounded-corner-settings = $v.toVariant $path.custom-settings;
      }
      // ($lib.optionalAttrs ($path.focused-shadow != "{}") { focused-shadow = $v.shadow $path.focused-shadow; })
      // ($lib.optionalAttrs ($path.unfocused-shadow != "{}") { unfocused-shadow = $v.shadow $path.unfocused-shadow; });
  };
};

skip-libadwaita-app = { _meta = { type = $type.bool; default = false; description = ''
  Ignore modern Libadwaita applications

  Whether to skip applications that already provide their own
  native corner rounding.
''; }; };
focused-shadow = { _meta = { type = $type.string; default = "{}"; description = ''JSON configuration for active window drop shadows''; }; };
unfocused-shadow = { _meta = { type = $type.string; default = "{}"; description = ''JSON configuration for inactive window drop shadows''; }; };
general.debug = { _meta = { type = $type.bool; default = false; description = ''Enable verbose console debugging''; }; };
general.settings-version = { _meta = { type = $type.int; default = 7; description = ''Version of the rounded-corner settings schema''; }; };
general.tweak-kitty = { _meta = { type = $type.bool; default = false; description = ''Enable specialized rendering hacks for Kitty terminal''; }; };
general.preferences-entry = { _meta = { type = $type.bool; default = true; description = ''Display extension settings in the app grid''; }; };

settings.padding = { _meta = { type = $type.set [ $type.int ]; default = { left = 1; right = 1; top = 1; bottom = 1; }; description = ''Internal padding values''; }; };
settings.keep-rounded-corners = { _meta = { type = $type.bool; default = false; description = ''Preserve rounding for maximized windows''; }; };
settings.border-size = { _meta = { type = $type.int; default = 0; description = ''Outer pixel border thickness''; }; };
settings.border-color = { _meta = { type = $type.either [ ($type.list [ $type.float ]) $type.string ]; default = [ 1.0 1.0 1.0 1.0 ]; description = ''CSS color for the border''; }; };
settings.border-radius = { _meta = { type = $type.int; default = 12; description = ''Pixel radius for corner rounding''; }; };
settings.smoothing = { _meta = { type = $type.float; default = 0.0; description = ''Curvature smoothing factor (anti-aliasing)''; }; };

custom-settings = {
  _meta = {
    type = $type.set [ $type.set ];
    default = { };
    description = ''
      Per-application visual overrides

      Dictionary mapping application IDs to specific rounding
      and border configurations.
    '';
  };
};
