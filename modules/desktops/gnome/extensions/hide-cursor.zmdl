_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Automatic mouse cursor suppression for GNOME Shell";
  description = ''
    Automatic mouse cursor suppression for GNOME Shell

    This module installs and configures the **Hide Cursor** extension for GNOME.
    It automatically hides the mouse cursor after a specified period of inactivity,
    useful for focused reading or media consumption.

    **Features:**
    - Configurable idle timeout.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = ''Whether to enable Hide Cursor GNOME extension configuration.'';
  s! {
    environment.systemPackages = [ $pkgs.apps.gnome-extensions.hide-cursor ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/hide-cursor-elcste-com".timeout = $path.timeout;
    } ];
  };
};

timeout = {
  _meta = {
    type = $type.int;
    default = 5;
    description = ''
      Idle threshold for cursor hiding

      Specifies the number of seconds of mouse inactivity before
      the cursor is automatically concealed.
    '';
  };
};
