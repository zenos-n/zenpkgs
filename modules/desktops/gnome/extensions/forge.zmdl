keybindings.window-resize-top-increase = { _meta = { type = $type.list [ $type.string ]; default = [ "ctrl" "super" "i" ]; description = ''Resize window upwards

Define as a list of keys, e.g., [ "super" "q" ].
Supported modifiers: super, ctrl, alt, shift.''; }; };
