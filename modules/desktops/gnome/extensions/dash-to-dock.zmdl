_meta = {
  zenosVersion = 1.0.0Na;
  brief = "Highly configurable dock interface for GNOME Shell";
  description = ''
    Highly configurable dock interface for GNOME Shell

    This module installs and configures the **Dash to Dock** extension for GNOME.
    It transforms the dash into a highly configurable dock that can be placed
    on any edge of the screen.

    **Features:**
    - Configurable position, size, and visibility behavior.
    - Intelligent hiding (intellihide) to dodge windows.
    - Custom click actions and scroll behaviors.
    - Extensive styling options (transparency, running indicators).
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Whether to enable Dash to Dock GNOME extension configuration.";
  s! {
    environment.systemPackages = [ $pkgs.zenos.legacy.gnomeExtensions.dash-to-dock ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/dash-to-dock" = {
        dock-position = $path.layout.position;
        preferred-monitor = $path.layout.monitor.preferred;
        preferred-monitor-by-connector = $path.layout.monitor.connector;
        multi-monitor = $path.layout.monitor.multi-monitor;
        height-fraction = $path.layout.height.fraction;
        extend-height = $path.layout.height.extend;
        dash-max-icon-size = $path.layout.icons.size;
        icon-size-fixed = $path.layout.icons.fixed;
        always-center-icons = $path.layout.icons.center;
        apply-custom-theme = $path.appearance.theme.apply-custom;
        custom-theme-shrink = $path.appearance.theme.shrink;
        apply-glossy-effect = $path.appearance.theme.glossy;
        force-straight-corner = $path.appearance.theme.straight-corner;
        unity-backlit-items = $path.appearance.unity-backlit;
        background-color = $path.appearance.background.color;
        custom-background-color = $path.appearance.background.custom-color;
        background-opacity = $path.appearance.background.opacity;
        transparency-mode = $path.appearance.background.transparency-mode;
        customize-alphas = $path.appearance.background.customize-alphas;
        min-alpha = $path.appearance.background.min-alpha;
        max-alpha = $path.appearance.background.max-alpha;
        running-indicator-style = $path.appearance.running-indicator.style;
        running-indicator-dominant-color = $path.appearance.running-indicator.dominant-color;
        custom-theme-customize-running-dots = $path.appearance.running-indicator.custom-dots.enable;
        custom-theme-running-dots-color = $path.appearance.running-indicator.custom-dots.color;
        custom-theme-running-dots-border-color = $path.appearance.running-indicator.custom-dots.border-color;
        custom-theme-running-dots-border-width = $path.appearance.running-indicator.custom-dots.border-width;
        autohide = $path.behavior.visibility.autohide;
        manualhide = $path.behavior.visibility.manualhide;
        dock-fixed = $path.behavior.visibility.fixed;
        intellihide = $path.behavior.visibility.intellihide.enable;
        intellihide-mode = $path.behavior.visibility.intellihide.mode;
        autohide-in-fullscreen = $path.behavior.visibility.fullscreen-autohide;
        show-dock-urgent-notify = $path.behavior.visibility.urgent-notify;
        animation-time = $path.behavior.timing.animation-time;
        show-delay = $path.behavior.timing.show-delay;
        hide-delay = $path.behavior.timing.hide-delay;
        require-pressure-to-show = $path.behavior.pressure.enable;
        pressure-threshold = $path.behavior.pressure.threshold;
        click-action = $path.behavior.actions.click;
        shift-click-action = $path.behavior.actions.shift-click;
        middle-click-action = $path.behavior.actions.middle-click;
        shift-middle-click-action = $path.behavior.actions.shift-middle-click;
        scroll-action = $path.behavior.actions.scroll;
        scroll-switch-workspace = $path.behavior.scrolling.switch-workspace;
        minimize-shift = $path.behavior.minimize-shift;
        isolate-workspaces = $path.behavior.isolate.workspaces;
        isolate-monitors = $path.behavior.isolate.monitors;
        isolate-locations = $path.behavior.isolate.locations;
        show-favorites = $path.content.show-favorites;
        show-running = $path.content.show-running;
        show-trash = $path.content.show-trash;
        show-mounts = $path.content.show-mounts;
        show-mounts-network = $path.content.show-mounts-network;
        show-mounts-only-mounted = $path.content.show-mounts-only-mounted;
        show-windows-preview = $path.content.show-windows-preview;
        show-show-apps-button = $path.content.apps-button.show;
        show-apps-at-top = $path.content.apps-button.at-top;
        show-apps-always-in-the-edge = $path.content.apps-button.always-in-edge;
        hot-keys = $path.shortcuts.enable;
        hotkeys-show-dock = $path.shortcuts.show-dock;
        hotkeys-overlay = $path.shortcuts.overlay;
        shortcut-timeout = $path.shortcuts.timeout;
        shortcut = $path.shortcuts.toggle-shortcut;
        shortcut-text = if $lib.length $path.shortcuts.toggle-shortcut > 0 then $lib.head $path.shortcuts.toggle-shortcut else "";
        disable-overview-on-startup = $path.disable-overview-on-startup;
        bolt-support = $path.bolt-support;
      };
    } ];
  };
};

layout.position = { _meta = { type = $type.enum [ "BOTTOM" "TOP" "LEFT" "RIGHT" ]; default = "BOTTOM"; description = "Screen edge where the dock is anchored"; }; };
layout.monitor.preferred = { _meta = { type = $type.int; default = -2; description = "Monitor index (-2 for primary)"; }; };
layout.monitor.connector = { _meta = { type = $type.string; default = "primary"; description = "Monitor hardware connector ID"; }; };
layout.monitor.multi-monitor = { _meta = { type = $type.bool; default = false; description = "Show dock on all available screens"; }; };
layout.height.fraction = { _meta = { type = $type.float; default = 0.90; description = "Maximum dock size relative to screen edge"; }; };
layout.height.extend = { _meta = { type = $type.bool; default = false; description = "Expand the dock to fill the entire screen edge"; }; };
layout.icons.size = { _meta = { type = $type.int; default = 48; description = "Target pixel size for application icons"; }; };
layout.icons.fixed = { _meta = { type = $type.bool; default = false; description = "Prevent the dock from shrinking icons"; }; };
layout.icons.center = { _meta = { type = $type.bool; default = false; description = "Keep icons centered when in panel mode"; }; };
appearance.theme.apply-custom = { _meta = { type = $type.bool; default = false; description = "Enable shell theme overrides"; }; };
appearance.theme.shrink = { _meta = { type = $type.bool; default = false; description = "Remove extra padding around the dock"; }; };
appearance.theme.glossy = { _meta = { type = $type.bool; default = true; description = "Apply a visual glossy effect to icons"; }; };
appearance.theme.straight-corner = { _meta = { type = $type.bool; default = false; description = "Disable corner rounding for the dock background"; }; };
appearance.background.color = { _meta = { type = $type.string; default = "#ffffff"; description = "Hex color for the dock background"; }; };
appearance.background.custom-color = { _meta = { type = $type.bool; default = false; description = "Force use of the custom background color"; }; };
appearance.background.opacity = { _meta = { type = $type.float; default = 0.8; description = "Fixed background alpha transparency"; }; };
appearance.background.transparency-mode = { _meta = { type = $type.enum [ "DEFAULT" "FIXED" "DYNAMIC" "ADAPTIVE" ]; default = "DEFAULT"; description = "Alpha blending logic for the dock background"; }; };
appearance.background.customize-alphas = { _meta = { type = $type.bool; default = false; description = "Manually override min/max opacity levels"; }; };
appearance.background.min-alpha = { _meta = { type = $type.float; default = 0.2; description = "Minimum opacity when windows are not near"; }; };
appearance.background.max-alpha = { _meta = { type = $type.float; default = 0.8; description = "Maximum opacity when windows overlap"; }; };
appearance.running-indicator.style = { _meta = { type = $type.enum [ "DEFAULT" "DOTS" "DASHES" "SOLID" "CILIORA" "METRO" ]; default = "DEFAULT"; description = "Visual style of the active application marker"; }; };
appearance.running-indicator.dominant-color = { _meta = { type = $type.bool; default = false; description = "Inherit indicator color from the app icon"; }; };
appearance.running-indicator.custom-dots.enable = { _meta = { type = $type.bool; default = false; description = "Manual marker color configuration"; }; };
appearance.running-indicator.custom-dots.color = { _meta = { type = $type.string; default = "#ffffff"; description = "Marker fill color"; }; };
appearance.running-indicator.custom-dots.border-color = { _meta = { type = $type.string; default = "#ffffff"; description = "Marker outline color"; }; };
appearance.running-indicator.custom-dots.border-width = { _meta = { type = $type.int; default = 0; description = "Marker outline pixel thickness"; }; };
appearance.unity-backlit = { _meta = { type = $type.bool; default = false; description = "Glow effects behind active icons"; }; };
behavior.visibility.autohide = { _meta = { type = $type.bool; default = true; description = "Hide when the cursor is not near the edge"; }; };
behavior.visibility.manualhide = { _meta = { type = $type.bool; default = false; description = "Require explicit toggle for visibility"; }; };
behavior.visibility.fixed = { _meta = { type = $type.bool; default = false; description = "Always keep the dock visible"; }; };
behavior.visibility.intellihide.enable = { _meta = { type = $type.bool; default = true; description = "Avoid overlapping application windows"; }; };
behavior.visibility.intellihide.mode = { _meta = { type = $type.enum [ "FOCUS_APPLICATION_WINDOWS" "ALL_WINDOWS" "MAXIMIZED_WINDOWS" ]; default = "FOCUS_APPLICATION_WINDOWS"; description = "Intellihide behavior policy"; }; };
behavior.visibility.fullscreen-autohide = { _meta = { type = $type.bool; default = false; description = "Hide the dock for fullscreen media/games"; }; };
behavior.visibility.urgent-notify = { _meta = { type = $type.bool; default = true; description = "Show dock when apps request attention"; }; };
behavior.timing.animation-time = { _meta = { type = $type.float; default = 0.2; description = "Visual transition duration"; }; };
behavior.timing.show-delay = { _meta = { type = $type.float; default = 0.25; description = "Pause before revealing the hidden dock"; }; };
behavior.timing.hide-delay = { _meta = { type = $type.float; default = 0.20; description = "Pause before concealing the visible dock"; }; };
behavior.pressure.enable = { _meta = { type = $type.bool; default = true; description = "Require cursor pressure to trigger revealing"; }; };
behavior.pressure.threshold = { _meta = { type = $type.float; default = 100.0; description = "Trigger threshold for edge pressure"; }; };
behavior.actions.click = { _meta = { type = $type.string; default = "cycle-windows"; description = "Standard click action"; }; };
behavior.actions.shift-click = { _meta = { type = $type.string; default = "minimize"; description = "Action for Shift+Click"; }; };
behavior.actions.middle-click = { _meta = { type = $type.string; default = "launch"; description = "Action for Middle Click"; }; };
behavior.actions.shift-middle-click = { _meta = { type = $type.string; default = "launch"; description = "Action for Shift+Middle Click"; }; };
behavior.actions.scroll = { _meta = { type = $type.string; default = "do-nothing"; description = "Action for mouse scroll on icon"; }; };
behavior.scrolling.switch-workspace = { _meta = { type = $type.bool; default = true; description = "Change desktop by scrolling on the dock"; }; };
behavior.minimize-shift = { _meta = { type = $type.bool; default = true; description = "Hide windows when clicking with Shift"; }; };
behavior.isolate.workspaces = { _meta = { type = $type.bool; default = false; description = "Filter apps by current desktop"; }; };
behavior.isolate.monitors = { _meta = { type = $type.bool; default = false; description = "Filter apps by hardware display"; }; };
behavior.isolate.locations = { _meta = { type = $type.bool; default = true; description = "Separate trash and mount indicators"; }; };
content.show-favorites = { _meta = { type = $type.bool; default = true; description = "Display pinned applications"; }; };
content.show-running = { _meta = { type = $type.bool; default = true; description = "Display active windows"; }; };
content.show-trash = { _meta = { type = $type.bool; default = true; description = "Display the trash can icon"; }; };
content.show-mounts = { _meta = { type = $type.bool; default = true; description = "Display external storage icons"; }; };
content.show-mounts-network = { _meta = { type = $type.bool; default = false; description = "Display remote network shares"; }; };
content.show-mounts-only-mounted = { _meta = { type = $type.bool; default = true; description = "Hide unmounted device placeholders"; }; };
content.show-windows-preview = { _meta = { type = $type.bool; default = true; description = "Render live thumbnails on interaction"; }; };
content.apps-button.show = { _meta = { type = $type.bool; default = true; description = "Display the application grid button"; }; };
content.apps-button.at-top = { _meta = { type = $type.bool; default = false; description = "Anchor apps button to the start of the dock"; }; };
content.apps-button.always-in-edge = { _meta = { type = $type.bool; default = true; description = "Keep apps button fixed to screen corner"; }; };
shortcuts.enable = { _meta = { type = $type.bool; default = true; description = "Enable Super+Num launch keys"; }; };
shortcuts.show-dock = { _meta = { type = $type.bool; default = true; description = "Show dock when hotkey is triggered"; }; };
shortcuts.overlay = { _meta = { type = $type.bool; default = true; description = "Display key numbers over icons"; }; };
shortcuts.timeout = { _meta = { type = $type.float; default = 2.0; description = "Duration of the numbers overlay"; }; };
shortcuts.toggle-shortcut = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>q" ]; description = "Shortcut to show/hide dock"; }; };
disable-overview-on-startup = { _meta = { type = $type.bool; default = false; description = "Skip overview after login"; }; };
bolt-support = { _meta = { type = $type.bool; default = true; description = "Compatibility for bolt extensions"; }; };
