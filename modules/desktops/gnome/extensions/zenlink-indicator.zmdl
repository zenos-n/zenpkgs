_meta = {
  zenosVersion = 1.0.0Nb;
  summary = "Enable ZenLink's integrated GNOME extension";
  description = ''Compatibility selector for system.programs.zenlink, which installs the complete desktop service and extension.'';
  maintainers = [ $m.doromiert ];
  license = $l.gpl2Plus;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  s! { zenos.system.programs.zenlink.enable = true; };
};
