_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Retro 'Magic Lamp' window animation for GNOME";
  description = ''
    Retro 'Magic Lamp' window animation for GNOME

    This module installs and configures the **Compiz Alike Magic Lamp Effect** extension for GNOME. It recreates the classic "Magic Lamp" window
    minimization effect found in Compiz and macOS.

    **Features:**
    - Configurable animation duration.
    - Adjustable grid density (tiles) for smoother or faster animations.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = ''Whether to enable Compiz Alike Magic Lamp Effect GNOME extension configuration.'';
  s! {
    environment.systemPackages = [ $pkgs.apps.gnome-extensions.compiz-alike-magic-lamp-effect ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/com/github/hermes83/compiz-alike-magic-lamp-effect" = {
        effect = $path.effect;
        duration = $path.duration;
        x-tiles = $path.x-tiles;
        y-tiles = $path.y-tiles;
      };
    } ];
  };
};

effect = { _meta = { type = $type.string; default = "default"; description = ''
  Animation effect variant

  Specifies the specific variant of the lamp effect to apply to windows.
''; }; };
duration = { _meta = { type = $type.float; default = 400.0; description = ''
  Animation time in milliseconds

  Total duration for the window to transition between visible and minimized states.
''; }; };
x-tiles = { _meta = { type = $type.float; default = 10.0; description = ''
  Horizontal mesh density

  Number of horizontal tiles used to construct the deformation mesh.
  Higher values produce smoother animations but increase CPU load.
''; }; };
y-tiles = { _meta = { type = $type.float; default = 10.0; description = ''
  Vertical mesh density

  Number of vertical tiles used to construct the deformation mesh.
''; }; };
