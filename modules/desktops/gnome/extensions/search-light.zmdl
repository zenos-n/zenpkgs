_meta = {
  zenosVersion = 1.0.0Na;
  brief = "Spotlight-style search overlay for GNOME Shell";
  description = ''
    Spotlight-style search overlay for GNOME Shell

    This module installs and configures the **Search Light** extension for GNOME.
    It replaces the default search with a macOS Spotlight-like search overlay,
    centered on the screen with customizable styling and shortcuts.

    **Features:**
    - Spotlight-like search interface.
    - Customizable appearance (colors, borders, transparency, blur).
    - Configurable keyboard shortcuts.
    - Unit and currency converters.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Search Light GNOME extension configuration";
  s! {
    environment.systemPackages = [ $pkgs.zenos.legacy.gnomeExtensions.search-light ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/search-light" = {
        border-radius = $path.border-radius;
        border-color = $path.border-color;
        border-thickness = $path.border-thickness;
        background-color = $path.background-color;
        scale-width = $path.scale-width;
        scale-height = $path.scale-height;
        preferred-monitor = $path.preferred-monitor;
        monitor-count = $path.monitor-count;
        shortcut-search = $path.shortcut-search;
        secondary-shortcut-search = $path.secondary-shortcut-search;
        popup-at-cursor-monitor = $path.popup-at-cursor-monitor;
        blur-background = $path.blur-background;
        blur-sigma = $path.blur-sigma;
        blur-brightness = $path.blur-brightness;
        font-size = $path.font-size;
        entry-font-size = $path.entry-font-size;
        text-color = $path.text-color;
        show-panel-icon = $path.show-panel-icon;
        unit-converter = $path.unit-converter;
        currency-converter = $path.currency-converter;
      };
    } ];
  };
};

border-radius = { _meta = { type = $type.float; default = 0.0; description = ''
  Visual corner rounding radius

  Pixel radius for the search overlay corners. Defaults to 0 for
  sharp square corners.
''; }; };
border-color = { _meta = { type = $type.string; default = "(1.0,1.0,1.0,1.0)"; description = ''
  Search overlay border color

  GVariant tuple defining the RGBA components of the overlay border.
''; }; };
border-thickness = { _meta = { type = $type.int; default = 0; description = ''
  Search overlay border width

  Pixel thickness of the border drawn around the search interface.
''; }; };
background-color = { _meta = { type = $type.string; default = "(0.0,0.0,0.0,0.9)"; description = ''
  Search overlay background color

  GVariant tuple defining the RGBA components of the primary
  search window background.
''; }; };
scale-width = { _meta = { type = $type.float; default = 0.5; description = "Window width relative to the monitor width (0.0 - 1.0)"; }; };
scale-height = { _meta = { type = $type.float; default = 0.4; description = "Window height relative to the monitor height (0.0 - 1.0)"; }; };
preferred-monitor = { _meta = { type = $type.int; default = -1; description = ''
  Target display index

  The monitor index where the search box should appear (-1 for
  primary monitor).
''; }; };
monitor-count = { _meta = { type = $type.int; default = 1; description = "Internal state tracker for available system monitors"; }; };
shortcut-search = { _meta = { type = $type.list [ $type.string ]; default = [ "<Super>space" ]; description = "Primary keyboard shortcut to trigger the search overlay"; }; };
secondary-shortcut-search = { _meta = { type = $type.list [ $type.string ]; default = [ ]; description = "Alternative shortcut to trigger the search overlay"; }; };
popup-at-cursor-monitor = { _meta = { type = $type.bool; default = true; description = ''
  Reveal overlay at mouse location

  Whether to display the search box on the monitor currently
  containing the mouse pointer.
''; }; };
blur-background = { _meta = { type = $type.bool; default = true; description = ''
  Enable background blur

  Applies a gaussian blur effect to the desktop area behind the
  search overlay.
''; }; };
blur-sigma = { _meta = { type = $type.int; default = 30; description = "Gaussian sigma value determining the strength of the blur"; }; };
blur-brightness = { _meta = { type = $type.float; default = 0.6; description = "Luminance multiplier for the blurred background area"; }; };
font-size = { _meta = { type = $type.int; default = 12; description = "Base pixel font size for search results and metadata"; }; };
entry-font-size = { _meta = { type = $type.int; default = 24; description = "Large pixel font size for the active search input field"; }; };
text-color = { _meta = { type = $type.string; default = "(1.0,1.0,1.0,1.0)"; description = "GVariant tuple defining the RGBA color of the result text"; }; };
show-panel-icon = { _meta = { type = $type.bool; default = true; description = ''
  Display top bar status icon

  Whether to show the Search Light icon in the GNOME panel for
  mouse interaction.
''; }; };
unit-converter = { _meta = { type = $type.bool; default = true; description = "Enable real-time unit conversion inside the search results"; }; };
currency-converter = { _meta = { type = $type.bool; default = true; description = "Enable real-time currency conversion inside the search results"; }; };
