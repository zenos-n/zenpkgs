_meta = {
  zenosVersion = 1.0.0Na;
  brief = "System tray icon support for the GNOME top bar";
  description = ''
    System tray icon support for the GNOME top bar

    This module installs and configures the **AppIndicator and KStatusNotifierItem Support** extension for GNOME. It re-enables the system tray, allowing applications to
    display icons and menus in the top bar.

    **Features:**
    - Restores legacy tray icon support.
    - Customizable icon appearance (saturation, brightness, opacity).
    - Configurable tray positioning.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

_let mkGVariantString: $type.function "string" = v: "'${v}'";
_let serializeTuple: $type.function "tuple" = tuple:
  $lib.throwIfNot ($lib.length tuple == 3)
    "Custom icon tuple must have exactly 3 strings: [ id icon path ]"
    "(${$lib.concatStringsSep ", " ($lib.map $v.mkGVariantString tuple)})";
_let serializeCustomIcons: $type.function "icons" = icons:
  if icons == [ ] then "@a(sss) []"
  else "[${$lib.concatStringsSep ", " ($lib.map $v.serializeTuple icons)}]";

enable = enableOption {
  _meta.description = "Whether to enable AppIndicator GNOME extension configuration.";
  s! {
    environment.systemPackages = [ $pkgs.zenos.legacy.gnomeExtensions.appindicator ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/appindicator" = {
        legacy-tray-enabled = $path.legacy-tray-enabled;
        icon-saturation = $path.icon-saturation;
        icon-brightness = $path.icon-brightness;
        icon-contrast = $path.icon-contrast;
        icon-opacity = $path.icon-opacity;
        icon-size = $path.icon-size;
        icon-spacing = $path.icon-spacing;
        tray-pos = $path.tray-pos;
        tray-order = $path.tray-order;
      };
    } ];
    systemd.user.services.appindicator-setup = {
      description = "Apply AppIndicator specific configuration";
      wantedBy = [ "graphical-session.target" ];
      partOf = [ "graphical-session.target" ];
      serviceConfig = { Type = "oneshot"; RemainAfterExit = true; };
      script = ''
        ${$pkgs.zenos.legacy.dconf}/bin/dconf write /org/gnome/shell/extensions/appindicator/custom-icons ${$lib.escapeShellArg ($v.serializeCustomIcons $path.custom-icons)}
      '';
    };
  };
};

legacy-tray-enabled = { _meta = { type = $type.bool; default = true; description = ''
  Enable legacy tray icon support

  Whether to support older application status icons in the top bar.
''; }; };
icon-saturation = { _meta = { type = $type.float; default = 0.0; description = ''
  Visual saturation of tray icons

  Adjustment level for the color saturation of displayed icons.
''; }; };
icon-brightness = { _meta = { type = $type.float; default = 0.0; description = ''
  Visual brightness of tray icons

  Adjustment level for the brightness of displayed icons.
''; }; };
icon-contrast = { _meta = { type = $type.float; default = 0.0; description = ''
  Visual contrast of tray icons

  Adjustment level for the contrast of displayed icons.
''; }; };
icon-opacity = { _meta = { type = $type.int; default = 240; description = ''
  Alpha transparency of tray icons

  Opacity level from 0 to 255 for icons in the top bar.
''; }; };
icon-size = { _meta = { type = $type.int; default = 0; description = ''
  Fixed size for tray icons

  Icon size in pixels. A value of 0 triggers automatic sizing.
''; }; };
icon-spacing = { _meta = { type = $type.int; default = 12; description = ''
  Horizontal spacing between icons

  Pixel distance between individual status icons within the tray area.
''; }; };
tray-pos = { _meta = { type = $type.string; default = "right"; description = ''
  Vertical alignment in the panel

  Panel box position for the tray icons (e.g., 'left', 'right').
''; }; };
tray-order = { _meta = { type = $type.int; default = 1; description = ''
  Ordering index in the panel

  Relative order for placement among other panel items.
''; }; };
custom-icons = {
  _meta = {
    type = $type.list [ ($type.list [ $type.string ]) ];
    default = [ ];
    description = ''
      Custom icon overrides

      List of [id, icon, path] tuples to manually override application icons.
    '';
    example = [ [ "skype" "skype-icon" "/path/to/icon.png" ] ];
  };
};
