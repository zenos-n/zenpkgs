_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Clipboard history management for the GNOME top bar";
  description = ''
    Clipboard history management for the GNOME top bar

    This module installs and configures the **Clipboard Indicator** extension for GNOME.
    It adds a clipboard history menu to the top bar, allowing users to access and
    paste previously copied items.

    **Features:**
    - Clipboard history with configurable size.
    - Private mode to prevent caching specific items.
    - Customizable keyboard shortcuts.
    - Option to clear history on boot or interval.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

_let modes: $type.set [ $type.int ] = { icon = 0; content = 1; both = 2; neither = 3; };

enable = enableOption {
  _meta.description = ''Whether to enable Clipboard Indicator GNOME extension configuration.'';
  s! {
    environment.systemPackages = [ $pkgs.apps.gnome-extensions.clipboard-indicator ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/clipboard-indicator" = {
          paste-button = $path.paste-button;
          pinned-on-bottom = $path.pinned-on-bottom;
          enable-deletion = $path.enable-deletion;
          display-mode = $lib.getAttr $path.topbar.display-mode $v.modes;
          disable-down-arrow = !$path.topbar.enable-down-arrow;
          preview-size = $path.preview.menu-length;
          topbar-preview-size = $path.preview.topbar-length;
          history-size = $path.history.size;
          clear-on-boot = $path.history.clear-on-boot;
          confirm-clear = $path.history.confirm-clear;
          keep-selected-on-clear = $path.history.keep-selected-on-clear;
          excluded-apps = $path.history.excluded-apps;
          clear-history-on-interval = $path.history.autoclear.enable;
          clear-history-interval = $path.history.autoclear.interval;
          next-history-clear = $path.history.autoclear.next-run;
          paste-on-select = $path.behavior.paste-on-select;
          move-item-first = $path.behavior.move-item-first;
          strip-text = $path.behavior.strip-text;
          case-sensitive-search = $path.search.case-sensitive;
          regex-search = $path.search.regex;
          notify-on-copy = $path.notify.on-copy;
          notify-on-cycle = $path.notify.on-cycle;
          cache-size = $path.cache.size;
          cache-only-favorites = $path.cache.only-favorites;
          cache-images = $path.cache.images;
          enable-keybindings = $path.keybindings.enable;
          clear-history = $path.keybindings.clear-history;
          prev-entry = $path.keybindings.prev-entry;
          next-entry = $path.keybindings.next-entry;
          toggle-menu = $path.keybindings.toggle-menu;
          private-mode-binding = $path.keybindings.private-mode;
      };
    } ];
  };
};

paste-button = { _meta = { type = $type.bool; default = true; description = ''
  Enable immediate paste buttons

  If true, adds a dedicated button to each menu entry that triggers
  an immediate paste action upon selection.
''; }; };
pinned-on-bottom = { _meta = { type = $type.bool; default = false; description = ''
  Position pinned items at the bottom

  If true, reorders the clipboard menu to place the 'pinned' section
  at the bottom of the list.
''; }; };
enable-deletion = { _meta = { type = $type.bool; default = true; description = ''
  Enable history deletion controls

  If true, displays 'delete' buttons on each item and provides a
  'Clear History' option in the menu.
''; }; };
topbar.display-mode = { _meta = { type = $type.enum [ "icon" "content" "both" "neither" ]; default = "icon"; description = ''
  Panel display mode

  Configures what information is displayed directly in the GNOME
  top bar (icon, text content, or both).
''; }; };
topbar.enable-down-arrow = { _meta = { type = $type.bool; default = false; description = ''
  Show panel dropdown arrow

  Whether to display a visual down-arrow indicator next to the
  clipboard icon in the top bar.
''; }; };
preview.menu-length = { _meta = { type = $type.int; default = 30; description = ''
  Menu character preview limit

  The maximum number of characters displayed for clipboard items
  inside the extension menu.
''; }; };
preview.topbar-length = { _meta = { type = $type.int; default = 10; description = ''
  Topbar character preview limit

  The maximum number of characters displayed for the current
  clipboard item in the GNOME top bar.
''; }; };
history.size = { _meta = { type = $type.int; default = 15; description = ''
  History buffer size

  The maximum number of copied items to persist in the
  clipboard history.
''; }; };
history.clear-on-boot = { _meta = { type = $type.bool; default = false; description = ''
  Clear history on system startup

  When enabled, the clipboard history buffer is purged every
  time the system reboots.
''; }; };
history.confirm-clear = { _meta = { type = $type.bool; default = true; description = ''
  Confirm history purge

  Whether to show a confirmation dialog before performing a
  'Clear History' action.
''; }; };
history.keep-selected-on-clear = { _meta = { type = $type.bool; default = false; description = ''
  Preserve active selection during clear

  Whether to retain the currently selected clipboard entry
  when performing a bulk history deletion.
''; }; };
history.excluded-apps = { _meta = { type = $type.list [ $type.string ]; default = [ ]; description = ''
  Applications ignored by the extension

  List of application identifiers whose clipboard activity
  should not be recorded in the history.
''; }; };
history.autoclear.enable = { _meta = { type = $type.bool; default = false; description = ''
  Enable periodic history clearing

  Activates the timer-based automatic purging of the
  clipboard history buffer.
''; }; };
history.autoclear.interval = { _meta = { type = $type.int; default = 60; description = ''
  Autoclear interval duration

  Specifies the time in minutes between scheduled
  history purges.
''; }; };
history.autoclear.next-run = { _meta = { type = $type.int; default = -1; description = ''Internal state tracker for the next scheduled clear''; }; };
behavior.paste-on-select = { _meta = { type = $type.bool; default = false; description = ''
  Automatic paste upon selection

  When enabled, clicking a history item immediately pastes
  it into the active window.
''; }; };
behavior.move-item-first = { _meta = { type = $type.bool; default = false; description = ''
  Reorder history on use

  Whether to move items to the top of the history list
  when they are selected.
''; }; };
behavior.strip-text = { _meta = { type = $type.bool; default = false; description = ''
  Trim whitespace from text

  When enabled, leading and trailing whitespace is automatically
  removed from copied text strings.
''; }; };
search.case-sensitive = { _meta = { type = $type.bool; default = false; description = ''
  Case-sensitive history search

  Whether the search filter should respect character casing.
''; }; };
search.regex = { _meta = { type = $type.bool; default = false; description = ''
  Enable regular expressions in search

  Allows using advanced regex patterns when filtering the
  clipboard history.
''; }; };
notify.on-copy = { _meta = { type = $type.bool; default = false; description = ''
  Show notification on new copy

  Displays a desktop notification every time a new item
  is added to the clipboard.
''; }; };
notify.on-cycle = { _meta = { type = $type.bool; default = true; description = ''
  Show notification during history cycling

  Displays a notification when cycling through clipboard
  entries using keyboard shortcuts.
''; }; };
cache.size = { _meta = { type = $type.int; default = 5; description = ''
  Maximum registry cache size

  The allowed size for the disk-based registry cache file
  in megabytes.
''; }; };
cache.only-favorites = { _meta = { type = $type.bool; default = false; description = ''
  Restrict disk cache to favorites

  Disables the registry cache file for standard items, using
  volatile memory only to avoid writing secrets to disk.
''; }; };
cache.images = { _meta = { type = $type.bool; default = true; description = ''
  Enable image caching to disk

  Whether the extension is permitted to persist copied image
  data in its disk cache.
''; }; };
keybindings.enable = { _meta = { type = $type.bool; default = true; description = ''Enable extension keyboard shortcuts''; }; };
keybindings.clear-history = { _meta = { type = $type.list [ $type.string ]; default = [ "<Control>F10" ]; description = ''Shortcut to purge clipboard history''; }; };
keybindings.prev-entry = { _meta = { type = $type.list [ $type.string ]; default = [ "<Control>F11" ]; description = ''Shortcut to cycle to the previous history entry''; }; };
keybindings.next-entry = { _meta = { type = $type.list [ $type.string ]; default = [ "<Control>F12" ]; description = ''Shortcut to cycle to the next history entry''; }; };
keybindings.toggle-menu = { _meta = { type = $type.list [ $type.string ]; default = [ "<Control>F9" ]; description = ''Shortcut to display the clipboard menu''; }; };
keybindings.private-mode = { _meta = { type = $type.list [ $type.string ]; default = [ "<Control>F8" ]; description = ''Shortcut to toggle Private Mode''; }; };
