_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Retro window opening and closing animations for GNOME";
  description = ''
    Retro window opening and closing animations for GNOME

    This module installs and configures the **Burn My Windows** extension for GNOME.
    It adds retro-style window opening and closing effects, such as fire,
    tv-glitch, and hexagon.

    **Features:**
    - Configure active effects and profiles.
    - Generate custom Nix-managed effect profiles.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

_let serializeFloat: $type.function "float" = v:
  let s = $lib.toString v; in if $lib.hasInfix "." s then s else "${s}.0";
_let serializeIniValue: $type.function "value" = v:
  if $lib.isBool v then (if v then "true" else "false")
  else if $lib.isFloat v then $v.serializeFloat v
  else $lib.toString v;
_let generateProfileContent: $type.function "settings" = settings: ''
  [burn-my-windows-profile]
  ${$lib.concatStringsSep "\n" ($lib.mapAttrsToList (k: v: "${k}=${$v.serializeIniValue v}") settings)}
'';
_let managedProfile: $type.package = $pkgs.legacy.writeText "burn-my-windows.conf" ($v.generateProfileContent $path.settings);

enable = enableOption {
  _meta.description = ''Whether to enable Burn My Windows GNOME extension configuration.'';
  s! {
    environment.systemPackages = [ $pkgs.apps.gnome-extensions.burn-my-windows ];
  };
  u! {
    dconf.settings."org/gnome/shell".enabled-extensions = [ $pkgs.apps.gnome-extensions.burn-my-windows.extensionUuid ];
  };
};

configure = enableOption {
  _meta.default = $path.enable;
  _meta.description = ''Write settings and the managed profile without activating the extension.'';
  u! {
    dconf.settings."org/gnome/shell/extensions/burn-my-windows" = {
          active-profile = if $path.active-profile != "" || $path.settings == { }
            then $path.active-profile else "${$v.managedProfile}";
          preview-effect = $path.preview-effect;
          test-mode = $path.test-mode;
          show-support-dialog = $path.show-support-dialog;
          last-prefs-version = $lib.gvariant.mkInt32 $path.last-prefs-version;
          last-extension-version = $lib.gvariant.mkInt32 $path.last-extension-version;
          prefs-open-count = $lib.gvariant.mkInt32 $path.prefs-open-count;
        };
    xdg.configFile."burn-my-windows/profiles/nix-managed.conf" = $lib.mkIf ($path.settings != { }) {
      text = $v.generateProfileContent $path.settings;
    };
  };
};

active-profile = { _meta = { type = $type.string; default = ""; description = ''
  Currently selected animation profile

  Absolute path to the active effect profile. When settings are supplied, point
   this at burn-my-windows/profiles/nix-managed.conf under the user's XDG config directory.
   With settings but no explicit path, the generated store profile is used.
''; }; };
preview-effect = { _meta = { type = $type.string; default = ""; description = ''
  Nickname of the effect for preview

  The effect with this nick will be used for the next window animation.
''; }; };
test-mode = { _meta = { type = $type.bool; default = false; description = ''
  Enable single-frame animation testing

  If set to true, all animations will show only one still frame.
''; }; };
show-support-dialog = { _meta = { type = $type.bool; default = true; description = ''
  Display the ask-for-support dialog

  Whether to allow the extension to show its periodic donation dialog.
''; }; };
last-prefs-version = { _meta = { type = $type.int; default = 0; description = ''
  Internal version of last used preferences

  Tracks updates between the preferences dialog and the extension core.
''; }; };
last-extension-version = { _meta = { type = $type.int; default = 0; description = ''
  Internal version of the extension core

  Tracks the version of the extension code for compatibility checks.
''; }; };
prefs-open-count = { _meta = { type = $type.int; default = 0; description = ''
  Preferences dialog interaction counter

  Tracks how many times the settings interface has been opened.
''; }; };
settings = {
  _meta = {
    type = $type.set [ ($type.either [ $type.bool $type.int $type.float $type.string ]) ];
    default = { };
    description = ''
      Declarative effect parameters for the managed profile

      Generates a custom INI profile at `~/.config/burn-my-windows/profiles/nix-managed.conf`.
    '';
    example = { fire-enable-effect = true; doom-enable-effect = true; glide-animation-time = 150; };
  };
};
