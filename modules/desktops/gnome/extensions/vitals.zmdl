_meta = {
  zenosVersion = 1.0.0Na;
  brief = "Real-time system resource monitoring for the top bar";
  description = ''
    Real-time system resource monitoring for the top bar

    This module installs and configures the **Vitals** extension for GNOME.
    Vitals provides a glimpse into your computer's temperature, voltage, fan speed,
    memory usage, processor load, network speed and storage stats.

    **Features:**
    - Highly customizable sensor list in the top bar.
    - Detailed system monitoring dropdown menu.
    - Support for CPU, GPU, Memory, Storage, and Network monitoring.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = "Vitals GNOME extension configuration";
  s! {
    environment.systemPackages = [ $pkgs.zenos.legacy.gnomeExtensions.vitals ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/vitals" = {
        hot-list = $path.sensors.hot-list;
        update-time = $path.sensors.update-time;
        hide-zeros = $path.sensors.hide-zeros;
        hide-labels = $path.sensors.hide-labels;
        include-static-info = $path.sensors.include-static-info;
        position-in-panel = $path.display.position-in-panel;
        icon-style = $path.display.icon-style;
        fixed-widths = $path.display.fixed-widths;
        hide-icons = $path.display.hide-icons;
        menu-centered = $path.display.menu-centered;
        alphabetize = $path.display.alphabetize;
        use-higher-precision = $path.display.use-higher-precision;
        unit = $path.display.unit;
        show-temperature = $path.show.temperature;
        show-voltage = $path.show.voltage;
        show-fan = $path.show.fan;
        show-memory = $path.show.memory;
        show-processor = $path.show.processor;
        show-system = $path.show.system;
        show-storage = $path.show.storage;
        show-network = $path.show.network;
        show-battery = $path.show.battery;
        show-gpu = $path.show.gpu;
        network-speed-format = $path.network.speed-format;
        include-public-ip = $path.network.include-public-ip;
        storage-path = $path.storage.path;
        storage-measurement = $path.storage.measurement;
        memory-measurement = $path.memory.measurement;
        battery-slot = $path.battery.slot;
        include-static-gpu-info = $path.gpu.include-static-info;
        monitor-cmd = $path.system.monitor-cmd;
      };
    } ];
  };
};

sensors.hot-list = { _meta = { type = $type.list [ $type.string ]; default = [
  "_memory_usage_"
  "_system_load_1m_"
  "__network-rx_max__"
]; description = ''
  Primary sensors for the panel display

  List of internal sensor identifiers to be rendered directly
  on the GNOME top bar.
''; }; };
sensors.update-time = { _meta = { type = $type.int; default = 5; description = "Interval in seconds between sensor data refreshes"; }; };
sensors.hide-zeros = { _meta = { type = $type.bool; default = false; description = "Hide sensors returning a zero value from the display"; }; };
sensors.hide-labels = { _meta = { type = $type.bool; default = false; description = "Remove text labels from the panel sensors to save space"; }; };
sensors.include-static-info = { _meta = { type = $type.bool; default = true; description = "Display non-volatile hardware metadata in the dropdown"; }; };

display.position-in-panel = { _meta = { type = $type.int; default = 0; description = "Relative sorting index for the Vitals icon in the panel"; }; };
display.icon-style = { _meta = { type = $type.int; default = 0; description = "Visual style for sensor icons (0: Default, 1: Solid)"; }; };
display.fixed-widths = { _meta = { type = $type.bool; default = true; description = "Enforce constant pixel width for panel labels to prevent jitter"; }; };
display.hide-icons = { _meta = { type = $type.bool; default = false; description = "Display only text values without icons in the top bar"; }; };
display.menu-centered = { _meta = { type = $type.bool; default = false; description = "Center the dropdown menu relative to the sensor icon"; }; };
display.alphabetize = { _meta = { type = $type.bool; default = false; description = "Sort sensors alphabetically in the dropdown menu"; }; };
display.use-higher-precision = { _meta = { type = $type.bool; default = false; description = "Show additional decimal places for sensor readings"; }; };
display.unit = { _meta = { type = $type.int; default = 1; description = "Measurement unit system (1: Metric, 2: Imperial)"; }; };

show.temperature = { _meta = { type = $type.bool; default = true; description = "Toggle temperature monitoring visibility"; }; };
show.voltage = { _meta = { type = $type.bool; default = true; description = "Toggle voltage monitoring visibility"; }; };
show.fan = { _meta = { type = $type.bool; default = true; description = "Toggle fan speed monitoring visibility"; }; };
show.memory = { _meta = { type = $type.bool; default = true; description = "Toggle memory usage monitoring visibility"; }; };
show.processor = { _meta = { type = $type.bool; default = true; description = "Toggle CPU load monitoring visibility"; }; };
show.system = { _meta = { type = $type.bool; default = true; description = "Toggle system health monitoring visibility"; }; };
show.storage = { _meta = { type = $type.bool; default = true; description = "Toggle disk space monitoring visibility"; }; };
show.network = { _meta = { type = $type.bool; default = true; description = "Toggle bandwidth monitoring visibility"; }; };
show.battery = { _meta = { type = $type.bool; default = true; description = "Toggle battery health monitoring visibility"; }; };
show.gpu = { _meta = { type = $type.bool; default = true; description = "Toggle GPU resource monitoring visibility"; }; };

network.speed-format = { _meta = { type = $type.int; default = 0; description = "Bandwidth unit (0: bits/s, 1: bytes/s)"; }; };
network.include-public-ip = { _meta = { type = $type.bool; default = false; description = "Fetch and display the external public IP address"; }; };
storage.path = { _meta = { type = $type.string; default = "/"; description = "Filesystem mount point to monitor for space"; }; };
storage.measurement = { _meta = { type = $type.int; default = 0; description = "Capacity unit (0: Percent, 1: GB Used, 2: GB Free)"; }; };
memory.measurement = { _meta = { type = $type.int; default = 0; description = "Usage unit (0: Percent, 1: GB Used, 2: GB Free)"; }; };
battery.slot = { _meta = { type = $type.int; default = 0; description = "Hardware battery index to monitor"; }; };
gpu.include-static-info = { _meta = { type = $type.bool; default = true; description = "Display GPU hardware metadata in the dropdown"; }; };
system.monitor-cmd = { _meta = { type = $type.string; default = "resources"; description = "Command to execute when clicking the 'System Monitor' item"; }; };
