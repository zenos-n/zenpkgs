_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Customizable system resource monitor for the GNOME panel";
  description = ''
    Customizable system resource monitor for the GNOME panel

    This module installs and configures the **Astra Monitor** extension for GNOME.
    It provides a customizable panel for monitoring system resources like CPU,
    GPU, memory, storage, and network usage.

    **Features:**
    - Customizable layout and theme.
    - Support for various sensors and units.
    - Detailed resource usage metrics.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.description = ''Whether to enable Astra Monitor GNOME extension configuration.'';
  s! {
    environment.systemPackages = [ $pkgs.zenos.legacy.gnomeExtensions.astra-monitor ];
    programs.dconf.profiles.user.databases = [ {
      settings."org/gnome/shell/extensions/astra-monitor" = {
        position-in-panel = $path.position-in-panel;
        theme-style = $path.theme-style;
        shell-bar-position = $path.shell-bar-position;
        margin-left = $path.margin-left;
        margin-right = $path.margin-right;
        temperature-unit = $path.temperature-unit;
        use-higher-precision = $path.use-higher-precision;
        sensors-update-time = $path.sensors-update-time;
        memory-used = $path.memory-used;
        storage-used = $path.storage-used;
        network-speed = $path.network-speed;
        experimental-features = $path.experimental-features;
        processor-menu-gpu = $path.processor-menu-gpu;
        processor-menu-gpu-color = $path.processor-menu-gpu-color;
        headers-height = $path.headers-height;
        sensors-header-tooltip-sensor5-short-name = $path.sensors-header-tooltip-sensor5-short-name;
        sensors-header-tooltip-sensor5-digits = $path.sensors-header-tooltip-sensor5-digits;
      };
    } ];
  };
};

position-in-panel = { _meta = { type = $type.string; default = "right"; description = ''
  Panel box position

  Placement of the monitor in the GNOME panel (left, center, right).
''; }; };
theme-style = { _meta = { type = $type.string; default = "dark"; description = ''
  Interface theme style

  The visual theme for the monitor dropdown (dark, light).
''; }; };
shell-bar-position = { _meta = { type = $type.string; default = "top"; description = ''
  Panel orientation

  Shell bar position (top, bottom, left, right).
''; }; };
margin-left = { _meta = { type = $type.int; default = 8; description = ''
  Left horizontal margin

  Pixel spacing on the left side of the panel item.
''; }; };
margin-right = { _meta = { type = $type.int; default = 8; description = ''
  Right horizontal margin

  Pixel spacing on the right side of the panel item.
''; }; };
temperature-unit = { _meta = { type = $type.string; default = "celsius"; description = ''
  Unit for temperature display

  Unit used for thermal sensors (celsius, fahrenheit).
''; }; };
use-higher-precision = { _meta = { type = $type.bool; default = false; description = ''
  Enable high precision sensor readings

  Whether to show more decimal places for sensor values.
''; }; };
sensors-update-time = { _meta = { type = $type.int; default = 1; description = ''
  Refresh interval for sensors

  Time in seconds between resource usage updates.
''; }; };
memory-used = { _meta = { type = $type.string; default = "active"; description = ''
  Memory calculation method

  Logic used to determine 'used' memory (active, etc.).
''; }; };
storage-used = { _meta = { type = $type.string; default = "used-total"; description = ''
  Storage usage calculation

  Logic used to determine disk space consumption.
''; }; };
network-speed = { _meta = { type = $type.string; default = "bits"; description = ''
  Network speed unit

  Unit for bandwidth throughput (bits, bytes).
''; }; };
experimental-features = { _meta = { type = $type.string; default = ""; description = ''
  Experimental extension flags

  Enable internal experimental features by passing flag strings.
''; }; };
processor-menu-gpu = { _meta = { type = $type.string; default = "\"\""; description = ''
  GPU visibility toggle (Legacy)

  Deprecated setting for showing GPU usage in the menu.
''; }; };
processor-menu-gpu-color = { _meta = { type = $type.string; default = "rgba(29,172,214,1.0)"; description = ''
  GPU usage bar color (Legacy)

  Color used for GPU monitoring bars.
''; }; };
headers-height = { _meta = { type = $type.int; default = 30; description = ''
  Menu header height (Legacy)

  Visual height of the dropdown menu headers.
''; }; };
sensors-header-tooltip-sensor5-short-name = { _meta = { type = $type.string; default = ""; description = ''
  Tooltip name for sensor 5

  Custom label for the fifth sensor in tooltips.
''; }; };
sensors-header-tooltip-sensor5-digits = { _meta = { type = $type.int; default = -1; description = ''
  Decimal precision for sensor 5

  Number of digits to show for the fifth sensor tooltip.
''; }; };
