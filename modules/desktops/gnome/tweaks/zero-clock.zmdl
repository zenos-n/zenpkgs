# Transitional parity source: lib/compat/modules/desktops/gnome/tweaks/zero-clock/module.nix
# Schema migration: extension assignments use path-derived zenos.desktops.gnome.
# Unsupported: internal/readOnly option flags have no ZMDL fields.
_meta = {
  zenosVersion = 1.0.0Na;
  summary = "GNOME lock-screen and top-bar clock font tweak";
  description = ''
    Applies Zero Mono Thin to the lock-screen time and Zero to the lock-screen
    date and top-bar clock through GNOME extensions.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.zenos;
};

enable = enableOption {
  _meta.summary = "Enable the Zero GNOME clock font tweak";

  s! {
    fonts.packages = [ $pkgs.theming.fonts.zero.regular $pkgs.theming.fonts.zero.mono-thin ];
    zenos.desktops.gnome.extensions = {
      customize-clock-on-lockscreen = {
        enable = true;
        time = {
          enable = true;
          text = "%H%n%M";
          font = { family = "Zero Mono Thin"; weight = "100"; size = 84; };
        };
        date = {
          enable = true;
          text = "%d.%m.%Y";
          font = { family = "Zero"; weight = "100"; size = 24; };
        };
      };
      user-themes = {
        enable = true;
        theme.cssOverride = ''
          /* The Top Bar Clock */
          .clock-display {
              font-family: 'Zero', sans-serif !important;
              font-weight: normal !important;
              font-style: normal !important;
              font-size: 12px;
          }
        '';
      };
    };
  };
};
