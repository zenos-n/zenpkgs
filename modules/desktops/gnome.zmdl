# Transitional parity source: lib/compat/modules/desktops/gnome/base/module.nix
# Schema migration: the canonical module id uses path-derived desktops.gnome.
_meta = {
  name = "GNOME desktop environment for ZenOS";
  tags = [ "desktop" "gnome" ];
  zenosVersion = 1.0.0Na;
  summary = "GNOME desktop environment for ZenOS";
  description = ''
    Configures GNOME, its core utilities and multimedia support, Tracker indexing,
    extension integration, curated applications, and desktop-wide dconf defaults.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

enable = enableOption {
  _meta.summary = "Enable the GNOME desktop base module";

  s! {
    assertions = [
      { assertion = $path.loginScreen.attemptsBeforeUserSelection == null || ($path.loginScreen.attemptsBeforeUserSelection >= 1 && $path.loginScreen.attemptsBeforeUserSelection <= 2147483647); message = "desktops.gnome.loginScreen.attemptsBeforeUserSelection must be between 1 and 2147483647."; }
      { assertion = $path.loginScreen.textScale == null || $path.loginScreen.textScale > 0.0; message = "desktops.gnome.loginScreen.textScale must be positive."; }
      { assertion = $path.accessibility.inactivityTimeoutSeconds >= 0 && $path.accessibility.inactivityTimeoutSeconds <= 2147483647; message = "desktops.gnome.accessibility.inactivityTimeoutSeconds must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.keyboardMouseSpeed >= 0 && $path.accessibility.keyboardMouseSpeed <= 2147483647; message = "desktops.gnome.accessibility.keyboardMouseSpeed must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.keyboardMouseAccelerationMilliseconds >= 0 && $path.accessibility.keyboardMouseAccelerationMilliseconds <= 2147483647; message = "desktops.gnome.accessibility.keyboardMouseAccelerationMilliseconds must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.keyboardMouseDelayMilliseconds >= 0 && $path.accessibility.keyboardMouseDelayMilliseconds <= 2147483647; message = "desktops.gnome.accessibility.keyboardMouseDelayMilliseconds must be between 0 and 2147483647."; }
      { assertion = $path.magnification.zoom >= 0.1 && $path.magnification.zoom <= 32.0; message = "desktops.gnome.magnification.zoom must be between 0.1 and 32.0."; }
      { assertion = $path.magnification.crosshairThicknessPixels >= 0 && $path.magnification.crosshairThicknessPixels <= 2147483647; message = "desktops.gnome.magnification.crosshairThicknessPixels must be between 0 and 2147483647."; }
      { assertion = $path.magnification.crosshairOpacity >= 0.0 && $path.magnification.crosshairOpacity <= 1.0; message = "desktops.gnome.magnification.crosshairOpacity must be between 0.0 and 1.0."; }
      { assertion = $path.magnification.crosshairLengthPixels >= 20 && $path.magnification.crosshairLengthPixels <= 4096; message = "desktops.gnome.magnification.crosshairLengthPixels must be between 20 and 4096."; }
      { assertion = $path.magnification.colorSaturation >= 0.0 && $path.magnification.colorSaturation <= 1.0; message = "desktops.gnome.magnification.colorSaturation must be between 0.0 and 1.0."; }
      { assertion = $path.accessibility.hoverClickDelaySeconds >= 0.0; message = "desktops.gnome.accessibility.hoverClickDelaySeconds must be at least 0.0."; }
      { assertion = $path.accessibility.hoverClickMovementPixels >= 0 && $path.accessibility.hoverClickMovementPixels <= 2147483647; message = "desktops.gnome.accessibility.hoverClickMovementPixels must be between 0 and 2147483647."; }
      { assertion = $path.accessibility.rightClickHoldSeconds >= 0.0; message = "desktops.gnome.accessibility.rightClickHoldSeconds must be at least 0.0."; }
      { assertion = $path.appearance.textScale >= 0.5 && $path.appearance.textScale <= 3.0; message = "desktops.gnome.appearance.textScale must be between 0.5 and 3.0."; }
      { assertion = $path.privacy.cleanupAgeDays >= 0 && $path.privacy.cleanupAgeDays <= 4294967295; message = "desktops.gnome.privacy.cleanupAgeDays must be between 0 and 4294967295."; }
      { assertion = $path.power.screenBlankSeconds >= 0 && $path.power.screenBlankSeconds <= 4294967295; message = "desktops.gnome.power.screenBlankSeconds must be between 0 and 4294967295."; }
      { assertion = $path.security.lockDelaySeconds >= 0 && $path.security.lockDelaySeconds <= 4294967295; message = "desktops.gnome.security.lockDelaySeconds must be between 0 and 4294967295."; }
      { assertion = $path.mouse.speed >= -1 && $path.mouse.speed <= 1; message = "desktops.gnome.mouse.speed must be between -1 and 1."; }
      { assertion = $path.touchpad.speed >= -1 && $path.touchpad.speed <= 1; message = "desktops.gnome.touchpad.speed must be between -1 and 1."; }
      { assertion = $path.keyboard.repeatDelayMilliseconds >= 0 && $path.keyboard.repeatDelayMilliseconds <= 4294967295; message = "desktops.gnome.keyboard.repeatDelayMilliseconds must be between 0 and 4294967295."; }
      { assertion = $path.keyboard.repeatIntervalMilliseconds >= 0 && $path.keyboard.repeatIntervalMilliseconds <= 4294967295; message = "desktops.gnome.keyboard.repeatIntervalMilliseconds must be between 0 and 4294967295."; }
      { assertion = $path.windows.raiseDelayMilliseconds >= 0 && $path.windows.raiseDelayMilliseconds <= 10000; message = "desktops.gnome.windows.raiseDelayMilliseconds must be between 0 and 10000."; }
      { assertion = $path.workspaces.count >= 1 && $path.workspaces.count <= 36; message = "desktops.gnome.workspaces.count must be between 1 and 36."; }
      { assertion = $path.nightLight.temperature >= 0 && $path.nightLight.temperature <= 4294967295; message = "desktops.gnome.nightLight.temperature must be between 0 and 4294967295."; }
    ];
    services.displayManager.gdm.enable = true;
    services.displayManager.gdm.autoSuspend = $lib.mkIf ($path.loginScreen.automaticSuspend != null) $path.loginScreen.automaticSuspend;
    programs.dconf.profiles.gdm.databases = $lib.mkBefore ($lib.optional ($path.loginScreen.showUsers != null || $path.loginScreen.showPowerButtons != null || $path.loginScreen.allowPasswords != null || $path.loginScreen.allowFingerprints != null || $path.loginScreen.allowSmartCards != null || $path.loginScreen.allowPasskeys != null || $path.loginScreen.allowWebLogin != null || $path.loginScreen.attemptsBeforeUserSelection != null || $path.loginScreen.logo != null || $path.loginScreen.screenReader != null || $path.loginScreen.screenKeyboard != null || $path.loginScreen.textScale != null || $path.loginScreen.highContrast != null || $path.loginScreen.clockFormat != null || $path.loginScreen.message != null) {
      settings = $lib.foldl $lib.recursiveUpdate { } [
        ($lib.optionalAttrs ($path.loginScreen.showUsers != null) { "org/gnome/login-screen"."disable-user-list" = $path.loginScreen.showUsers == false; })
        ($lib.optionalAttrs ($path.loginScreen.showPowerButtons != null) { "org/gnome/login-screen"."disable-restart-buttons" = $path.loginScreen.showPowerButtons == false; })
        ($lib.optionalAttrs ($path.loginScreen.allowPasswords != null) { "org/gnome/login-screen"."enable-password-authentication" = $path.loginScreen.allowPasswords; })
        ($lib.optionalAttrs ($path.loginScreen.allowFingerprints != null) { "org/gnome/login-screen"."enable-fingerprint-authentication" = $path.loginScreen.allowFingerprints; })
        ($lib.optionalAttrs ($path.loginScreen.allowSmartCards != null) { "org/gnome/login-screen"."enable-smartcard-authentication" = $path.loginScreen.allowSmartCards; })
        ($lib.optionalAttrs ($path.loginScreen.allowPasskeys != null) { "org/gnome/login-screen"."enable-passkey-authentication" = $path.loginScreen.allowPasskeys; })
        ($lib.optionalAttrs ($path.loginScreen.allowWebLogin != null) { "org/gnome/login-screen"."enable-web-authentication" = $path.loginScreen.allowWebLogin; })
        ($lib.optionalAttrs ($path.loginScreen.attemptsBeforeUserSelection != null) { "org/gnome/login-screen"."allowed-failures" = $lib.gvariant.mkInt32 $path.loginScreen.attemptsBeforeUserSelection; })
        ($lib.optionalAttrs ($path.loginScreen.logo != null) { "org/gnome/login-screen"."logo" = $path.loginScreen.logo; })
        ($lib.optionalAttrs ($path.loginScreen.screenReader != null) { "org/gnome/desktop/a11y/applications"."screen-reader-enabled" = $path.loginScreen.screenReader; })
        ($lib.optionalAttrs ($path.loginScreen.screenKeyboard != null) { "org/gnome/desktop/a11y/applications"."screen-keyboard-enabled" = $path.loginScreen.screenKeyboard; })
        ($lib.optionalAttrs ($path.loginScreen.textScale != null) { "org/gnome/desktop/interface"."text-scaling-factor" = $lib.gvariant.mkDouble $path.loginScreen.textScale; })
        ($lib.optionalAttrs ($path.loginScreen.highContrast != null) { "org/gnome/desktop/a11y/interface"."high-contrast" = $path.loginScreen.highContrast; })
        ($lib.optionalAttrs ($path.loginScreen.clockFormat != null) { "org/gnome/desktop/interface"."clock-format" = $path.loginScreen.clockFormat; })
        ($lib.optionalAttrs ($path.loginScreen.message != null) { "org/gnome/login-screen" = { banner-message-enable = $path.loginScreen.message != ""; banner-message-source = "settings"; banner-message-text = $path.loginScreen.message; }; })
      ];
    });

    services.desktopManager.gnome.enable = true;
    services.gnome.gnome-initial-setup.enable = false;
    nixpkgs.overlays = [
      (final: prev: {
        gdm = prev.gdm.overrideAttrs (old: {
          postInstall = (old.postInstall or "") + ''
            sed -i 's|^Exec=gnome-session$|Exec=gnome-session --session=gnome-login|' \
              "$out/share/gdm/greeter/wayland-sessions/gnome-greeter.desktop"
          '';
        });
      })
    ];

    environment.systemPackages =
      ($lib.subtractLists
        ($cfg.legacy.environment.gnome.excludePackages or [ ])
        (with $pkgs.zenos; [
          legacy.wl-clipboard
          legacy.dconf-editor
          legacy.gnome-tweaks
          legacy.gnome-extension-manager
          legacy.gst_all_1.gstreamer
          legacy.gst_all_1.gst-plugins-base
          legacy.gst_all_1.gst-plugins-good
          legacy.gst_all_1.gst-plugins-bad
          legacy.gst_all_1.gst-plugins-ugly
          legacy.gst_all_1.gst-libav
          legacy.gst_all_1.gst-vaapi
        ]))
      ++ $path.extensionPackages
      ++ ($lib.optionals ($cfg.legacy.services.flatpak.enable or false) [ $pkgs.zenos.legacy.warehouse ])
      ++ ($lib.optionals $path.extraPackages.enable (with $pkgs.zenos; [
        legacy.icon-library
        legacy.letterpress
        legacy.biblioteca
        legacy.dialect
        legacy.raider
        legacy.wike
        legacy.curtail
        legacy.czkawka
        legacy.hieroglyphic
        legacy.switcheroo
        legacy.rnote
        legacy.helvum
      ]));

    environment.gnome.excludePackages = [ $pkgs.zenos.legacy.gnome-tour ]
      ++ ($lib.optional $path.excludeGnomeConsole $pkgs.zenos.legacy.gnome-console);

    services.gnome.tracker-miners.enable = $path.fileIndexing.enable;
    services.gnome.tracker.enable = $path.fileIndexing.enable;
    programs.dconf.enable = true;
    programs.dconf.profiles.user.databases = [
      {
        settings = {
          "org/gnome/desktop/interface"."enable-animations" = $path.appearance.animations;
          "org/gnome/desktop/interface"."text-scaling-factor" = $lib.gvariant.mkDouble ($path.appearance.textScale);
          "org/gnome/desktop/interface"."font-name" = $path.appearance.interfaceFont;
          "org/gnome/desktop/interface"."document-font-name" = $path.appearance.documentFont;
          "org/gnome/desktop/interface"."monospace-font-name" = $path.appearance.monospaceFont;
          "org/gnome/desktop/interface"."cursor-size" = $lib.gvariant.mkInt32 ($path.appearance.cursorSize);
          "org/gnome/desktop/interface"."cursor-theme" = $path.appearance.cursorTheme;
          "org/gnome/desktop/interface"."icon-theme" = $path.appearance.iconTheme;
          "org/gnome/desktop/interface"."show-battery-percentage" = $path.showBatteryPercentage;
          "org/gnome/desktop/interface"."clock-format" = $path.clock.format;
          "org/gnome/desktop/interface"."clock-show-weekday" = $path.clock.showWeekday;
          "org/gnome/desktop/interface"."clock-show-date" = $path.clock.showDate;
          "org/gnome/desktop/interface"."clock-show-seconds" = $path.clock.showSeconds;
          "org/gnome/desktop/interface"."enable-hot-corners" = $path.hotCorners;
          "org/gnome/desktop/interface"."gtk-enable-primary-paste" = $path.middleClickPaste;
          "org/gnome/desktop/calendar"."show-weekdate" = $path.clock.showWeekNumbers;
          "org/gnome/desktop/notifications"."show-banners" = $path.notifications.banners;
          "org/gnome/desktop/notifications"."show-in-lock-screen" = $path.notifications.onLockScreen;
          "org/gnome/desktop/privacy"."remember-recent-files" = $path.privacy.rememberRecentFiles;
          "org/gnome/desktop/privacy"."recent-files-max-age" = $lib.gvariant.mkInt32 ($path.privacy.recentFilesDays);
          "org/gnome/desktop/privacy"."remove-old-trash-files" = $path.privacy.removeOldTrash;
          "org/gnome/desktop/privacy"."remove-old-temp-files" = $path.privacy.removeOldTemporaryFiles;
          "org/gnome/desktop/privacy"."old-files-age" = $lib.gvariant.mkUint32 ($path.privacy.cleanupAgeDays);
          "org/gnome/desktop/privacy"."report-technical-problems" = $path.privacy.reportTechnicalProblems;
          "org/gnome/desktop/session"."idle-delay" = $lib.gvariant.mkUint32 ($path.power.screenBlankSeconds);
          "org/gnome/desktop/screensaver"."lock-enabled" = $path.security.lockScreen;
          "org/gnome/desktop/screensaver"."lock-delay" = $lib.gvariant.mkUint32 ($path.security.lockDelaySeconds);
          "org/gnome/desktop/peripherals/mouse"."speed" = $lib.gvariant.mkDouble ($path.mouse.speed);
          "org/gnome/desktop/peripherals/mouse"."accel-profile" = $path.mouse.acceleration;
          "org/gnome/desktop/peripherals/mouse"."left-handed" = $path.mouse.leftHanded;
          "org/gnome/desktop/peripherals/mouse"."natural-scroll" = $path.mouse.naturalScrolling;
          "org/gnome/desktop/peripherals/touchpad"."tap-to-click" = $path.touchpad.tapToClick;
          "org/gnome/desktop/peripherals/touchpad"."natural-scroll" = $path.touchpad.naturalScrolling;
          "org/gnome/desktop/peripherals/touchpad"."speed" = $lib.gvariant.mkDouble ($path.touchpad.speed);
          "org/gnome/desktop/peripherals/touchpad"."accel-profile" = $path.touchpad.acceleration;
          "org/gnome/desktop/peripherals/touchpad"."disable-while-typing" = $path.touchpad.disableWhileTyping;
          "org/gnome/desktop/peripherals/touchpad"."two-finger-scrolling-enabled" = $path.touchpad.twoFingerScrolling;
          "org/gnome/desktop/peripherals/touchpad"."edge-scrolling-enabled" = $path.touchpad.edgeScrolling;
          "org/gnome/desktop/peripherals/touchpad"."tap-and-drag" = $path.touchpad.tapAndDrag;
          "org/gnome/desktop/peripherals/touchpad"."tap-and-drag-lock" = $path.touchpad.dragLock;
          "org/gnome/desktop/peripherals/touchpad"."click-method" = $path.touchpad.clickMethod;
          "org/gnome/desktop/peripherals/touchpad"."send-events" = $path.touchpad.whenToUse;
          "org/gnome/desktop/peripherals/touchpad"."left-handed" = $path.touchpad.leftHanded;
          "org/gnome/desktop/peripherals/keyboard"."repeat" = $path.keyboard.repeatKeys;
          "org/gnome/desktop/peripherals/keyboard"."delay" = $lib.gvariant.mkUint32 ($path.keyboard.repeatDelayMilliseconds);
          "org/gnome/desktop/peripherals/keyboard"."repeat-interval" = $lib.gvariant.mkUint32 ($path.keyboard.repeatIntervalMilliseconds);
          "org/gnome/desktop/wm/preferences"."focus-mode" = $path.windows.focus;
          "org/gnome/desktop/wm/preferences"."auto-raise" = $path.windows.raiseOnFocus;
          "org/gnome/desktop/wm/preferences"."auto-raise-delay" = $lib.gvariant.mkInt32 ($path.windows.raiseDelayMilliseconds);
          "org/gnome/desktop/wm/preferences"."button-layout" = $path.windows.titlebarButtons;
          "org/gnome/desktop/wm/preferences"."action-double-click-titlebar" = $path.windows.doubleClickTitlebar;
          "org/gnome/desktop/wm/preferences"."num-workspaces" = $lib.gvariant.mkInt32 ($path.workspaces.count);
          "org/gnome/desktop/wm/preferences"."workspace-names" = if $path.workspaces.names == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.workspaces.names;
          "org/gnome/desktop/a11y"."always-show-universal-access-status" = $path.accessibility.showMenu;
          "org/gnome/desktop/a11y"."always-show-text-caret" = $path.accessibility.showTextCursor;
          "org/gnome/desktop/a11y/interface"."show-status-shapes" = $path.accessibility.statusShapes;
          "org/gnome/desktop/a11y/interface"."reduced-motion" = $path.accessibility.motionPreference;
          "org/gnome/desktop/a11y/keyboard"."enable" = $path.accessibility.keyboardShortcuts;
          "org/gnome/desktop/a11y/keyboard"."feature-state-change-beep" = $path.accessibility.announceFeatureChanges;
          "org/gnome/desktop/a11y/keyboard"."timeout-enable" = $path.accessibility.disableAfterInactivity;
          "org/gnome/desktop/a11y/keyboard"."disable-timeout" = $lib.gvariant.mkInt32 ($path.accessibility.inactivityTimeoutSeconds);
          "org/gnome/desktop/a11y/keyboard"."bouncekeys-beep-reject" = $path.accessibility.announceRejectedRepeats;
          "org/gnome/desktop/a11y/keyboard"."mousekeys-max-speed" = $lib.gvariant.mkInt32 ($path.accessibility.keyboardMouseSpeed);
          "org/gnome/desktop/a11y/keyboard"."mousekeys-accel-time" = $lib.gvariant.mkInt32 ($path.accessibility.keyboardMouseAccelerationMilliseconds);
          "org/gnome/desktop/a11y/keyboard"."mousekeys-init-delay" = $lib.gvariant.mkInt32 ($path.accessibility.keyboardMouseDelayMilliseconds);
          "org/gnome/desktop/a11y/keyboard"."slowkeys-beep-press" = $path.accessibility.announceSlowKeyPress;
          "org/gnome/desktop/a11y/keyboard"."slowkeys-beep-accept" = $path.accessibility.announceSlowKeyAcceptance;
          "org/gnome/desktop/a11y/keyboard"."slowkeys-beep-reject" = $path.accessibility.announceSlowKeyRejection;
          "org/gnome/desktop/a11y/keyboard"."stickykeys-two-key-off" = $path.accessibility.releaseStickyKeysWithTwoKeys;
          "org/gnome/desktop/a11y/keyboard"."stickykeys-modifier-beep" = $path.accessibility.announceStickyModifiers;
          "org/gnome/desktop/a11y/keyboard"."togglekeys-enable" = $path.accessibility.announceLockKeys;
          "org/gnome/desktop/a11y/magnifier"."mouse-tracking" = $path.magnification.pointerTracking;
          "org/gnome/desktop/a11y/magnifier"."focus-tracking" = $path.magnification.focusTracking;
          "org/gnome/desktop/a11y/magnifier"."caret-tracking" = $path.magnification.textCursorTracking;
          "org/gnome/desktop/a11y/magnifier"."screen-position" = $path.magnification.screenPosition;
          "org/gnome/desktop/a11y/magnifier"."mag-factor" = $lib.gvariant.mkDouble ($path.magnification.zoom);
          "org/gnome/desktop/a11y/magnifier"."lens-mode" = $path.magnification.followPointerLens;
          "org/gnome/desktop/a11y/magnifier"."scroll-at-edges" = $path.magnification.scrollBeyondEdges;
          "org/gnome/desktop/a11y/magnifier"."show-cross-hairs" = $path.magnification.showCrosshairs;
          "org/gnome/desktop/a11y/magnifier"."cross-hairs-thickness" = $lib.gvariant.mkInt32 ($path.magnification.crosshairThicknessPixels);
          "org/gnome/desktop/a11y/magnifier"."cross-hairs-color" = $path.magnification.crosshairColor;
          "org/gnome/desktop/a11y/magnifier"."cross-hairs-opacity" = $lib.gvariant.mkDouble ($path.magnification.crosshairOpacity);
          "org/gnome/desktop/a11y/magnifier"."cross-hairs-length" = $lib.gvariant.mkInt32 ($path.magnification.crosshairLengthPixels);
          "org/gnome/desktop/a11y/magnifier"."cross-hairs-clip" = $path.magnification.crosshairCenterGap;
          "org/gnome/desktop/a11y/magnifier"."invert-lightness" = $path.magnification.invertBrightness;
          "org/gnome/desktop/a11y/magnifier"."color-saturation" = $lib.gvariant.mkDouble ($path.magnification.colorSaturation);
          "org/gnome/desktop/a11y/mouse"."dwell-click-enabled" = $path.accessibility.hoverClick;
          "org/gnome/desktop/a11y/mouse"."dwell-time" = $lib.gvariant.mkDouble ($path.accessibility.hoverClickDelaySeconds);
          "org/gnome/desktop/a11y/mouse"."dwell-threshold" = $lib.gvariant.mkInt32 ($path.accessibility.hoverClickMovementPixels);
          "org/gnome/desktop/a11y/mouse"."click-type-window-visible" = $path.accessibility.showHoverClickSelector;
          "org/gnome/desktop/a11y/mouse"."secondary-click-enabled" = $path.accessibility.holdForRightClick;
          "org/gnome/desktop/a11y/mouse"."secondary-click-time" = $lib.gvariant.mkDouble ($path.accessibility.rightClickHoldSeconds);
          "org/gnome/desktop/peripherals/keyboard"."remember-numlock-state" = $path.keyboard.rememberNumberLock;
          "org/gnome/desktop/peripherals/keyboard"."numlock-state" = $path.keyboard.numberLock;
          "org/gnome/desktop/wm/preferences"."raise-on-click" = $path.windows.raiseOnClick;
          "org/gnome/desktop/wm/preferences"."audible-bell" = $path.sound.systemBell;
          "org/gnome/desktop/wm/preferences"."visual-bell" = $path.accessibility.flashForBell;
          "org/gnome/desktop/wm/preferences"."visual-bell-type" = $path.accessibility.bellFlashArea;
          "org/gnome/settings-daemon/plugins/media-keys"."calculator" = if $path.shortcuts.openCalculator == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.openCalculator;
          "org/gnome/settings-daemon/plugins/media-keys"."control-center" = if $path.shortcuts.openSettings == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.openSettings;
          "org/gnome/settings-daemon/plugins/media-keys"."email" = if $path.shortcuts.openEmail == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.openEmail;
          "org/gnome/settings-daemon/plugins/media-keys"."eject" = if $path.shortcuts.ejectMedia == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.ejectMedia;
          "org/gnome/settings-daemon/plugins/media-keys"."help" = if $path.shortcuts.openHelp == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.openHelp;
          "org/gnome/settings-daemon/plugins/media-keys"."home" = if $path.shortcuts.openHomeFolder == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.openHomeFolder;
          "org/gnome/settings-daemon/plugins/media-keys"."media" = if $path.shortcuts.openMediaPlayer == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.openMediaPlayer;
          "org/gnome/settings-daemon/plugins/media-keys"."next" = if $path.shortcuts.nextTrack == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.nextTrack;
          "org/gnome/settings-daemon/plugins/media-keys"."pause" = if $path.shortcuts.pausePlayback == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.pausePlayback;
          "org/gnome/settings-daemon/plugins/media-keys"."play" = if $path.shortcuts.togglePlayback == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.togglePlayback;
          "org/gnome/settings-daemon/plugins/media-keys"."logout" = if $path.shortcuts.logOut == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.logOut;
          "org/gnome/settings-daemon/plugins/media-keys"."reboot" = if $path.shortcuts.restart == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.restart;
          "org/gnome/settings-daemon/plugins/media-keys"."shutdown" = if $path.shortcuts.shutDown == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.shutDown;
          "org/gnome/settings-daemon/plugins/media-keys"."previous" = if $path.shortcuts.previousTrack == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.previousTrack;
          "org/gnome/settings-daemon/plugins/media-keys"."screensaver" = if $path.shortcuts.lockScreen == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.lockScreen;
          "org/gnome/settings-daemon/plugins/media-keys"."search" = if $path.shortcuts.search == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.search;
          "org/gnome/settings-daemon/plugins/media-keys"."stop" = if $path.shortcuts.stopPlayback == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.stopPlayback;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-down" = if $path.shortcuts.lowerVolume == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.lowerVolume;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-mute" = if $path.shortcuts.muteAudio == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.muteAudio;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-up" = if $path.shortcuts.raiseVolume == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.raiseVolume;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-down-quiet" = if $path.shortcuts.lowerVolumeQuietly == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.lowerVolumeQuietly;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-mute-quiet" = if $path.shortcuts.muteAudioQuietly == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.muteAudioQuietly;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-up-quiet" = if $path.shortcuts.raiseVolumeQuietly == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.raiseVolumeQuietly;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-down-precise" = if $path.shortcuts.lowerVolumePrecisely == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.lowerVolumePrecisely;
          "org/gnome/settings-daemon/plugins/media-keys"."volume-up-precise" = if $path.shortcuts.raiseVolumePrecisely == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.raiseVolumePrecisely;
          "org/gnome/settings-daemon/plugins/media-keys"."mic-mute" = if $path.shortcuts.muteMicrophone == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.muteMicrophone;
          "org/gnome/settings-daemon/plugins/media-keys"."www" = if $path.shortcuts.openBrowser == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.openBrowser;
          "org/gnome/settings-daemon/plugins/media-keys"."screenreader" = if $path.shortcuts.toggleScreenReader == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleScreenReader;
          "org/gnome/settings-daemon/plugins/media-keys"."on-screen-keyboard" = if $path.shortcuts.toggleScreenKeyboard == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleScreenKeyboard;
          "org/gnome/settings-daemon/plugins/media-keys"."increase-text-size" = if $path.shortcuts.increaseTextSize == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.increaseTextSize;
          "org/gnome/settings-daemon/plugins/media-keys"."decrease-text-size" = if $path.shortcuts.decreaseTextSize == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.decreaseTextSize;
          "org/gnome/settings-daemon/plugins/media-keys"."toggle-contrast" = if $path.shortcuts.toggleHighContrast == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleHighContrast;
          "org/gnome/settings-daemon/plugins/media-keys"."magnifier" = if $path.shortcuts.toggleMagnifier == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleMagnifier;
          "org/gnome/settings-daemon/plugins/media-keys"."magnifier-zoom-in" = if $path.shortcuts.zoomIn == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.zoomIn;
          "org/gnome/settings-daemon/plugins/media-keys"."magnifier-zoom-out" = if $path.shortcuts.zoomOut == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.zoomOut;
          "org/gnome/settings-daemon/plugins/media-keys"."touchpad-toggle" = if $path.shortcuts.toggleTouchpad == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleTouchpad;
          "org/gnome/settings-daemon/plugins/media-keys"."playback-rewind" = if $path.shortcuts.rewindPlayback == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.rewindPlayback;
          "org/gnome/settings-daemon/plugins/media-keys"."playback-forward" = if $path.shortcuts.fastForwardPlayback == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.fastForwardPlayback;
          "org/gnome/settings-daemon/plugins/media-keys"."playback-repeat" = if $path.shortcuts.toggleRepeatPlayback == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleRepeatPlayback;
          "org/gnome/settings-daemon/plugins/media-keys"."playback-random" = if $path.shortcuts.toggleShufflePlayback == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleShufflePlayback;
          "org/gnome/settings-daemon/plugins/media-keys"."rotate-video-lock" = if $path.shortcuts.toggleScreenRotation == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleScreenRotation;
          "org/gnome/settings-daemon/plugins/media-keys"."keyboard-brightness-up" = if $path.shortcuts.raiseKeyboardBrightness == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.raiseKeyboardBrightness;
          "org/gnome/settings-daemon/plugins/media-keys"."keyboard-brightness-down" = if $path.shortcuts.lowerKeyboardBrightness == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.lowerKeyboardBrightness;
          "org/gnome/settings-daemon/plugins/media-keys"."keyboard-brightness-toggle" = if $path.shortcuts.toggleKeyboardBacklight == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleKeyboardBacklight;
          "org/gnome/settings-daemon/plugins/media-keys"."battery-status" = if $path.shortcuts.showBatteryStatus == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.showBatteryStatus;
          "org/gnome/settings-daemon/plugins/media-keys"."rfkill" = if $path.shortcuts.toggleAirplaneMode == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleAirplaneMode;
          "org/gnome/settings-daemon/plugins/media-keys"."rfkill-bluetooth" = if $path.shortcuts.toggleBluetooth == [ ] then $lib.gvariant.mkEmptyArray $lib.gvariant.type.string else $lib.gvariant.mkArray $path.shortcuts.toggleBluetooth;
          "org/gnome/desktop/a11y/applications"."screen-reader-enabled" = $path.accessibility.screenReader;
          "org/gnome/desktop/a11y/applications"."screen-keyboard-enabled" = $path.accessibility.screenKeyboard;
          "org/gnome/desktop/a11y/applications"."screen-magnifier-enabled" = $path.accessibility.magnifier;
          "org/gnome/desktop/a11y/keyboard"."stickykeys-enable" = $path.accessibility.stickyKeys;
          "org/gnome/desktop/a11y/keyboard"."slowkeys-enable" = $path.accessibility.slowKeys;
          "org/gnome/desktop/a11y/keyboard"."slowkeys-delay" = $lib.gvariant.mkInt32 ($path.accessibility.slowKeyDelayMilliseconds);
          "org/gnome/desktop/a11y/keyboard"."bouncekeys-enable" = $path.accessibility.ignoreRepeatedKeys;
          "org/gnome/desktop/a11y/keyboard"."bouncekeys-delay" = $lib.gvariant.mkInt32 ($path.accessibility.repeatKeyDelayMilliseconds);
          "org/gnome/desktop/a11y/keyboard"."mousekeys-enable" = $path.accessibility.keyboardMouse;
          "org/gnome/desktop/a11y/interface"."high-contrast" = $path.accessibility.highContrast;
          "org/gnome/desktop/sound"."event-sounds" = $path.sound.eventSounds;
          "org/gnome/desktop/sound"."input-feedback-sounds" = $path.sound.inputFeedback;
          "org/gnome/desktop/sound"."theme-name" = $path.sound.theme;
          "org/gnome/desktop/media-handling"."automount" = $path.removableMedia.automount;
          "org/gnome/desktop/media-handling"."automount-open" = $path.removableMedia.openFolder;
          "org/gnome/desktop/media-handling"."autorun-never" = $path.removableMedia.neverAutorun;
          "org/gnome/desktop/background" = {
            picture-options = $path.wallpaper.layout;
            primary-color = $path.wallpaper.primaryColor;
            secondary-color = $path.wallpaper.secondaryColor;
            color-shading-type = $path.wallpaper.shading;
          } // ($lib.optionalAttrs ($path.wallpaper.lightImage != null) {
            picture-uri = $path.wallpaper.lightImage;
          }) // ($lib.optionalAttrs ($path.wallpaper.darkImage != null) {
            picture-uri-dark = $path.wallpaper.darkImage;
          });
          "org/gnome/settings-daemon/plugins/color"."night-light-enabled" = $path.nightLight.enable;
          "org/gnome/settings-daemon/plugins/color"."night-light-temperature" = $lib.gvariant.mkUint32 ($path.nightLight.temperature);
          "org/gnome/settings-daemon/plugins/color"."night-light-schedule-automatic" = $path.nightLight.automaticSchedule;
          "org/gnome/settings-daemon/plugins/color"."night-light-schedule-from" = $lib.gvariant.mkDouble ($path.nightLight.startHour);
          "org/gnome/settings-daemon/plugins/color"."night-light-schedule-to" = $lib.gvariant.mkDouble ($path.nightLight.endHour);
          "org/gnome/settings-daemon/plugins/power"."idle-dim" = $path.power.dimWhenIdle;
          "org/gnome/settings-daemon/plugins/power"."sleep-inactive-battery-type" = $path.power.batteryIdleAction;
          "org/gnome/settings-daemon/plugins/power"."sleep-inactive-battery-timeout" = $lib.gvariant.mkInt32 ($path.power.batteryIdleSeconds);
          "org/gnome/settings-daemon/plugins/power"."sleep-inactive-ac-type" = $path.power.pluggedInIdleAction;
          "org/gnome/settings-daemon/plugins/power"."sleep-inactive-ac-timeout" = $lib.gvariant.mkInt32 ($path.power.pluggedInIdleSeconds);
          "org/gnome/settings-daemon/plugins/power"."ambient-enabled" = $path.power.ambientBrightness;
          "org/gnome/desktop/interface" = {
            accent-color = $path.defaultAccentColor;
            color-scheme = if $path.defaultDarkMode then "prefer-dark" else "prefer-light";
          };
          "org/gnome/shell" = {
            disable-user-extensions = false;
            favorite-apps = $path.dockItems;
          };
          "org/gnome/desktop/wm/preferences" = {
          };
          "org/gnome/mutter" = {
            edge-tiling = $path.windows.edgeTiling;
            center-new-windows = $path.windows.centerNewWindows;
            dynamic-workspaces = $path.workspaces.dynamic;
            experimental-features = [
              "scale-monitor-framebuffer"
              "xwayland-native-scaling"
            ] ++ ($lib.optional $path.variableRefreshRate "variable-refresh-rate");
          };
        };
      }
    ];
    services.udev.packages = [ $pkgs.zenos.legacy.gnome-settings-daemon ];
  };
  u! [ ($path.extensionUuids != [ ]) ] {
    dconf.settings."org/gnome/shell".enabled-extensions = $path.extensionUuids;
  };
};

defaultAccentColor = {
  _meta = {
    name = "Primary accent color for the interface";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "blue" "teal" "purple" "red" "orange" "yellow" "green" "pink" "grey" ];
    default = "purple";
    summary = "Primary accent color for the interface";
    description = ''Sets the system-wide accent color for GNOME and supported GTK4 applications.'';
  };
};

defaultDarkMode = {
  _meta = {
    name = "Enable system-wide dark mode";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Enable system-wide dark mode";
    description = ''Prefer the dark color scheme across the desktop and applications.'';
  };
};

fileIndexing.enable = {
  _meta = {
    name = "Enable Tracker file indexing";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Enable Tracker file indexing";
    description = ''Controls GNOME file search and metadata extraction services.'';
  };
};

dockItems = {
  _meta = {
    name = "Default favorite applications in the dock";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.list [ $type.string ];
    default = [
      "firefox.desktop"
      "org.gnome.Nautilus.desktop"
      "org.gnome.Terminal.desktop"
      "kitty.desktop"
    ];
    summary = "Default favorite applications in the dock";
    description = ''Desktop identifiers pinned to the GNOME Dash by default.'';
  };
};

extensionPackages = {
  _meta = {
    name = "GNOME Shell extension packages";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.list [ $type.package ];
    default = [ ];
    summary = "GNOME Shell extension packages";
    description = ''Extension packages installed with the desktop.'';
  };
};

extensionUuids = {
  _meta = {
    name = "Enabled GNOME Shell extension UUIDs";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.list [ $type.string ];
    default = [ ];
    summary = "Enabled GNOME Shell extension UUIDs";
    description = ''Extension UUIDs enabled by the base profile.'';
  };
};

extraPackages.enable = {
  _meta = {
    name = "Install extra curated GNOME applications";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    description = ''Install extra curated GNOME applications.'';
    type = $type.boolean;
    default = false;
    summary = "Install extra curated GNOME applications";
  };
};

excludeGnomeConsole = {
  _meta = {
    name = "Remove the default GNOME Console";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Remove the default GNOME Console";
    description = ''Adds GNOME Console to the desktop exclusion list.'';
  };
};

variableRefreshRate = {
  _meta = {
    name = "Enable Variable Refresh Rate support";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Enable Variable Refresh Rate support";
    description = ''Activates experimental VRR support in Mutter.'';
  };
};

# User-facing desktop preferences. Values remain editable in GNOME Settings.

appearance.animations = {
  _meta = {
    name = "Animations";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Animations";
    description = ''Whether animations should be displayed. Note: This is a global key, it changes the behaviour of the window manager, the panel etc.'';
  };
};

appearance.textScale = {
  _meta = {
    name = "Text scale";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.float;
    default = 1.0;
    summary = "Text scale";
    description = ''Factor used to enlarge or reduce text display, without changing font size.'';
  };
};

appearance.interfaceFont = {
  _meta = {
    name = "Interface font";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.string;
    default = "Adwaita Sans 11";
    summary = "Interface font";
    description = ''Name of the default font used by gtk+.'';
  };
};

appearance.documentFont = {
  _meta = {
    name = "Document font";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.string;
    default = "Adwaita Sans 12";
    summary = "Document font";
    description = ''Name of the default font used for reading documents.'';
  };
};

appearance.monospaceFont = {
  _meta = {
    name = "Monospace font";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.string;
    default = "Adwaita Mono 11";
    summary = "Monospace font";
    description = ''Name of a monospaced (fixed-width) font for use in locations like terminals.'';
  };
};

appearance.cursorSize = {
  _meta = {
    name = "Cursor size";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 24;
    summary = "Cursor size";
    description = ''Size of the cursor used as cursor theme.'';
  };
};

appearance.cursorTheme = {
  _meta = {
    name = "Cursor theme";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.string;
    default = "Adwaita";
    summary = "Cursor theme";
    description = ''Cursor theme name. Used only by Xservers that support the Xcursor extension.'';
  };
};

appearance.iconTheme = {
  _meta = {
    name = "Icon theme";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.string;
    default = "Adwaita";
    summary = "Icon theme";
    description = ''Icon theme to use for the panel, nautilus etc.'';
  };
};

showBatteryPercentage = {
  _meta = {
    name = "Show battery percentage";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Show battery percentage";
    description = ''If true, display battery percentage in the status menu, in addition to the icon.'';
  };
};

clock.format = {
  _meta = {
    name = "Format";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "24h" "12h" ];
    default = "24h";
    summary = "Format";
    description = ''Whether the clock displays in 24h or 12h format'';
  };
};

clock.showWeekday = {
  _meta = {
    name = "Show weekday";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Show weekday";
    description = ''If true, display weekday in the clock, in addition to time.'';
  };
};

clock.showDate = {
  _meta = {
    name = "Show date";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Show date";
    description = ''If true, display date in the clock, in addition to time.'';
  };
};

clock.showSeconds = {
  _meta = {
    name = "Show seconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Show seconds";
    description = ''If true, display seconds in the clock.'';
  };
};

hotCorners = {
  _meta = {
    name = "Hot corners";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Hot corners";
    description = ''If true, the activities overview can be accessed by moving the mouse to the top-left corner.'';
  };
};

middleClickPaste = {
  _meta = {
    name = "Middle click paste";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Middle click paste";
    description = ''If true, gtk+ uses the primary paste selection, usually triggered by a middle mouse button click.'';
  };
};

clock.showWeekNumbers = {
  _meta = {
    name = "Show week numbers";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Show week numbers";
    description = ''If true, display the ISO week date in the calendar.'';
  };
};

notifications.banners = {
  _meta = {
    name = "Banners";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Banners";
    description = ''Whether notification banners are visible for application notifications.'';
  };
};

notifications.onLockScreen = {
  _meta = {
    name = "On lock screen";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "On lock screen";
    description = ''Whether notifications are shown in the lock screen or not.'';
  };
};

privacy.rememberRecentFiles = {
  _meta = {
    name = "Remember recent files";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Remember recent files";
    description = ''If FALSE, applications will not remember recently used files.'';
  };
};

privacy.recentFilesDays = {
  _meta = {
    name = "Recent files days";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = -1;
    summary = "Recent files days";
    description = ''Recently used files will be remembered for this many days. If set to 0, recent files will not be remembered; if set to -1, they will be retained indefinitely.'';
  };
};

privacy.removeOldTrash = {
  _meta = {
    name = "Remove old trash";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Remove old trash";
    description = ''If TRUE, automatically remove files from the trash when they are older than “old-files-age” days.'';
  };
};

privacy.removeOldTemporaryFiles = {
  _meta = {
    name = "Remove old temporary files";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Remove old temporary files";
    description = ''If TRUE, automatically remove temporary files when they are older than “old-files-age” days.'';
  };
};

privacy.cleanupAgeDays = {
  _meta = {
    name = "Cleanup age days";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 30;
    summary = "Cleanup age days";
    description = ''Consider trash and temporary files old after this many days.'';
  };
};

privacy.reportTechnicalProblems = {
  _meta = {
    name = "Report technical problems";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Report technical problems";
    description = ''If TRUE, anonymized reports will be sent automatically to the vendor.'';
  };
};

power.screenBlankSeconds = {
  _meta = {
    name = "Screen blank seconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 300;
    summary = "Screen blank seconds";
    description = ''The number of seconds of inactivity before the session is considered idle.'';
  };
};

security.lockScreen = {
  _meta = {
    name = "Lock screen";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Lock screen";
    description = ''Set this to TRUE to lock the screen when the screensaver goes active.'';
  };
};

security.lockDelaySeconds = {
  _meta = {
    name = "Lock delay seconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 0;
    summary = "Lock delay seconds";
    description = ''The number of seconds after screensaver activation before locking the screen.'';
  };
};

mouse.speed = {
  _meta = {
    name = "Speed";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.float;
    default = 0.0;
    summary = "Speed";
    description = ''Pointer speed for mice. Accepted values are in the [-1..1] range (from “unaccelerated” to “fast”). A value of 0 is the system default.'';
  };
};

mouse.acceleration = {
  _meta = {
    name = "Acceleration";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "default" "flat" "adaptive" ];
    default = "flat";
    summary = "Acceleration";
    description = ''Acceleration profile used for connected mice. The acceleration profile can be set to either default (“default”) which uses the default acceleration profile for each device, flat (“flat”), which accelerates by a device specific constant factor derived from the configured pointer speed, or adaptive (“adaptive”) which adapts the acceleration depending on the mouse movement. If a mouse doesn’t support the configured profile, “default” will be used.'';
  };
};

mouse.leftHanded = {
  _meta = {
    name = "Left handed";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Left handed";
    description = ''Swap left and right mouse buttons for left-handed mice.'';
  };
};

mouse.naturalScrolling = {
  _meta = {
    name = "Natural scrolling";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Natural scrolling";
    description = ''Set this to TRUE to enable natural (reverse) scrolling for mice.'';
  };
};

touchpad.tapToClick = {
  _meta = {
    name = "Tap to click";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Tap to click";
    description = ''Set this to TRUE to be able to send mouse clicks by tapping on the touchpad.'';
  };
};

touchpad.naturalScrolling = {
  _meta = {
    name = "Natural scrolling";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Natural scrolling";
    description = ''Set this to TRUE to enable natural (reverse) scrolling for touchpads.'';
  };
};

touchpad.speed = {
  _meta = {
    name = "Speed";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.float;
    default = 0.0;
    summary = "Speed";
    description = ''Pointer speed for the touchpad. Accepted values are in the [-1..1] range (from “unaccelerated” to “fast”). A value of 0 is the system default.'';
  };
};

touchpad.acceleration = {
  _meta = {
    name = "Acceleration";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "default" "flat" "adaptive" ];
    default = "default";
    summary = "Acceleration";
    description = ''Acceleration profile used for connected touchpads. The acceleration profile can be set to either default (“default”) which uses the default acceleration profile for each device, flat (“flat”), which accelerates by a device specific constant factor derived from the configured pointer speed, or adaptive (“adaptive”) which adapts the acceleration depending on the mouse movement. If a touchpad doesn’t support the configured profile, “default” will be used.'';
  };
};

touchpad.disableWhileTyping = {
  _meta = {
    name = "Disable while typing";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Disable while typing";
    description = ''When enabled, touchpads will be disabled while typing on the keyboard.'';
  };
};

touchpad.twoFingerScrolling = {
  _meta = {
    name = "Two finger scrolling";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Two finger scrolling";
    description = ''When enabled, touchpads that support two-finger scrolling will have that feature enabled.'';
  };
};

touchpad.edgeScrolling = {
  _meta = {
    name = "Edge scrolling";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Edge scrolling";
    description = ''When enabled, touchpads that support edge scrolling will have that feature enabled.'';
  };
};

touchpad.tapAndDrag = {
  _meta = {
    name = "Tap and drag";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Tap and drag";
    description = ''Set this to TRUE to be able to start a drag by tapping and immediately moving the finger that’s now pressed on the touchpad.'';
  };
};

touchpad.dragLock = {
  _meta = {
    name = "Drag lock";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Drag lock";
    description = ''Set this to TRUE to lock the dragging process within a short timeout when the finger is lifted on the touchpad and the tap-and-drag setting is enabled.'';
  };
};

touchpad.clickMethod = {
  _meta = {
    name = "Click method";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "default" "none" "areas" "fingers" ];
    default = "fingers";
    summary = "Click method";
    description = ''How to generate software-emulated buttons, either disabled (“none”), through specific areas (“areas”), number of fingers (“fingers”) or left as hardware default (“default”).'';
  };
};

touchpad.whenToUse = {
  _meta = {
    name = "When to use";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "enabled" "disabled" "disabled-on-external-mouse" ];
    default = "enabled";
    summary = "When to use";
    description = ''Defines the situations in which the touchpad is enabled.'';
  };
};

touchpad.leftHanded = {
  _meta = {
    name = "Left handed";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "right" "left" "mouse" ];
    default = "mouse";
    summary = "Left handed";
    description = ''Swap left and right mouse buttons for left-handed mice with “left”, “right” for right-handed, “mouse” to follow the mouse setting.'';
  };
};

keyboard.repeatKeys = {
  _meta = {
    name = "Repeat keys";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Repeat keys";
    description = ''Set this to TRUE to enable keyboard repeat.'';
  };
};

keyboard.repeatDelayMilliseconds = {
  _meta = {
    name = "Repeat delay milliseconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 500;
    summary = "Repeat delay milliseconds";
    description = ''Initial key repeat delay in milliseconds.'';
  };
};

keyboard.repeatIntervalMilliseconds = {
  _meta = {
    name = "Repeat interval milliseconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 30;
    summary = "Repeat interval milliseconds";
    description = ''Delay between repeats in milliseconds.'';
  };
};

windows.focus = {
  _meta = {
    name = "Focus";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "click" "sloppy" "mouse" ];
    default = "click";
    summary = "Focus";
    description = ''The window focus mode indicates how windows are activated. It has three possible values; “click” means windows must be clicked in order to focus them, “sloppy” means windows are focused when the mouse enters the window, and “mouse” means windows are focused when the mouse enters the window and unfocused when the mouse leaves the window.'';
  };
};

windows.raiseOnFocus = {
  _meta = {
    name = "Raise on focus";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = false;
    summary = "Raise on focus";
    description = ''If set to true, and the focus mode is either “sloppy” or “mouse” then the focused window will be automatically raised after a delay specified by the auto-raise-delay key. This is not related to clicking on a window to raise it, nor to entering a window during drag-and-drop.'';
  };
};

windows.raiseDelayMilliseconds = {
  _meta = {
    name = "Raise delay milliseconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 500;
    summary = "Raise delay milliseconds";
    description = ''The time delay before raising a window if auto-raise is set to true. The delay is given in thousandths of a second.'';
  };
};

windows.titlebarButtons = {
  _meta = {
    name = "Titlebar buttons";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.string;
    default = ":close";
    summary = "Titlebar buttons";
    description = ''Arrangement of buttons on the titlebar. The value should be a string, such as “menu:minimize,maximize,spacer,close”; the colon separates the left corner of the window from the right corner, and the button names are comma-separated. Duplicate buttons are not allowed. Unknown button names are silently ignored so that buttons can be added in future metacity versions without breaking older versions. A special spacer tag can be used to insert some space between two adjacent buttons.'';
  };
};

windows.doubleClickTitlebar = {
  _meta = {
    name = "Double click titlebar";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "toggle-shade" "toggle-maximize" "toggle-maximize-horizontally" "toggle-maximize-vertically" "minimize" "none" "lower" "menu" ];
    default = "toggle-maximize";
    summary = "Double click titlebar";
    description = ''This option determines the effects of double-clicking on the title bar. Current valid options are “toggle-maximize” which will maximize/unmaximize the window, “toggle-maximize-horizontally” and “toggle-maximize-vertically” which will maximize/unmaximize the window in that direction only, “minimize” which will minimize the window, “menu” which will display the window menu, “lower” which will put the window behind all the others, and “none” which will not do anything.'';
  };
};

workspaces.count = {
  _meta = {
    name = "Count";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 4;
    summary = "Count";
    description = ''Number of workspaces. Must be more than zero, and has a fixed maximum to prevent making the desktop unusable by accidentally asking for too many workspaces.'';
  };
};

workspaces.names = {
  _meta = {
    name = "Names";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.list [ $type.string ];
    default = [  ];
    summary = "Names";
    description = ''Defines the names that should be assigned to workspaces. If the list is too long for the current number of workspaces, names in excess will be ignored. If the list is too short, or includes empty names, missing values will be replaced with the default (“Workspace N”).'';
  };
};

