    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.boolean;
    default = true;
    summary = "Dim when idle";
    description = ''If the screen should be dimmed to save power when the computer is idle.'';
  };
};

power.batteryIdleAction = {
  _meta = {
    name = "Battery idle action";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "blank" "suspend" "shutdown" "hibernate" "interactive" "nothing" "logout" ];
    default = "suspend";
    summary = "Battery idle action";
    description = ''The type of sleeping that should be performed when the computer is inactive.'';
  };
};

power.batteryIdleSeconds = {
  _meta = {
    name = "Battery idle seconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
    default = 900;
    summary = "Battery idle seconds";
    description = ''The amount of time in seconds the computer on battery power needs to be inactive before it goes to sleep. A value of 0 means never.'';
  };
};

power.pluggedInIdleAction = {
  _meta = {
    name = "Plugged in idle action";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.enum [ "blank" "suspend" "shutdown" "hibernate" "interactive" "nothing" "logout" ];
    default = "suspend";
    summary = "Plugged in idle action";
    description = ''The type of sleeping that should be performed when the computer is inactive.'';
  };
};

power.pluggedInIdleSeconds = {
  _meta = {
    name = "Plugged in idle seconds";
    tags = [ "desktop" "gnome" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.int;
