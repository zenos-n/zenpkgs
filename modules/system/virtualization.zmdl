libvirt.socketNetworkTransport = {
_meta = {
  name = "Make passt available to enabled Libvirt guests";
  summary = "Make passt available to enabled Libvirt guests";
  description = ''Make passt available to enabled Libvirt guests. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  type = $type.either [ ($type.boolean) $type.null ];
  default = null;
};
  s!! {
    systemd.services.libvirtd.path = $lib.mkIf ($path.libvirt.socketNetworkTransport != null) ($lib.mkIf ($path.libvirt.enable == true && $path.libvirt.socketNetworkTransport) [ $pkgs.apps.virtualization.passt ]);
  };
};

