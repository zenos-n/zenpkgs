_meta = {
  name = "Virtual machines and containers";
  summary = "Virtual machines and containers";
  description = ''Virtual machines and containers. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  zenosVersion = 1.0.0Na;
};

libvirt.enable = {
_meta = {
  name = "Run virtual machines using Libvirt";
  summary = "Run virtual machines using Libvirt";
  description = ''Run virtual machines using Libvirt. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  type = $type.either [ ($type.boolean) $type.null ];
  default = null;
};
  s!! {
    virtualisation.libvirtd.enable = $lib.mkIf ($path.libvirt.enable != null) ($path.libvirt.enable);
  };
};

