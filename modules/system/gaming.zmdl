_meta = {
  name = "Gaming and VR runtime support";
  summary = "Gaming and VR runtime support";
  description = ''Gaming and VR runtime support. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  zenosVersion = 1.0.0Na;
};

steam.enable = {
_meta = {
  name = "Install and configure Steam";
  summary = "Install and configure Steam";
  description = ''Install and configure Steam. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  type = $type.either [ ($type.boolean) $type.null ];
  default = null;
};
  s!! {
    programs.steam.enable = $lib.mkIf ($path.steam.enable != null) ($path.steam.enable);
  };
};

