# Transitional parity source: lib/compat/system-modules/oobe.nix
# Unsupported: the setupPackage.meta ? mainProgram assertion uses attribute-existence syntax
# that production ZMDL does not support; the runtime launch command still uses getExe.
# Unsupported: fallback license construction uses the canonical registry.
_meta = {
  zenosVersion = 1.0.0Na;
  summary = "Temporary ZenOS out-of-box experience";
  description = ''
    Creates a disposable GNOME setup account and session, starts the Setup app,
    locks down the shell, and prepares runtime directories.
  '';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  platforms = $lib.platforms.linux;
};

_let extensionUuid: $type.string = "zenos-oobe-mode@neg-zero.com";
_let servicePath: $type.string = "/run/wrappers/bin:/run/current-system/sw/bin";
_let oobeHome: $type.string = "/run/zenos-oobe";
_let blackWallpaper: $type.package = $pkgs.zenos.legacy.writeText "zenos-oobe-black.svg" ''
  <svg xmlns="http://www.w3.org/2000/svg" width="1" height="1">
    <rect width="1" height="1" fill="#000000"/>
  </svg>
'';

enable = enableOption {
  _meta.default = $cfg.system.oobeMode;
  _meta.summary = "Enable the temporary ZenOS out-of-box experience";

  s! {
    services.desktopManager.gnome.enable = true;
    services.displayManager = {
      gdm.enable = $lib.mkForce false;
      sddm.enable = $lib.mkForce false;
      plasma-login-manager.enable = $lib.mkForce false;
      autoLogin.enable = $lib.mkForce false;
      autoLogin.user = $lib.mkForce null;
    };
    services.xserver.displayManager.lightdm.enable = $lib.mkForce false;
    services.openssh = {
      enable = true;
      openFirewall = true;
      settings = {
        KbdInteractiveAuthentication = false;
        PasswordAuthentication = true;
        PermitEmptyPasswords = true;
        PermitRootLogin = "no";
      };
    };
    services.gnome.gnome-initial-setup.enable = false;
    services.greetd = {
      enable = true;
      restart = false;
      settings = {
        initial_session = {
          user = $path.userName;
        };
        default_session = {
          user = $path.userName;
        };
      };
    };
    systemd.services.greetd.environment = {
      XDG_SESSION_TYPE = "wayland";
      XDG_SESSION_CLASS = "user";
      XDG_SESSION_DESKTOP = "GNOME";
    };
    environment.etc."xdg/gnome-session/sessions/zenos-oobe.session".text = ''
      [GNOME Session]
      Name=ZenOS OOBE
    '';
    systemd.user.targets."gnome-session@zenos-oobe" = {
      overrideStrategy = "asDropin";
      unitConfig.Requires = [
        "gnome-session-services.target"
        "org.gnome.Shell@zenos-oobe.service"
      ];
    };
    systemd.user.services."org.gnome.Shell@zenos-oobe" = {
      overrideStrategy = "asDropin";
      environment = { PATH = $lib.mkForce $v.servicePath; ZENOS_OOBE = "1"; GNOME_SHELL_SESSION_MODE = "zenos-oobe"; };
    };
    systemd.user.services.zenos-oobe = {
      description = "ZenOS out-of-box experience";
      wantedBy = [ "graphical-session.target" ];
      after = [ "gnome-session.target" ];
      partOf = [ "graphical-session.target" ];
      path = [ ];
      environment = {
        PATH = $lib.mkForce $v.servicePath;
        ZENOS_OOBE = "1";
        ZENOS_SETUP_DRY_RUN = "0";
        GI_TYPELIB_PATH = $lib.makeSearchPath "lib/girepository-1.0" [
          $pkgs.zenos.legacy.gnome-desktop
          $pkgs.zenos.legacy.libgweather
          $pkgs.zenos.legacy.networkmanager
        ];
      };
      unitConfig.ConditionUser = $path.userName;
      serviceConfig = {
        Type = "exec";
        ExecStart = "${$lib.getExe $path.setupPackage} --oobe";
        Restart = "on-failure";
        RestartSec = 2;
      };
    };
    users.mutableUsers = false;
    users.users.root.hashedPassword = "!";
    users.users.($path.userName) = {
      isNormalUser = true;
      description = "ZenOS Setup";
      home = $v.oobeHome;
      createHome = true;
      homeMode = "0700";
      hashedPassword = "";
      openssh.authorizedKeys.keys = $path.authorizedKeys;
      extraGroups = [ "input" "networkmanager" "video" "wheel" ];
    };
    environment = {
       systemPackages = with $pkgs.zenos.legacy; [
          acl attr bashInteractive bzip2 coreutils-full cpio curl diffutils findutils
          gawk getent getconf gnugrep gnupatch gnused gnutar gzip xz less libcap ncurses
          netcat mkpasswd procps su time util-linux which zstd perl rsync strace
          atkinson-hyperlegible-next google-cursor nerd-fonts.atkynson-mono
        ] ++ [ $path.extensionPackage $path.setupPackage ] ++ $path.extraExtensionPackages;
       pathsToLink = [
         "/bin"
         "/sbin"
         "/lib"
         "/libexec"
         "/share"
         "/share/gnome-shell/extensions"
         "/share/gnome-shell/modes"
       ];
       gnome.excludePackages = [ $pkgs.zenos.legacy.gnome-tour ];
    };
    fonts = {
      packages = with $pkgs.zenos.legacy; [
        atkinson-hyperlegible-next
        nerd-fonts.atkynson-mono
      ];
      fontconfig.defaultFonts = {
        sansSerif = [ "Atkinson Hyperlegible Next" ];
        monospace = [ "AtkynsonMono NF" ];
      };
    };
    hardware.graphics.enable = true;
    security.sudo.wheelNeedsPassword = false;
    system.extraDependencies = [ $path.setupPackage.src $path.extensionPackage.src ];
    programs.dconf.enable = true;
    home-manager.users.($path.userName) = {
      home = {
        stateVersion = "26.05";
        username = $path.userName;
        homeDirectory = $v.oobeHome;
      };
      xdg = {
        enable = true;
        configHome = "${$v.oobeHome}/.private/Config";
        dataHome = "${$v.oobeHome}/.private/Packages";
        cacheHome = "${$v.oobeHome}/.private/Live";
        stateHome = "${$v.oobeHome}/.private/State";
      };
      xdg.dataFile."themes/ClockOverride/gnome-shell/gnome-shell.css".text = ''
        @import url("resource:///org/gnome/shell/theme/default.css");
        .clock-display {
          font-family: "Zero", sans-serif !important;
          font-size: 12px;
          font-style: normal !important;
          font-weight: normal !important;
          letter-spacing: 0 !important;
        }
      '';
    };
    programs.dconf.profiles.user.databases = [
      {
        settings = {
          "org/gnome/shell" = {
            disable-user-extensions = false;
            enabled-extensions = $path.extraExtensionUuids ++ [ $v.extensionUuid ];
            favorite-apps = $lib.gvariant.mkEmptyArray $lib.gvariant.type.string;
          };
          "org/gnome/desktop/interface" = {
            color-scheme = "prefer-dark";
            enable-animations = true;
            cursor-theme = "GoogleDot-Black";
            cursor-size = $lib.gvariant.mkInt32 24;
            font-name = "Atkinson Hyperlegible Next 11";
            document-font-name = "Atkinson Hyperlegible Next 11";
            monospace-font-name = "AtkynsonMono NF 11";
          };
          "org/gnome/desktop/background" = {
            color-shading-type = "solid";
            picture-options = "none";
            picture-uri = "file://${$v.blackWallpaper}";
            picture-uri-dark = "file://${$v.blackWallpaper}";
            primary-color = "#000000";
            secondary-color = "#000000";
          };
          "org/gnome/desktop/lockdown" = {
            disable-lock-screen = true;
            disable-log-out = true;
            disable-user-switching = true;
          };
          "org/gnome/desktop/session".idle-delay = $lib.gvariant.mkUint32 0;
          "org/gnome/desktop/screensaver".lock-enabled = false;
          "org/gnome/shell/extensions/user-theme".name = "ClockOverride";
          "org/gnome/shell/extensions/date-menu-formatter" = {
            formatter = "01_luxon";
            pattern = "dd.MM  HH:mm";
            font-size = $lib.gvariant.mkInt32 12;
            update-level = $lib.gvariant.mkInt32 1;
            text-align = "center";
          };
          "org/gnome/settings-daemon/plugins/power" = {
            sleep-inactive-ac-type = "nothing";
            sleep-inactive-battery-type = "nothing";
          };
        };
        locks = [
          "/org/gnome/shell/disable-user-extensions"
          "/org/gnome/shell/enabled-extensions"
        ];
      }
    ];
    systemd.tmpfiles.rules = [
      "d ${$v.oobeHome}/.private 0700 ${$path.userName} users -"
      "d ${$v.oobeHome}/.private/Packages 0700 ${$path.userName} users -"
      "d ${$v.oobeHome}/.private/Packages/gnome-shell 0700 ${$path.userName} users -"
      "f ${$v.oobeHome}/.private/Packages/gnome-shell/lock-warning-shown 0600 ${$path.userName} users -"
      "z /etc/ZenOS 0755 ${$path.userName} users -"
      "Z /etc/ZenOS - ${$path.userName} users -"
    ];
  };
};

setupPackage = {
  _meta = {
    type = $type.package;
    default = $pkgs.zenos.system.zenos-setup;
    summary = "Setup application package launched by OOBE";
    example = "pkgs.zenos.setup";
  };
};

extensionPackage = {
  _meta = {
    type = $type.package;
    default = $pkgs.zenos.system.zenos-oobe-mode;
    summary = "GNOME Shell extension and mode package for OOBE";
    example = "pkgs.zenos.oobe-extension";
  };
};

extraExtensionPackages = {
  _meta = {
    type = $type.list [ $type.package ];
    default = [
      $pkgs.zenos.apps.gnome-extensions.date-menu-formatter
      $pkgs.zenos.apps.gnome-extensions.user-themes
    ];
    summary = "Additional OOBE GNOME extension packages";
  };
};

extraExtensionUuids = {
  _meta = {
    type = $type.list [ $type.string ];
    default = [ "date-menu-formatter@marcinjakubowski.github.com" "user-theme@gnome-shell-extensions.gcampax.github.com" ];
    summary = "Additional OOBE GNOME extension UUIDs";
  };
};

authorizedKeys = {
  _meta = {
    type = $type.list [ $type.string ];
    default = [ ];
    summary = "SSH keys accepted by the OOBE account";
  };
};

userName = {
  _meta = {
    type = $type.string;
    default = "zenos";
    summary = "Temporary OOBE account name";
  };
};
