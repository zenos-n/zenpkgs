_meta = {
  name = "Configure packaging for desktop use";
  tags = [ "desktop" "packaging" ];
  zenosVersion = 1.0.0Na;
  summary = "Configure packaging for desktop use";
  description = ''Configure packaging for desktop use. Settings describe user-visible behavior.'';
  maintainers = [ $m.doromiert ];
  license = $l.napl;
};

flatpak = {
  _meta = {
    name = "Install and run sandboxed Flatpak applications";
    tags = [ "desktop" "packaging" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
    summary = "Install and run sandboxed Flatpak applications";
    description = ''Install and run sandboxed Flatpak applications. Null keeps the existing system policy.'';
  };
  s!! {
    services.flatpak.enable = $lib.mkIf ($path.flatpak != null) $path.flatpak;
  };
};

appImage = {
  _meta = {
    name = "Support running AppImage applications";
    tags = [ "desktop" "packaging" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
    summary = "Support running AppImage applications";
    description = ''Support running AppImage applications. Null keeps the existing system policy.'';
  };
  s!! {
    programs.appimage.enable = $lib.mkIf ($path.appImage != null) $path.appImage;
  };
};

runAppImagesDirectly = {
  _meta = {
    name = "Open executable AppImage files directly";
    tags = [ "desktop" "packaging" ];
    maintainers = [ $m.doromiert ];
    license = $l.napl;
    type = $type.either [ ($type.boolean) $type.null ];
    default = null;
    summary = "Open executable AppImage files directly";
    description = ''Open executable AppImage files directly. Null keeps the existing system policy.'';
  };
  s!! {
    programs.appimage.binfmt = $lib.mkIf ($path.runAppImagesDirectly != null) $path.runAppImagesDirectly;
  };
};


environmentExecutables = {
_meta = {
  name = "Resolve environment executables using envfs";
  summary = "Resolve environment executables using envfs";
  description = ''Resolve environment executables using envfs. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  type = $type.either [ ($type.boolean) $type.null ];
  default = null;
};
  s!! {
    services.envfs.enable = $lib.mkIf ($path.environmentExecutables != null) ($path.environmentExecutables);
  };
};

compatibilityLibraries = {
_meta = {
  name = "Run dynamically linked Linux executables using nix-ld";
  summary = "Run dynamically linked Linux executables using nix-ld";
  description = ''Run dynamically linked Linux executables using nix-ld. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  type = $type.either [ ($type.boolean) $type.null ];
  default = null;
};
  s!! {
    programs.nix-ld.enable = $lib.mkIf ($path.compatibilityLibraries != null) ($path.compatibilityLibraries);
  };
};

dynamicLibraries = {
_meta = {
  name = "Libraries available to dynamically linked Linux executables";
  summary = "Libraries available to dynamically linked Linux executables";
  description = ''Libraries available to dynamically linked Linux executables. Unset values preserve existing policy.'';
  tags = [ "migration" ];
  maintainers = [ $m.doromiert ];
  license = $l.napl;
  type = $type.either [ ($type.list [ $type.package ]) $type.null ];
  default = null;
};
  s!! {
    programs.nix-ld.libraries = $lib.mkIf ($path.dynamicLibraries != null) ($path.dynamicLibraries);
  };
};

