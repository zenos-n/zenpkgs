_meta = {
  brief = "declarative disk partitioning and mounting";
  description = ''
    handles disk setups, automated partitioning via sgdisk, and mounting.
    includes logic to conditionally wipe disks if a specific marker file is missing,
    which is perfect for ephemeral roots or recovering a bricked system on reboot.
  '';
  license = $l.napalm;
  maintainers = [ $m.doromiert ];
};

enable = {
  _meta = {
    type = $type.boolean;
    brief = "enable zenos disk management";
    default = false;
  };
};

devices = {
  _meta = {
    brief = "disk configurations mapped by arbitrary name or direct hardware path. freeform keys FTW.";
    default = {};
  };

  (freeform device) = {
    mode = {
      _meta = { type = $type.string; default = "unmanaged"; };
    };
    device = {
      _meta = { type = $type.string; default = ""; brief = "override the hardware path if you want to use a friendly name for the key"; };
    };
    fs = {
      _meta = { type = $type.string; default = "none"; };
    };
    mount = {
      _meta = { type = $type.string; default = "none"; };
    };

    partitions = {
      _meta = { default = {}; };
      (freeform part) = {
        mount = { _meta = { type = $type.string; default = "none"; }; };
        size = { _meta = { type = $type.string; default = "0"; }; };
        fs = { _meta = { type = $type.string; default = "ext4"; }; };
        label = { _meta = { type = $type.string; default = "unlabeled"; }; };
        isSwap = { _meta = { type = $type.boolean; default = false; }; };
        idFile = { _meta = { type = $type.string; default = ""; }; };
      };
    };

    !! {
      # everything in here executes per-device and merges natively
      fileSystems = let 
        devCfg = $path.system.disks.devices."${$f.device}";
        target = if devCfg.device != "" then devCfg.device else $f.device;
      in if devCfg.mode == "unmanaged" && devCfg.mount != "none" then {
        ${devCfg.mount} = {
          device = target;
          fsType = devCfg.fs;
        };
      } else if devCfg.mode == "managed" then
        $lib.listToAttrs (
          map (p: $lib.nameValuePair p.mount {
            device = "/dev/disk/by-partlabel/${p.label}";
            fsType = p.fs;
          }) ($lib.filter (p: !p.isSwap && p.mount != "none") ($lib.attrValues devCfg.partitions))
        )
      else {};

      swapDevices = let
        devCfg = $path.system.disks.devices."${$f.device}";
      in if devCfg.mode == "managed" then
        map (p: { device = "/dev/disk/by-partlabel/${p.label}"; })
          ($lib.filter (p: p.isSwap) ($lib.attrValues devCfg.partitions))
      else [];

      boot.initrd.postDeviceCommands = let
        devCfg = $path.system.disks.devices."${$f.device}";
        target = if devCfg.device != "" then devCfg.device else $f.device;
      in if devCfg.mode == "managed" then ''
        TARGET_DEV="${target}"
        WIPE_NEEDED=0
        # clean up the mount path so it doesn't break if target has slashes
        MNT="/tmp/zenfs_check_${$lib.replaceStrings ["/"] ["_"] target}"
        mkdir -p $MNT

        ${$lib.concatStringsSep "\n" ($lib.mapAttrsToList (partName: partCfg:
          $lib.optionalString (partCfg.idFile != "") ''
            echo "checking for ${partCfg.idFile} on ${partCfg.label}..."
            if blkid -L "${partCfg.label}" >/dev/null; then
              mount /dev/disk/by-partlabel/${partCfg.label} $MNT
              if [ ! -f "$MNT${partCfg.idFile}" ]; then
                echo "id file missing. wipe triggered."
                WIPE_NEEDED=1
              fi
              umount $MNT
            else
              echo "partition missing. wipe triggered."
              WIPE_NEEDED=1
            fi
          ''
        ) devCfg.partitions)}

        if [ $WIPE_NEEDED -eq 1 ]; then
          echo "blitzing $TARGET_DEV..."
          sgdisk -Z $TARGET_DEV
          
          # build partitions sequentially
          ${let
              parts = $lib.mapAttrsToList (n: v: v) devCfg.partitions;
              indexedParts = $lib.imap1 (i: v: { inherit i; cfg = v; }) parts;
            in $lib.concatMapStringsSep "\n" (p: ''
              sgdisk -n ${toString p.i}:0:${p.cfg.size} -c ${toString p.i}:"${p.cfg.label}" -t ${toString p.i}:${if p.cfg.isSwap then "8200" else "8300"} $TARGET_DEV
            '') indexedParts}
            
          partprobe $TARGET_DEV
          udevadm settle
          
          # format partitions
          ${let
              parts = $lib.mapAttrsToList (n: v: v) devCfg.partitions;
            in $lib.concatMapStringsSep "\n" (p:
              if p.isSwap then "mkswap -L ${p.label} /dev/disk/by-partlabel/${p.label}"
              else if p.fs == "vfat" || p.fs == "fat32" then "mkfs.vfat -F 32 -n ${p.label} /dev/disk/by-partlabel/${p.label}"
              else "mkfs.${p.fs} -L ${p.label} /dev/disk/by-partlabel/${p.label}"
            ) parts}
        fi
      '' else "";
    };
  };

  ! {
    # global tools need to be injected once, independent of the per-device logic
    boot.initrd.extraUtilsCommands = ''
      copy_bin_and_libs ${$pkgs.legacy.gptfdisk}/bin/sgdisk
      copy_bin_and_libs ${$pkgs.legacy.util-linux}/bin/blkid
      copy_bin_and_libs ${$pkgs.legacy.dosfstools}/bin/mkfs.vfat
      copy_bin_and_libs ${$pkgs.legacy.e2fsprogs}/bin/mkfs.ext4
    '';

    environment.systemPackages = with $pkgs.legacy; [
      gptfdisk
      dosfstools
      e2fsprogs
    ];
  };
};